@model GL.ViewModels.DVO.DVOBillingViewModel

@{

    ViewBag.Title = "DV Receipt List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<!-- Main content -->
<section class="content">
    <div class="row">

        <div class="col-md-12">
            <div class="box box-info">
                <div class="form-horizontal">
                    <div class="box-body">
                        <div class="box-header with-border">
                            <h2 class="box-title">SGO Billing List</h2>
                        </div>
                        <br />
                        <div class="row" style=" margin-bottom:10px;">
                            <label class="control-label col-sm-1">Project</label>
                            <div class="col-sm-2">
                                @Html.DropDownList("ProjectID", new SelectList(ViewBag.Projects, "ProjectID", "ProjectName"), "-- Select --",
                                new { @class = "form-control showError", @id = "ProjectID" })
                                <span id="spnProjectIDError" class="error" style="display:none;">Please select a project</span>
                            </div>

                            <label class="control-label col-sm-1 PaddingTop-5">Unit</label>
                            <div class="col-sm-2">
                                @Html.DropDownList("UnitID", new SelectList(ViewBag.Units, "UnitID", "UnitNo"), "-- Select --", new { @class = "form-control showError", @id = "UnitID" })
                                <span id="spnUnitIDError" class="error" style="display:none;">Please select a unit</span>
                            </div>

                        </div>

                        <div class="row" style="margin-top:5px;">
                            <label for="StartDate" class="control-label col-sm-1 PaddingTop-5">Start Date</label>
                            <div class="col-sm-2">
                                <div class="input-group ">
                                    <div class="input-group-addon">
                                        <i class="fa fa-calendar"></i>
                                    </div>
                                    <input class="form-control date-picker" autocomplete="off" id="StartDate" value="@DateTime.Now.ToString("dd-MMM-yyyy")"/>
                                </div>
                                <span id="spnStartDateError" class="error" style="display:none;">Please select start date</span>
                            </div>

                            <label for="EndDate" class="control-label col-sm-1 PaddingTop-5">End Date</label>
                            <div class="col-sm-2">
                                <div class="input-group ">
                                    <div class="input-group-addon">
                                        <i class="fa fa-calendar"></i>
                                    </div>
                                    <input class="form-control date-picker" autocomplete="off" id="EndDate" value="@DateTime.Now.ToString("dd-MMM-yyyy")"/>
                                </div>
                                <span id="spnEndDateError" class="error" style="display:none;">Please select end date</span>
                            </div>

                        </div>

                        <!-- /.box-body -->
                        <div class="box-footer">
                            <a href="/DVODevOperations/DVOBilling" class="btn btn-primary">Add</a>
                            <button class="btn btn-info pull-right" onclick="search()">Search</button>
                        </div>
                        <!-- /.box-footer -->
                        @*</form>*@

                    </div>
                </div>

            </div>
        </div>
    </div>


    <div class="row">
        <div id="ListRows">
        </div>

    </div>
</section>
@*<link rel="stylesheet" href="//cdn.datatables.net/1.10.20/css/jquery.dataTables.min.css">*@

@section scripts{

    <script class="SecUserList">

        $("#UnitID").select2();
        $(document).ready(function () {

            $('#StartDate, #EndDate').datepicker({
                autoclose: true,
                orientation: "bottom auto",  // Forces the datepicker to open downward
                format: 'dd-M-yyyy',
            });

            $(document).on("change", "#ProjectID", function (e) {

                e.preventDefault;
                var projectID = $('#ProjectID').val();
                if (projectID == '' || projectID == undefined) {
                    $("#UnitID").empty();
                    return;
                }
                

                $.post("/DVDevelopment/DVOccupiedUnitsListByProjectID", { ProjectID: projectID, IsOccupied: true }).done(function (result) {

                    $("#UnitID").empty();
                    var options = '';
                    options = options + '<option value="">' + "--Select--" + '</option> ';
                    for (var i = 0; i < result.length; i++) {
                        options = options + '<option value="' + result[i].UnitID + '">' + result[i].UnitNo + '</option> ';
                    }

                    $("#UnitID").append(options);

                }).fail(function (ex) {
                    alert(ex.responseText);
                    // ShowAlert('Error', $(jQuery.parseHTML(ex.responseText)).eq(1).text(), true);
                }).always(function () { });
            });

        });

        function getSearchObject() {

            var obj = {
                ProjectID: $("#ProjectID").val(),
                UnitID: $("#UnitID").val(),
                StartDate: $("#StartDate").val(),
                EndDate: $("#EndDate").val()
            };
            return obj;
        }

        function search() {

            $(".error").hide();

            if (IsValid() == false) {
                return;
            }

            var projectID = $("#ProjectID").val();
            var unitID = $("#UnitID").val();
            var startDate = $("#StartDate").val();
            var endDate = $("#EndDate").val();

            $.post("/DVODevOperations/DVOBillingSearchList", { StartDate: startDate, EndDate: endDate, ProjectID: projectID, UnitID: unitID }).done(function (res) {

                $("#ListRows").empty();
                $("#ListRows").html(res);

            }).fail(function (ex) {
                alert(ex.responseText);
            }).always(function () { });

        }

        function addReceipt() {

            $(".error").hide();

            if (IsValid() == false) {
                return;
            }



            var applicationFormID = 0;
            var projectID = $('#ProjectID').val();
            var unitID = $('#UnitID').val();

            if (ProjectID != "" && UnitID != "") {
                $.post("/DVDevelopment/GetApplicationFormID", { ProjectID: projectID, UnitID: unitID }).done(function (res) {
                    applicationFormID = res;

                    if (applicationFormID > 0) {

                        window.location = "/DVDevelopment/DVReceiptSGO?ApplicationFormID=" + applicationFormID;
                    }

                }).fail(function (ex) {
                    alert(ex.responseText);
                }).always(function () { });
            }

            var obj = getSearchObject();

        }


        function IsValid() {

            var valid = true;
            $(".error").hide();


            if ($("#StartDate").val() == "") {
                $("#spnStartDateError").show();
                valid = false;
            }

            if ($("#EndDate").val() == "") {
                $("#spnEndDateError").show();
                valid = false;
            }


            return valid;
        }

    </script>
}



