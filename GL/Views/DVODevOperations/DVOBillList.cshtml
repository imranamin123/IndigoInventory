@model GL.ViewModels.DVO.DVOBillViewModel

@{

    ViewBag.Title = "Bills List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<!-- Main content -->
<section class="content">
    <div class="row">

        <div class="col-md-12">
            <div class="box box-info">
                <div class="form-horizontal">
                    <div class="box-body">
                        <div class="box-header with-border">
                            <h2 class="box-title">Bills List</h2>
                        </div>
                        <br />

                        <div class="row" style="margin-bottom:10px;">
                            <label class="control-label col-sm-1">Project</label>
                            <div class="col-sm-2">
                                @Html.DropDownList("ProjectID", new SelectList(ViewBag.Projects, "ProjectID", "ProjectName"), "-- Select --",
                                new { @class = "form-control showError", @id = "ProjectID" })
                                <span id="spnProjectIDError" class="error" style="display:none;">Please select a project</span>
                            </div>

                        </div>

                        <div class="row" style="margin-bottom:10px;display:none;">

                            <label for="ValueDate" class="control-label col-sm-1 PaddingTop-5">From</label>
                            <div class="col-sm-3">
                                <div class="input-group date">
                                    <div class="input-group-addon">
                                        <i class="fa fa-calendar"></i>
                                    </div>
                                    <input class="form-control date-picker" autocomplete="off" id="DateFrom" value="" />
                                </div>
                                <span id="spnBSClassificationDateError" class="error" style="display:none;">Please select date</span>
                            </div>

                            <label for="ValueDate" class="control-label col-sm-1 PaddingTop-5">To</label>
                            <div class="col-sm-3">
                                <div class="input-group date">
                                    <div class="input-group-addon">
                                        <i class="fa fa-calendar"></i>
                                    </div>
                                    <input class="form-control date-picker" autocomplete="off" id="DateTo" value="" />
                                </div>
                                <span id="spnBSClassificationDateError" class="error" style="display:none;">Please select date</span>
                            </div>

                        </div>

                        <div class="box-footer">
                            <a href="/GLVoucher/GLVoucher" class="btn btn-primary">Add</a>
                            <button class="btn btn-info pull-right" onclick="search()">Search</button>
                        </div>

                        @*<button class="btn btn-primary" onclick="search()">Search</button>*@
                        <!-- /.box-footer -->
                        @*</form>*@

                    </div>
                </div>

            </div>
        </div>
    </div>


    <div class="row">
        <div id="ListRows">
        </div>

    </div>
</section>
@*<link rel="stylesheet" href="//cdn.datatables.net/1.10.20/css/jquery.dataTables.min.css">*@

@section scripts{

    <script class="SecUserList">

        function getSearchObject() {

            var obj = {
                GLVoucherID: $("#GLVoucherID").val(),
               // CompanyID: $("#CompanyID").val(),
                VoucherTypeID: $("#VoucherTypeID").val(),
            //    Name: $("#Name").val(),
            //    StatusTypeID: $("#StatusTypeID").val(),
            };
            return obj;
        }

        function search() {

            

            var projectID = $("#ProjectID").val();
            var dateFrom = $("#DateFrom").val();
            var dateTo = $("#DateTo").val();    
            //var obj = getSearchObject();
            $.post("/DVODevOperations/DVOBillSearchList", { ProjectID: projectID }).done(function (res) {

                $("#ListRows").empty();
                $("#ListRows").html(res);

            }).fail(function (ex) {
                alert(ex.responseText);
            }).always(function () { });

        }


    </script>
}



