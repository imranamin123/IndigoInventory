<script>
    $(document)
        .ajaxStart(function () {
            $('#AjaxLoader').show();
        })
        .ajaxStop(function () {
            $('#AjaxLoader').hide();
        });


    setInterval(function () {

        $.get("/Security/RefreshSession").done(function (res) {


        }).fail(function (ex) {

            alert(ex.responseText);

        }).always(function () {

        });
    }, 120000);

</script>

<script id="LayoutScript">
    //$(window).on('load', function () {
    //    $("#spinner").fadeOut(1000);
    //});

    //$(document).ajaxStart(function () {
    //
    //    $("#spinner").show();
    //});

    //$(document).ajaxStop(function () {
    //
    //    $("#spinner").hide('slow');
    //})

    $().ready(function () {
        //$("#spinner").fadeOut(1000);
        $("input").attr("title", $(this).val());
        $('.date').datepicker({
            autoclose: true,
            format: 'dd-M-yyyy'
        });
    });

    $(document).on('click', function (event) {
        //Do stuff

        $(".decimal").on("keypress keyup blur", function (event) {
            $(this).val($(this).val().replace(/[^0-9\.]/g, ''));
            if ((event.which != 46 || $(this).val().indexOf('.') != -1) && (event.which < 48 || event.which > 57)) {
                event.preventDefault();
            }
        });

        //$('#navbutton').click(function (e) {
        ////$(document).on('click', '#navbutton', function (e) {
        ////    e.preventDefault();
        ////    $('#sidebar').toggle();
        ////});

        $(".integer").on("keypress keyup blur", function (event) {
            $(this).val($(this).val().replace(/[^\d].+/, ""));
            if ((event.which < 48 || event.which > 57)) {
                event.preventDefault();
            }
        });


    });



</script>