@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script id="PurchaseRequisition">

        @*var roleId = @RoleID;
        var requestID = '';//
        var submitedByKPO = @SubmitedByKPO;
        var submitedByMD = @SubmitedByMD;
        var isNotSavedMD = false;
        var isNew = @IsNew;*@
        


        $().ready(function () {
            $("#APVendorID").select2();
            @*var roleId = @RoleID;
            var requestID = @RequestID;*@


            $('.dt').datepicker({
                autoclose: true,
                orientation: "bottom auto",  // Forces the datepicker to open downward
                format: 'dd-M-yyyy',
            });
            calculateTotals();

            //if (roleId == 5) {
            //    $('#header').find('input, select, textarea, button').prop('disabled', true);
            //}


            $("#tbodyList tr").each(function () {



                $(this).find(".ddl").select2();
                var itemId = $(this).find(".itemId").val();
                var requestDetailID = $(this).find(".requestDetailID").val();
                var value = requestDetailID + "," + itemId;
                $(this).find(".ddl").val(value).change();

                $(this).find(".select2.select2-container").css("width", "300px");
                calculateTotals();
            });

            $(document).on("change", "#Type", function () {

                calculateVAT();
                calculateTotals();
                hidSubmit();
            });

            $("#chkPendingPO").change(function () {
                if ($(this).is(":checked")) {
                    $("#PurchaseOrderID").prop("disabled", true);    // Disable
                    $('#loadPO').attr('disabled', true);
                    $("#PurchaseOrderID").val("");
                    
                } else {
                    $("#PurchaseOrderID").prop("disabled", false);   // Enable
                    $('#loadPO').attr('disabled', false);
                }
            });            

            var PurchaseOrderID = $("#PurchaseOrderID").val() == "" ? 0 : $("#PurchaseOrderID").val();
            if (PurchaseOrderID > 0) {
                $("#chkPendingPO").prop("checked", false).trigger("change");
