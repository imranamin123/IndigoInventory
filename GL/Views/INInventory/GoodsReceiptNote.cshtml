        function IsValid() {


            var valid = true;
            $(".error").hide();
            debugger;
            var chkPendingPO = $("#chkPendingPO").is(":checked");// ($(this).find("#chkPendingPO").is(":checked") ? true : false);

            if (chkPendingPO == false && ($("#PurchaseOrderID").val() == "" || $("#PurchaseOrderID").val() == "0")) {
                $("#spnPurchaseOrderIDError").show();
                valid = false;

            }

            if ($("#GoodsReceiptNotesDate").val() == "") {
                $("#spnGoodsReceiptNotesDateError").show();
                valid = false;
            }

            if ($("#ProjectID").val() == "") {
                $("#spnProjectIDError").show();
                valid = false;
            }


            if ($("#DCINVNO").val() == "") {
                $("#spnDCINVNOError").show();
                valid = false;
            }

            if ($("#IGPNO").val() == "" || $("#IGPNO").val() == "0") {
                $("#spnIGPNOError").show();
                valid = false;
            }



            $("#tbodyList").find('tr').each(function (index, elem) {

                //var ItemID = $("#VoucherTypeID").children("option").filter(":selected").text()



                if ($(this).find('.ddl').val() != null && $(this).find('.ddl').val() != "" ) {

                    if ($(this).find('#ReceivedQty').val() == "" || $(this).find('#ReceivedQty').val() == "0") {
                        $(this).find('#spnReceivedQtyError').show();
                        valid = false;
                    }

                    debugger;

                    //if (parseFloat($(this).find('#ReceivedQty').val()) > parseFloat($(this).find('#ApprovedQty').val())) {
                    var ReceivedQty = $(this).find('#ReceivedQty').val() == "" ? 0 : $(this).find('#ReceivedQty').val();
                    var RejectedQty = $(this).find('#RejectedQty').val() == "" ? 0 : $(this).find('#RejectedQty').val();
                    var balance = $(this).attr('Balance') == "" ? 0 : $(this).attr('balance');
                    var grnQty = parseFloat(balance) - (parseFloat(RejectedQty) + parseFloat(ReceivedQty));  //parseFloat($(this).attr('balance')) - () + parseFloat($(this).find('#RejectedQty').val()));
                    if (Number.isNaN(grnQty) == false && grnQty < 0) {
                        $(this).find('#spnReceivedRejectedQtyGreaterError').show();
                        valid = false;
                    }

                    if ($(this).find('#ReceivedQty').val() == "" || $(this).find('#ReceivedQty').val() == "0") {
                        $(this).find('#spnReceivedQtyError').show();
                        valid = false;
                    }

                    ////if (parseFloat($(this).find('#RejectedQty').val()) > parseFloat($(this).attr('balance'))) {
                    ////    $(this).find('#spnRejectedQtyGreaterError').show();
                    ////    valid = false;
                    ////}


                    if ($(this).find('#Rate').val() == "" || $(this).find('#Rate').val() == "0") {
                        $(this).find('#spnRateError').show();
                        valid = false;
                    }

                }
            });

            var rowCount = $("#tbodyList").find('tr').length;
            if (rowCount == 1) {
                alert("Please enter data at least one row");
                valid = false;

            }

            return valid;
        }


