        function isDuplicateRequisition(requestDetailID) {
            var isDuplidate = false;
            $("#tbodyList").find('tr').each(function (index, elem) {
                var requestDetailID2 = $(this).find(".requestDetailID").val() == '' ? 0 : $(this).find(".requestDetailID").val();
                if (requestDetailID2 == requestDetailID) {
                  
                    isDuplidate = true;
                }
            });
            return isDuplidate;
        }


        function calculateVAT() {
            $("#tbodyList").find('tr').each(function (index, elem) {


                var type = $('#Type').val();
                if ($(this).find('.ddl').val() != null && $(this).find('.ddl').val() != "" ) {
                    var ReceivedQty = $(this).find("#ReceivedQty").val() == '' ? 0 : $(this).find("#ReceivedQty").val();
                    var RejectedQty = $(this).find("#RejectedQty").val() == '' ? 0 : $(this).find("#RejectedQty").val();
                    var GRNQty = parseFloat(ReceivedQty);// - parseFloat(RejectedQty);
                    var Rate = $(this).find("#Rate").val() == '' ? 0 : $(this).find("#Rate").val();
                    var Amount = parseFloat(GRNQty) * parseFloat(Rate);
                    $(this).find("#Amount").val(Amount);

                    if (type == '') {
                        $(this).find("#VAT").val(0);
                    }
                    else if (type == '5') {
                        var ExclutiveAmount = GRNQty * Rate; // 0.05 / 1.05 * Amount;
                        var vat = 0.05 * ExclutiveAmount;
                        var TotalAmount = ExclutiveAmount + vat;
                        $(this).find("#VAT").val(vat.toFixed(2));
                        $(this).find("#Amount").val(TotalAmount);
                    }
                    else if (type == '16') {
                        var ExclutiveAmount = GRNQty * Rate; // 0.05 / 1.05 * Amount;
                        var vat = 0.16 * ExclutiveAmount;
                        var TotalAmount = ExclutiveAmount + vat;
                        $(this).find("#VAT").val(vat.toFixed(2));
                        $(this).find("#Amount").val(TotalAmount);
                    }
                    else if (type == '18') {
                        var ExclutiveAmount = GRNQty * Rate; // 0.05 / 1.05 * Amount;
                        var vat = 0.18 * ExclutiveAmount;
                        var TotalAmount = ExclutiveAmount + vat;
                        $(this).find("#VAT").val(vat.toFixed(2));
                        $(this).find("#Amount").val(TotalAmount);
                    }

                    //if (type == '') {
                    //    $(this).find("#VAT").val(0);
                    //}
                    //else if (type == '5') {
                    //    var vat = 0.05 / 1.05 * Amount;
                    //    $(this).find("#VAT").val(vat.toFixed(2));
                    //}
                    //else if (type == '16') {
                    //    var vat = 0.16 / 1.16 * Amount;
                    //    $(this).find("#VAT").val(vat.toFixed(2));
                    //}
                    //else if (type == '18') {
                    //    var vat = 0.18 / 1.18 * Amount;
                    //    $(this).find("#VAT").val(vat.toFixed(2));
                    //}
                }
            });
        }


