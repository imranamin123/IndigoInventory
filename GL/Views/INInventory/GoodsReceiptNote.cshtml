                                <div class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </div>
                                <input class="form-control date-picker dt" placeholder="" autocomplete="off" id="GoodsReceiptNotesDate" value="@Model.INGoodsReceiptNote.GoodsReceiptNotesDate.Value.ToString("dd-MMM-yyyy")" />
                            </div>
                            <span id="spnGoodsReceiptNotesDateError" class="error" style="display:none;">Please select date</span>
                        </div>

                        <label for="ProjectID" class="control-label col-sm-1 PaddingTop-5">Project</label>
                        <div class="col-sm-3">
                            @Html.DropDownListFor(x => x.INGoodsReceiptNote.ProjectID, new SelectList(ViewBag.Projects, "ProjectID", "ProjectName"), "-- Select --", new { @class = "form-control showError ddl", @id = "ProjectID" })
                            <span id="spnProjectIDError" class="error" style="display:none;">Please select project</span>
                        </div>




                        @*<label class="control-label col-sm-1">Type</label>
                            <div class="col-sm-3">
                                @Html.DropDownListFor(x => x.GoodsReceiptNote.RequestTypeID, new SelectList(ViewBag.INRequestTypes, "RequestTypeID", "RequestTypeDesc"), "-- Select --", new { @class = "form-control showError ddl", @id = "RequestTypeID" })
                                <span id="spnRequestTypeIDError" class="error" style="display:none;">Please select type</span>
                            </div>*@
                    </div>


                    <div class="row" style="margin-bottom:10px;">
                        <label for="APVendorID" class="control-label col-sm-1 ">Vendor</label>
                        <div class="col-sm-3">
                            @Html.DropDownListFor(x => x.INGoodsReceiptNote.APVendorID, new SelectList(ViewBag.APVendors, "APVendorID", "DisplayText"), "-- Select --", new { @class = "form-control showError", @id = "APVendorID" })
                            <span id="spnAPVendorIDError" class="error" style="display:none;">Please select vendor</span>
                        </div>

                        <label for="DCINVNO" class="control-label col-sm-1 ">DC/INV NO</label>
