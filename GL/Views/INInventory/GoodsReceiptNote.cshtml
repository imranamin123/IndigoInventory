<section class="content-fluid">
    @*<input type="hidden" id="SubmitedByKPO" value="@Model.GoodsReceiptNote.SubmitedByKPO" />
        <input type="hidden" id="SubmitedAtKPO" value="@Model.GoodsReceiptNote.SubmitedAtKPO" />
        <input type="hidden" id="SubmitedByMD" value="@Model.GoodsReceiptNote.SubmitedByMD" />
        <input type="hidden" id="SubmitedAtMD" value="@Model.GoodsReceiptNote.SubmitedAtMD" />*@

    <input type="hidden" id="mCreatedBy" value="@Model.INGoodsReceiptNote.CreatedBy" />
    <input type="hidden" id="mCreatedAt" value="@Model.INGoodsReceiptNote.CreatedAt" />
    <input type="hidden" id="mModifiedBy" value="@Model.INGoodsReceiptNote.ModifiedBy" />
    <input type="hidden" id="mModifiedAt" value="@Model.INGoodsReceiptNote.ModifiedAt" />
    <input type="hidden" id="mCompanyID" value="@Model.INGoodsReceiptNote.CompanyID" />
    <input type="hidden" id="mPurchaseOrderID" value="@Model.INGoodsReceiptNote.PurchaseOrderID" />
    <input type="hidden" id="mAPVendorID" value="@Model.INGoodsReceiptNote.APVendorID" />
    <input type="hidden" id="mProjectID" value="@Model.INGoodsReceiptNote.ProjectID" />



    <div class="col-md-12">
        <div class="box box-info">
            <div class="form-horizontal" id="header">
                <div class="box-body">
                    <div class="box-header with-border">
                        <h2 class="box-title">Goods Receipt Notes</h2>
                    </div>
                    @*<div>
                            <input type="checkbox" id="myCheck"> Enable input
                            <input type="text" id="myInput" disabled>
                        </div>*@

                    @if (Model.INGoodsReceiptNote.IsPosted.GetValueOrDefault(false) == true)
                    {
                        <h4 style="color:red; font:200;" class="box-title"> <b>Posted</b> </h4>
                    }

                    <br />
                    <div class="row" style="margin-bottom:10px;">
                        <label for="UserID" class="col-sm-1 control-label ">ID</label>
                        <div class="col-sm-3">
                            <input class="form-control integer" readonly value="@Model.INGoodsReceiptNote.GoodsReceiptNoteID" id="GoodsReceiptNoteID">

                        </div>


                        @*<input type="checkbox" id="PendingPO" style="font:bold; height:20px; width:20px;" autocomplete="off" title="">*@

                        @*<div class="col-sm-1" style="text-align:right;">
                            <input type="checkbox" id="chkPendingPO" autocomplete="off" title="" style="width:16px;height:16px;">
                            <label for="chkPendingPO" class="control-label">PO ID</label>
                        </div>*@

                        <div class="col-sm-1" style="display:flex; align-items:center; justify-content:flex-end;">
                            <input type="checkbox" id="chkPendingPO" style="width:16px; height:16px;">
                            <label for="chkPendingPO" class="control-label" style="margin-left:5px;">PO ID</label>
                        </div>

                        <div class="col-sm-3">
                            <input class="form-control" value="@Model.INGoodsReceiptNote.PurchaseOrderID" id="PurchaseOrderID">
                            <span id="spnPurchaseOrderIDError" class="error" style="display:none;">Please enter PO</span>
                        </div>
                        <div class="col-sm-3">
                            <a href="#" id="loadPO" class="btn btn-primary" onclick="CheckVendor();" style=" margin-left: -24px;">Load</a>
                        </div>

                    </div>

                    <div class="row" style="margin-bottom:10px;">
                        <label for="GoodsReceiptNotesDate" class="control-label col-sm-1">Date</label>
                        <div class="col-sm-3">
