                        </div>
                    </div>

                    <div class="row" style="margin-bottom:10px;">
                        <label for="IGPNO" class="col-sm-1 control-label ">IGP No</label>
                        <div class="col-sm-3">
                            <input class="form-control" value="@Model.INGoodsReceiptNote.IGPNO" id="IGPNO">
                            <span id="spnIGPNOError" class="error" style="display:none;">Please enter igp no</span>
                        </div>

                        <label for="VehicleNo" class="col-sm-1 control-label ">Vehicle No</label>
                        <div class="col-sm-3">
                            <input class="form-control" value="@Model.INGoodsReceiptNote.VehicleNo" id="VehicleNo">
                            <span id="spnVehicleNoError" class="error" style="display:none;">Please enter vehicle no</span>
                        </div>

                    </div>

                    <div class="row" style="margin-bottom:10px;">
                        <label for="Remarks" class="col-sm-1 control-label ">Remarks</label>
                        <div class="col-sm-7">
                            <input class="form-control" value="@Model.INGoodsReceiptNote.Remarks" id="Remarks">
                            <span id="spnRemarksError" class="error" style="display:none;">Please enter remarks</span>
                        </div>

                        <label for="Type" class="control-label col-sm-1 PaddingTop-5">Tax Type</label>
