                            <input class="form-control" value="@Model.INGoodsReceiptNote.DCINVNO" id="DCINVNO">
                            <span id="spnDCINVNOError" class="error" style="display:none;">Please select invoice/dc no</span>
                        </div>

                        <label for="DCINVDate" class="control-label col-sm-1">DC/INV Date</label>
