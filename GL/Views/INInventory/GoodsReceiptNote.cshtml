                                    <i class="fa fa-calendar"></i>
                                </div>
                                <input class="form-control date-picker dt" placeholder="" autocomplete="off" id="DCINVDate" value="@Model.INGoodsReceiptNote.DCINVDate.Value.ToString("dd-MMM-yyyy")" />
                            </div>
