                                    <td style="width:50px;text-align:center;">
                                        <input type="hidden" id="GoodsReceiptNoteDetailID" value="@item.GoodsReceiptNoteDetailID" />
                                        <input type="hidden" id="GoodsReceiptNoteID" value="@item.GoodsReceiptNoteID" />
                                        <input type="hidden" id="ItemID" value="@item.ItemID" />

                                        <input type="hidden" id="CreatedBy" value="@item.CreatedBy" />
                                        <input type="hidden" id="CreatedAt" value="@item.CreatedAt" />
                                        <input type="hidden" id="ModifiedBy" value="@item.ModifiedBy" />
                                        <input type="hidden" id="ModifiedAt" value="@item.ModifiedAt" />
                                        <input type="hidden" id="CompanyID" value="@item.CompanyID" />

                                        <label>@item.GoodsReceiptNoteDetailID</label>
                                    </td>

                                    <td style="width:300px">
                                        <input type="text" class="itemId" value="@item.ItemID" style="display:none;" />
                                        <input type="text" class="requestDetailID" value="@item.RequestDetailID" style="display:none;" />
                                        @Html.DropDownListFor(x => x.INGoodsReceiptNoteDetailRows[i].ItemID, new SelectList(ViewBag.INItems, "ItemID", "Description"), "-- Select --", new { @class = "form-control showError  ddl item-list", @id = "ItemID" })
                                    </td>

                                    <td>
                                        <input type="text" readonly id="Size" class="form-control" placeholder="" value="@item.Size" />
                                    </td>

                                    <td>
                                        <input type="text" readonly id="Unit" class="form-control" placeholder="" value="@item.Unit" />
                                    </td>

                                    <td>
                                        <input type="text" id="rem" class="form-control remarks" placeholder="" value="@item.Remarks" onchange="hidSubmit();" />
                                    </td>

                                    <td>
                                        <input type="text" readonly style="text-align:right;" id="ApprovedQty" class="form-control decimal post" value="@item.ApprovedQty" />
                                    </td>

                                    <td>
                                        <input type="text" style="text-align:right;" id="RejectedQty" class="form-control decimal " onblur="calculateVAT(); calculateTotals();" onchange="hidSubmit();" value="@item.RejectedQty" />
                                    </td>

                                    <td>
                                        <input type="text" style="text-align:right;" id="ReceivedQty" class="form-control decimal " onblur="calculateVAT(); calculateTotals();" onchange="hidSubmit();" value="@item.ReceivedQty" />
                                        <span id="spnReceivedQtyError" class="error" style="display:none;">Please enter received qty</span>
                                        <span id="spnReceivedRejectedQtyGreaterError" class="error" style="display:none;">Received Qty + Rejected Qty can not be greater than demand balance</span>
                                    </td>

                                    <td>
                                        <input type="text" style="text-align:right;" id="Rate" class="form-control decimal" onblur="calculateVAT(); calculateTotals();" onchange="hidSubmit();" value="@item.Rate" />
                                        <span id="spnRateError" class="error" style="display:none;">Please enter rate</span>
                                    </td>

                                    <td>
                                        <input type="text" readonly style="text-align:right;" id="VAT" class="form-control decimal" onchange="hidSubmit();" value="@item.VAT" />
                                        <span id="spnApprovedQtyError" class="error" style="display:none;">Approved qty is greater than requested qty</span>
                                    </td>

                                    <td>
                                        <input type="text" readonly style="text-align:right;" id="Amount" class="form-control decimal" onchange="hidSubmit();" value="@item.Amount" />
                                        <span id="spnApprovedQtyError" class="error" style="display:none;">Approved qty is greater than requested qty</span>
                                    </td>

                                    @if (Model.INGoodsReceiptNote.IsPosted.GetValueOrDefault(false) != true && Model.INGoodsReceiptNote.GoodsReceiptNoteID > 0)
                                    {
                                        <td>
                                            <button class='btn btn-danger btn-xs delete-row' tabindex="-1"><i class='fa fa-times'></i></button>
                                            @*<button class='btn btn-primary btn-xs add-row' tabindex="-1"><i class='fa fa-times'></i></button>*@
                                        </td>
                                    }
                                </tr>
                                i = i + 1;
                            }
                        }
                        <tr>
                            <td style="width:50px;text-align:center;">
                                <input type="hidden" id="GoodsReceiptNoteDetailID" value="" />
                                <input type="hidden" id="GoodsReceiptNoteID" value="" />
                                <input type="hidden" id="ItemID" value="" />

                                <input type="hidden" id="CreatedBy" value="" />
                                <input type="hidden" id="CreatedAt" value="" />
                                <input type="hidden" id="ModifiedBy" value="" />
                                <input type="hidden" id="ModifiedAt" value="" />
                                <input type="hidden" id="CompanyID" value="" />

                                <label></label>
                            </td>

                            <td style="width:300px">
                                <input type="text" class="itemId" value="" style="display: none;" />
                                <input type="text" class="requestDetailID" value="" style="display: none;" />
                                @Html.DropDownList("ItemID", new SelectList(ViewBag.INItems, "ItemID", "Description"), "-- Select --", new { @class = "form-control showError  ddl item-list", @id = "ItemID" })
                            </td>

                            <td>
                                <input type="text" readonly id="Size" class="form-control" placeholder="" value="" />
                            </td>

                            <td>
                                <input type="text" readonly id="Unit" class="form-control" placeholder="" value="" />
                            </td>

                            <td>
                                <input type="text" id="rem" class="form-control remarks" placeholder="" value="" />
                            </td>
                            <td>
                                <input type="text" readonly style="text-align:right;" id="ApprovedQty" class="form-control decimal" onchange="hidSubmit();" value="" />
                            </td>
                            <td>
                                <input type="text" style="text-align:right;" id="RejectedQty" class="form-control decimal " onblur="calculateVAT(); calculateTotals();" onchange="hidSubmit();" value="" />
                            </td>

                            <td>
                                <input type="text" style="text-align:right;" id="ReceivedQty" class="form-control decimal " onblur="calculateVAT(); calculateTotals();" onchange="hidSubmit();" value="" />
                                <span id="spnReceivedQtyError" class="error" style="display:none;">Please enter received qty</span>
                                <span id="spnReceivedRejectedQtyGreaterError" class="error" style="display:none;">Received Qty + Rejected Qty can not be greater than demand balance </span>
                            </td>

                            <td>
                                <input type="text" style="text-align:right;" id="Rate" class="form-control decimal post" onblur="calculateVAT(); calculateTotals();" onchange="hidSubmit();" value="" />
                                <span id="spnRateError" class="error" style="display:none;">Please enter rate</span>
                            </td>

                            <td>
                                <input type="text" readonly style="text-align:right;" id="VAT" class="form-control decimal" onchange="hidSubmit();" value="" />
                            </td>

                            <td>
                                <input type="text" readonly style="text-align:right;" id="Amount" class="form-control decimal" onchange="hidSubmit();" value="" />
                            </td>
                            @if (Model.INGoodsReceiptNote.IsPosted.GetValueOrDefault(false) != true && Model.INGoodsReceiptNote.GoodsReceiptNoteID > 0)
                            {
                                <td>
                                    <button class='btn btn-danger btn-xs delete-row' tabindex="-1"><i class='fa fa-times'></i></button>
                                </td>
                            }
                        </tr>

                    </tbody>
                    <tfoot>

                        <tr>
                            <td colspan="9" style="text-align:right;"><label style="font-size:20px;">Total Amount</label></td>
                            <td colspan="2"><input type="text" id="TotalAmount" style="font-size:large; font-weight:bold; background-color:white;" class="form-control number decimal" readonly value="0" /></td>
                            <td></td>
                        </tr>
                    </tfoot>

                </table>

            </div>

            <div class="box-footer">
                <div class="Actions">
                    @*<button class="btn btn-primary" onclick="fullReceived();"><span style="font-weight:bold;">++</span></button>*@
                    <a href="/INInventory/GoodsReceiptNoteList" class="btn btn-info ">Back to List</a>
                    <a href="/INInventory/GoodsReceiptNote" class="btn btn-primary">Add</a>
                    <a href="#" class="btn btn-default" onclick="location.reload();">Cancel</a>
                    @if (Model.INGoodsReceiptNote.IsPosted.GetValueOrDefault(false) == false)
                    {
                        <a href="#" class="btn btn-primary btnSave">Save</a>
                    }
                    @if (Model.INGoodsReceiptNote.IsPosted.GetValueOrDefault(false) == false && Model.INGoodsReceiptNote.GoodsReceiptNoteID > 0)
                    {
                        <a onclick="post()" id="btnPost" class=" btn btn-danger pull-right"> Post</a>
                    }
                </div>
            </div>



        </div>
