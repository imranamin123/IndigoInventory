@model GL.ViewModels.Inventory.INPurchaseOrderViewModel

@{

    ViewBag.Title = "PR List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<!-- Main content -->
<section class="content">
    <div class="row">

        <div class="col-md-12">
            <div class="box box-info">
                <div class="form-horizontal">
                    <div class="box-body">
                        <div class="box-header with-border">
                            <h2 class="box-title">Purchase Order List</h2>
                        </div>
                        <br />

                        <div class="row" style="margin-bottom:10px;">

                            <label for="FromDate" class="control-label col-sm-2">From Date</label>
                            <div class="col-sm-3">
                                <div class="input-group ">
                                    <div class="input-group-addon">
                                        <i class="fa fa-calendar"></i>
                                    </div>
                                    <input class="form-control date-picker dt" placeholder="" autocomplete="off" id="FromDate" value="" />
                                </div>
                                <span id="spnFromDateError" class="error" style="display:none;">Please select from date</span>
                            </div>

                            <label for="ToDate" class="control-label col-sm-2">To Date</label>
                            <div class="col-sm-3">
                                <div class="input-group ">
                                    <div class="input-group-addon">
                                        <i class="fa fa-calendar"></i>
                                    </div>
                                    <input class="form-control date-picker dt" placeholder="" autocomplete="off" id="ToDate" value="" />
                                </div>
                                <span id="spnToDateError" class="error" style="display:none;">Please select to date</span>
                            </div>

                        </div>

                        <div class="row" style="margin-bottom:10px;">
                            <label for="ItemID" class="control-label col-sm-2">Item</label>
                            <div class="col-sm-8">
                                @Html.DropDownList("ItemID", new SelectList(ViewBag.INItems, "ItemID", "Description"), "-- Select --", new { @class = "form-control showError  ddl item-list", @id = "ItemID" })
                            </div>
                        </div>

                        <!-- /.box-body -->
                        <div class="box-footer">
                            @if (ViewBag.username == "ind.umer")
                            {
                                <a href="/INInventory/PurchaseOrder" class="btn btn-primary">Add</a>
                            }
                            <button class="btn btn-info pull-right" onclick="search()">Search</button>

                        </div>
                        <!-- /.box-footer -->
                        @*</form>*@

                    </div>
                </div>

            </div>
        </div>
    </div>


    <div class="row">
        <div id="ListRows">
        </div>

    </div>
</section>
@*<link rel="stylesheet" href="//cdn.datatables.net/1.10.20/css/jquery.dataTables.min.css">*@

@section scripts{

    <script class="INItemList">

        $().ready(function () {

            //$(".ddl").select2();

            $('.dt').datepicker({
                autoclose: true,
                orientation: "bottom auto",  // Forces the datepicker to open downward
                format: 'dd-M-yyyy',
            });
        });

        function getSearchObject() {

            var obj = {
                ItemCode: $("#ItemCode").val(),
                Name: $("#Name").val(),
                GroupID: $("#GroupID").val() == "" ? null : $("#GroupID").val()
            };
            return obj;
        }

        function search() {
            debugger;

            var FromDate = $("#FromDate").val();
            var ToDate = $("#ToDate").val();

            $.post("/INInventory/PurchaseOrderSearchList", { FromDate: FromDate, ToDate: ToDate }).done(function (res) {

                $("#ListRows").empty();
                $("#ListRows").html(res);

            }).fail(function (ex) {
                alert(ex.responseText);
            }).always(function () { });

        }


    </script>
}



