@model GL.ViewModels.Inventory.INStoreTransferNoteViewModel
@using GL.Common

@{

    ViewBag.Title = "Purchase Requisition";
    Layout = "~/Views/Shared/_Layout.cshtml";
    // saved rows render only their own item; see GL.Common.LazyItemSelect
    var itemIndex = LazyItemSelect.Index((System.Collections.IEnumerable)ViewBag.INItems);
    var a = Model;

    //var RoleID = Model.RoleID;
    ////   var RequestID = Model.INStoreTransferNote.RequestID;
    //var SubmitedByKPO = Model.SubmitedByKPO;
    //var SubmitedByMD = Model.SubmitedByMD;
    //var IsNew = Model.IsNew;

}



<style>
    .error {
        color: red;
    }

    .errorDetail {
        border-color: red;
        color: black;
    }
</style>

<section class="content-fluid">
    @*<input type="hidden" id="SubmitedByKPO" value="@Model.INStoreTransferNote.SubmitedByKPO" />
        <input type="hidden" id="SubmitedAtKPO" value="@Model.INStoreTransferNote.SubmitedAtKPO" />
        <input type="hidden" id="SubmitedByMD" value="@Model.INStoreTransferNote.SubmitedByMD" />
        <input type="hidden" id="SubmitedAtMD" value="@Model.INStoreTransferNote.SubmitedAtMD" />*@

    <input type="hidden" id="mCreatedBy" value="@Model.INStoreTransferNote.CreatedBy" />
    <input type="hidden" id="mCreatedAt" value="@Model.INStoreTransferNote.CreatedAt" />
    <input type="hidden" id="mModifiedBy" value="@Model.INStoreTransferNote.ModifiedBy" />
    <input type="hidden" id="mModifiedAt" value="@Model.INStoreTransferNote.ModifiedAt" />
    <input type="hidden" id="mApprovedByID" value="@Model.INStoreTransferNote.ApprovedByID" />
    <input type="hidden" id="mApprovedByAt" value="@Model.INStoreTransferNote.ApprovedByAt" />
    <input type="hidden" id="mReceivedByID" value="@Model.INStoreTransferNote.ReceivedByID" />
    <input type="hidden" id="mReceivedByAt" value="@Model.INStoreTransferNote.ReceivedByAt" />
    <input type="hidden" id="mCompanyID" value="@Model.INStoreTransferNote.CompanyID" />


    <div class="col-md-12">
        <div class="box box-info">
            <div class="form-horizontal" id="header">
                <div class="box-body">
                    <div class="box-header with-border">
                        <h2 class="box-title">Store Transfer Notes</h2>
                    </div>

                    @*@if (Model.INStoreTransferNote.IsPosted == true)
                        {
                            <h4 style="color:red; font:200;" class="box-title"> <b>Posted</b> </h4>
                        }*@

                    <br />
                    <div class="row" style="margin-bottom:10px;">
                        <label for="UserID" class="col-sm-1 control-label ">ID</label>
                        <div class="col-sm-3">
                            <input class="form-control integer" readonly value="@Model.INStoreTransferNote.StoreTransferNoteID" id="StoreTransferNoteID">

                        </div>

                    </div>

                    <div class="row" style="margin-bottom:10px;">
                        <label for="INStoreTransferNoteDate" class="control-label col-sm-1">Date</label>
                        <div class="col-sm-3">
                            <div class="input-group ">
                                <div class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </div>
                                <input class="form-control date-picker dt" placeholder="" autocomplete="off" id="INStoreTransferNoteDate" value="@Model.INStoreTransferNote.StoreTransferNoteDate.Value.ToString("dd-MMM-yyyy")" />
                            </div>
                            <span id="spnINStoreTransferNotesDateError" class="error" style="display:none;">Please select date</span>
                        </div>

                        <label for="RefOGPNo" class="control-label col-sm-1 ">REF OGP#</label>
                        <div class="col-sm-3">
                            <input class="form-control" value="@Model.INStoreTransferNote.RefOGPNo" id="RefOGPNo">
                            <span id="spnRefOGPNoError" class="error" style="display:none;">Please select ref/ogp no</span>
                        </div>

                    </div>


                    <div class="row" style="margin-bottom:10px;">

                        <label for="ToProjectID" class="control-label col-sm-1 PaddingTop-5">To Project</label>
                        <div class="col-sm-3">
                            @Html.DropDownListFor(x => x.INStoreTransferNote.ToProjectID, new SelectList(ViewBag.Projects, "ProjectID", "ProjectName"), "-- Select --", new { @class = "form-control showError ddl", @id = "ToProjectID" })
                            <span id="spnToProjectIDError" class="error" style="display:none;">You can not select same projects</span>
                        </div>

                        <label for="FromProjectID" class="control-label col-sm-1 PaddingTop-5">From Project</label>
                        <div class="col-sm-3">
                            @Html.DropDownListFor(x => x.INStoreTransferNote.FromProjectID, new SelectList(ViewBag.Projects, "ProjectID", "ProjectName"), "-- Select --", new { @class = "form-control showError ddl", @id = "FromProjectID" })
                            <span id="spnFromProjectIDError" class="error" style="display:none;">Please select from project</span>
                            <span id="spnProjectIDDuplicateError" class="error" style="display:none;">Please select different projects</span>
                        </div>

                    </div>


                    <div class="row" style="margin-bottom:10px;">
                        <label for="Remarks" class="col-sm-1 control-label ">Remarks</label>
