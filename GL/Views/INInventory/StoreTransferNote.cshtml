                                        <input type="text" class="requestDetailID" value="@item.RequestDetailID" style="display:none;" />
                                        @Html.LazyItemDropDown(itemIndex, (item.RequestDetailID + "," + item.ItemID), "form-control showError ddl item-list")
                                    </td>

                                    <td>
                                        <input type="text" readonly id="Size" class="form-control" placeholder="" value="@item.Size" />
                                    </td>

                                    <td>
                                        <input type="text" readonly id="Unit" class="form-control" placeholder="" value="@item.Unit" />
                                    </td>

                                    <td>
                                        <input type="text" id="rem" class="form-control remarks" placeholder="" value="@item.Remarks" onchange="hidSubmit();" />
                                    </td>

                                    <td>
                                        <input type="text" readonly style="text-align:right;" id="QtyInHand" class="form-control decimal post" value="@item.QtyInHand" />
                                        <span id="spnApprovedQtyError" class="error" style="display:none;">Approved qty is greater than requested qty</span>
                                    </td>

                                    @*<td>
                                            <input type="text" style="text-align:right;" id="RequestedQty" class="form-control decimal " value="@item.RequestedQty" />
                                        </td>*@

                                    <td>L
                                        <input type="text" style="text-align:right;" id="TransferQty" class="form-control decimal" value="@item.TransferQty" />
                                        <span id="spnTransferQtyError" class="error" style="display:none;">Please enter transfer qty</span>
                                        <span id="spnTransferQtyGreaterThanBalanceError" class="error" style="display:none;">Received qty can not be greater than demand balance</span>
                                        <span id="spnTransferQtyGreaterThanQtyInHandError" class="error" style="display:none;">Received qty can not be greater than qty in hand</span>
                                    </td>

                                    @if (Model.INStoreTransferNote.ApprovedByID.GetValueOrDefault(0) <= 0 && Model.INStoreTransferNote.StoreTransferNoteID > 0)
                                    {
                                        <td>
                                            <button class='btn btn-danger btn-xs delete-row' tabindex="-1"><i class='fa fa-times'></i></button>
                                        </td>
                                    }

                                </tr>
                                i = i + 1;
                            }
                        }
                        <tr>
                            <td style="width:50px;text-align:center;">
                                <input type="hidden" id="INStoreTransferNoteDetailID" value="" />
                                <input type="hidden" id="StoreTransferNoteID" value="" />
                                <input type="hidden" id="ItemID" value="" />

                                <input type="hidden" id="CreatedBy" value="" />
                                <input type="hidden" id="CreatedAt" value="" />
                                <input type="hidden" id="ModifiedBy" value="" />
                                <input type="hidden" id="ModifiedAt" value="" />
                                <input type="hidden" id="CompanyID" value="" />

                                <label></label>
                            </td>

                            <td style="width:300px">
                                <input type="text" class="itemId" value="" style="display: none;" />
                                <input type="text" class="requestDetailID" value="" style="display: none;" />
                                @Html.DropDownList("ItemID", new SelectList(ViewBag.INItems, "ItemID", "Description"), "-- Select --", new { @class = "form-control showError  ddl item-list", @id = "ItemID" })
                            </td>

                            <td>
                                <input type="text" readonly id="Size" class="form-control" placeholder="" value="" />
                            </td>

                            <td>
                                <input type="text" readonly id="Unit" class="form-control" placeholder="" value="" />
                            </td>

                            <td>
                                <input type="text" id="rem" class="form-control remarks" placeholder="" value="" />
                            </td>
                            <td>
                                <input type="text" readonly style="text-align:right;" id="QtyInHand" class="form-control decimal" value="" />
                                <span id="spnApprovedQtyError" class="error" style="display:none;">Approved qty is greater than requested qty</span>
                            </td>

                            @*<td>
                                    <input type="text" style="text-align:right;" id="RequestedQty" class="form-control decimal " value="" />
                                </td>*@

                            <td>
                                <input type="text" style="text-align:right;" id="TransferQty" class="form-control decimal" value="" />
                                <span id="spnTransferQtyError" class="error" style="display:none;">Please enter transfer qty</span>
                                <span id="spnTransferQtyGreaterThanBalanceError" class="error" style="display:none;">Received qty can not be greater than demand balance</span>
                                <span id="spnTransferQtyGreaterThanQtyInHandError" class="error" style="display:none;">Received qty can not be greater than qty in hand</span>
                            </td>


                            @if (Model.INStoreTransferNote.ApprovedByID.GetValueOrDefault(0) <= 0 && Model.INStoreTransferNote.StoreTransferNoteID > 0)
                            {
                                <td>
                                    <button class='btn btn-danger btn-xs delete-row' tabindex="-1"><i class='fa fa-times'></i></button>
                                </td>
                            }
                        </tr>

                    </tbody>
                    <tfoot>

                        @*<tr>
                                <td colspan="8" style="text-align:right;"><label style="font-size:20px;">Total Amount</label></td>
                                <td colspan="2"><input type="text" id="TotalAmount" style="font-size:large; font-weight:bold; background-color:white;" class="form-control number decimal" readonly value="0" /></td>
                                <td></td>
                            </tr>*@
                    </tfoot>

                </table>

            </div>

            <div class="box-footer">
                <div class="Actions">
                    @*<button class="btn btn-primary" onclick="fullReceived();"><span style="font-weight:bold;">++</span></button>*@
                    <a href="/INInventory/StoreTransferNoteList" class="btn btn-info ">Back to List</a>
                    <a href="/INInventory/StoreTransferNote" class="btn btn-primary">Add</a>
                    <a href="#" class="btn btn-default" onclick="location.reload();">Cancel</a>
                    <a onclick="downloadReport()" class=" btn btn-primary"> Download Report</a>
                    @if (Model.INStoreTransferNote.ApprovedByID.GetValueOrDefault(0) <= 0)
                    {
                        <a href="#" class="btn btn-primary btnSave">Save</a>
                    }
                    @if (Model.RoleID == 5 && Model.INStoreTransferNote.ApprovedByID.GetValueOrDefault(0) <= 0)
                    {
                        <a onclick="approve()" href="#" class="btn btn-success pull-right"> Approve</a>
                    }
                    @if (Model.RoleID == 4 && Model.INStoreTransferNote.ApprovedByID.GetValueOrDefault(0) > 0 && Model.INStoreTransferNote.ReceivedByID.GetValueOrDefault(0) <=0 )
                    {
                        <a onclick="receive()" id="btnReceive" class=" btn btn-primary pull-right"> Receive</a>
                    }
                </div>
            </div>



        </div>
    </div>

</section>
