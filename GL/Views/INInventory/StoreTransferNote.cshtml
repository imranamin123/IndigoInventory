                            <th style="width:150px;" class="align-right"><label>Transfer Qty</label></th>

                            @if (Model.INStoreTransferNote.ApprovedByID.GetValueOrDefault(0) > 0 && Model.INStoreTransferNote.StoreTransferNoteID > 0)
                            {
                                <th style="width:5px;"></th>
                            }


                        </tr>
                    </thead>
                    <tbody id="tbodyList">

                        @if (Model.INStoreTransferNoteDetailRows != null && Model.INStoreTransferNoteDetailRows.Count > 0)
                        {
                            int i = 0;
                            foreach (var item in Model.INStoreTransferNoteDetailRows)
                            {
                                <tr>
                                    <td style="width:50px;text-align:center;">
                                        <input type="hidden" id="INStoreTransferNoteDetailID" value="@item.StoreTransferNoteDetailID" />
                                        <input type="hidden" id="StoreTransferNoteID" value="@item.StoreTransferNoteID" />
                                        <input type="hidden" id="ItemID" value="@item.ItemID" />

                                        <input type="hidden" id="CreatedBy" value="@item.CreatedBy" />
                                        <input type="hidden" id="CreatedAt" value="@item.CreatedAt" />
                                        <input type="hidden" id="ModifiedBy" value="@item.ModifiedBy" />
                                        <input type="hidden" id="ModifiedAt" value="@item.ModifiedAt" />
                                        <input type="hidden" id="CompanyID" value="@item.CompanyID" />

                                        <label>@item.StoreTransferNoteDetailID</label>
                                    </td>

                                    <td style="width:300px">
