@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script id="StoreTransferNote">

        @*var roleId = @RoleID;
        var requestID = '';//
        var submitedByKPO = @SubmitedByKPO;
        var submitedByMD = @SubmitedByMD;
        var isNotSavedMD = false;
        var isNew = @IsNew;*@

        $().ready(function () {
            $("#APVendorID").select2();
            @*var roleId = @RoleID;
            var requestID = @RequestID;*@


            $('.dt').datepicker({
                autoclose: true,
                orientation: "bottom auto",  // Forces the datepicker to open downward
                format: 'dd-M-yyyy',
            });
            calculateTotals();

            //if (roleId == 5) {
            //    $('#header').find('input, select, textarea, button').prop('disabled', true);
            //}



            $("#tbodyList tr").each(function () {



                $(this).find(".ddl").select2();
                var itemId = $(this).find(".itemId").val();
                var requestDetailID = $(this).find(".requestDetailID").val();
                var value = requestDetailID + "," + itemId;
                $(this).find(".ddl").val(value).change();

                $(this).find(".select2.select2-container").css("width", "300px");
                calculateTotals();
            });

            ////$(document).on("change", "#Type", function () {

            ////    calculateVAT();
            ////    calculateTotals();
            ////    hidSubmit();
            ////});

            $(document).on("click", ".delete-row", function () {

                if (confirm("Are you sure you want to delete this row")) {
                    debugger;
                    var row = $(this).closest("tr");
                    var INStoreTransferNoteDetailID = $(this).closest("tr").find("#INStoreTransferNoteDetailID").val();

                    if ($("#tbodyList tr").length == $(this).closest('tr').index() + 1) {
                        $(row).find("#INStoreTransferNoteDetailID").val("");
                        $(row).find(".itemId").val("");
                        $(row).find(".requestDetailID").val("");
                        $(row).find("#Size").val("");
                        $(row).find("#Unit").val("");
                        $(row).find("#QtyInHand").val("");
                        $(row).find("#ApprovedQty").val("");

                        $(row).find("#QtyInHand").val("");
                        $(row).find("#RequestedQty").val("");
                        $(row).find("#TransferQty").val("");

                    }
                    else if (INStoreTransferNoteDetailID != "" || $(INStoreTransferNoteDetailID).val() > 0) {

                        $.get("/INInventory/StoreTransferNoteDetailDelete", { id: INStoreTransferNoteDetailID }).done(function (res) {

                            $(row).remove();
                             calculateTotals();


                        }).fail(function (ex) {

                            alert(ex.responseText);

                        }).always(function () { });

                    }
                    else if ((INStoreTransferNoteDetailID == "" || $(INStoreTransferNoteDetailID).val() == undefined)) {
                        var totalRows = $("#tbodyList tr").length;
                        if (totalRows > 1) {

                            $(row).remove();
                            calculateTotals();
                        }
                        else {
                            $(row).find("#GLAccountID").val("");
                            $(row).find("#Debit").val("");
                            $(row).find("#Credit").val("");
                            $(row).find("#GLNarration").val("");
                        }
                    }
                }
            });

            $(document).on("click", ".btnSubmit", function (e) {

                e.preventDefault;

                if (isNew == 1) {
                    alert("Please first save the requisition");
                    return;
                }

                $('.btnSubmit').attr('disabled', 'disabled');

                if (IsValid() == false) {
                    $('.btnSubmit').removeAttr('disabled');
                    return;
                }

                var requestId = $("#RequestID").val();


                $.post("/INInventory/INStoreTransferNoteSubmit", { RequestID: requestId }).done(function (res) {

                    if (res.status == true) {
                        alert(res.resMessage);
                        window.location = "/INInventory/PurchaseRequisitionList/";

                    }
                    else {
                        alert(res.resMessage);
                    }

                }).fail(function (ex) {
                    alert(ex.responseText);
                    // ShowAlert('Error', $(jQuery.parseHTML(ex.responseText)).eq(1).text(), true);
                }).always(function () {

                });

            });


            $(document).on("click", ".btnSave", function (e) {

                e.preventDefault;



                $('.btnSave').attr('disabled', 'disabled');

                if (IsValid() == false) {
                    $('.btnSave').removeAttr('disabled');
                    return;
                }



                var obj = getObject();
                var objDetails = getObjectDetails();



                $.post("/INInventory/INStoreTransferNoteSave", { INStoreTransferNote: obj, INStoreTransferNoteDetailList: objDetails }).done(function (res) {

                    if (res.status == true) {
                        alert(res.resMessage);
                        $('.btnSave').removeAttr('disabled');
                        window.location = "/INInventory/StoreTransferNote/" + res.id;

                    }
                    else {
                        alert(res.resMessage);
                    }

                }).fail(function (ex) {
                    alert(ex.responseText);
                    // ShowAlert('Error', $(jQuery.parseHTML(ex.responseText)).eq(1).text(), true);
                }).always(function () {
                    $('.btnSave').removeAttr('disabled');
                });

            });

            $(document).on("change", "#ItemID", function () {
                debugger;

                var Item = $(this).children("option:selected").val();// $(this).children("option").filter(":selected").val();
                var text = $(this).children("option:selected").text();
                var lastDashIndex = text.lastIndexOf("= ");
                var balance = text.substr(lastDashIndex + 2, (text.length - lastDashIndex));

                const [requestDetailID, itemID] = Item.split(',');

                $(this).closest("tr").find(".itemId").val(itemID).change();
                $(this).closest("tr").find(".requestDetailID").val(requestDetailID).change();

                var currentRow = $(this).closest("tr");
                $(currentRow).attr("Balance", balance);

                $(currentRow).find("#Unit").val("");
                $(currentRow).find("#Size").val("");
                $(currentRow).find("#QtyInHand").val("");
                $(currentRow).find("#TransferQty").val("");

                $.get("/INInventory/GetINGRNItemRow", { ItemID: itemID, RequestDetailID: requestDetailID }).done(function (res) {
                    if (res != "") {


                        $(currentRow).find("#Unit").val(res.Unit);
                        $(currentRow).find("#Size").val(res.Size);
                        $(currentRow).find("#QtyInHand").val(res.QtyInHand);
                       // $(currentRow).find("#ApprovedQty").val(res.ApprovedQty);

                        var totalRows = $("tr", "#tbodyList").length;
                        var currentRowIndex = currentRow.index();
                        var diff = totalRows - currentRowIndex;
                        if (diff == 1) {
                            var row = $('.trRowTemplate').clone();
                            $(row).removeClass("trRowTemplate");
                            $('#tbodyList').append(row);
                            $(row).find(".ddl").select2();
                            // $(row).find(".select2.select2-container").css("width", "300px");

                        }
                    }

                }).fail(function (ex) {
                    alert(ex.responseText);

                }).always(function () {

                });
            });

            $(document).on("change", "#ToProjectID", function () {
                debugger;
                var FromProjectID = $("#ToProjectID").val();
                if (FromProjectID != undefined && FromProjectID != "") {
                    var companyID = $("#mCompanyID").val();
                    $(".item-list").html("");
                    $(".item-list").append('<option value="">-- Select --</option>'); 
                    $.get("/INInventory/GetINGRDropdownItems", { CompanyID: companyID, ProjectID: FromProjectID }).done(function (res) {
                        if (res != "") {
 
                            $(res).each(function (index, element) {

                                $(".item-list").append('<option value="' + element.ItemID + '">' + element.Description + '</option>');

                            });
                            $(".item-list").attr('selectedIndex', 0);

                            $("#tbodyList").html("");

                            var row = $('.trRowTemplate').clone();
                            $(row).removeClass("trRowTemplate");
                            $('#tbodyList').append(row);
                            $(row).find(".ddl").select2();

                            $("#tbodyList").append(row);
                        }

                    }).fail(function (ex) {
                        alert(ex.responseText);

                    }).always(function () {

                    });
                }
            });

        });

        function hidSubmit() {
            debugger;
            $("#btnPost").css("display", "none");
