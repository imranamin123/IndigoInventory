        function IsValid() {

            var valid = true;
            $(".error").hide();


            if ($("#INStoreTransferNoteDate").val() == "") {
                $("#spnINStoreTransferNotesDateError").show();
                valid = false;
            }

            if ($("#RefOGPNo").val() == "") {
                $("#spnRefOGPNoError").show();
                valid = false;
            }

            if ($("#FromProjectID").val() == "") {
                $("#spnFromProjectIDError").show();
                valid = false;
            }

            if ($("#ToProjectID").val() == "") {
                $("#spnToProjectIDError").show();
                valid = false;
            }

            if ($("#FromProjectID").val() == $("#ToProjectID").val()) {
                $("#spnProjectIDDuplicateError").show();
                valid = false;
            }

            if ($("#Remarks").val() == "") {
                $("#spnRemarksError").show();
                valid = false;
            }



            $("#tbodyList").find('tr').each(function (index, elem) {

                //var ItemID = $("#VoucherTypeID").children("option").filter(":selected").text()


                if ($(this).find('.ddl').val() != null && $(this).find('.ddl').val() != "" ) {

                    debugger;

                    if ($(this).find('#TransferQty').val() == "" || $(this).find('#TransferQty').val() == "0") {
                        $(this).find('#spnTransferQtyError').show();
                        valid = false;
                    }

                    if (parseFloat($(this).find('#TransferQty').val()) > parseFloat($(this).find('#QtyInHand').val())) {
                        $(this).find('#spnTransferQtyGreaterThanQtyInHandError').show();
                        valid = false;
                    }
                    else if (parseFloat($(this).find('#TransferQty').val()) > parseFloat($(this).attr('balance'))) {
                        $(this).find('#spnTransferQtyGreaterThanBalanceError').show();
                        valid = false;
                    }

                }
            });

            var rowCount = $("#tbodyList").find('tr').length;
            if (rowCount == 1) {
                alert("Please enter data at least one row");
                valid = false;

            }

            return valid;
        }


