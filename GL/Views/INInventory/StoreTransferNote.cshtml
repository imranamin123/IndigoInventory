        function getObjectDetails() {
            var DetailRows = [];

            debugger;

            $("#tbodyList").find('tr').each(function (index, elem) {

                if ($(this).find('.ddl').val() != null && $(this).find('.ddl').val() != "") {
                    const [requestDetailID, itemID] = $(this).find('.ddl').val().split(',');
                    var DetailRow = {

                        StoreTransferNoteDetailID: $(this).find('#INStoreTransferNoteDetailID').val(),
                        StoreTransferNoteID: $(this).find('#StoreTransferNoteID').val(),
                        RequestDetailID: requestDetailID,
                        ItemID: itemID,
                        QtyInHand: $(this).find('#QtyInHand').val(),
                        TransferQty: $(this).find('#TransferQty').val(),
                        Remarks: $(this).find('#rem').val(),

                        //hidden fields
                        CompanyID: $(this).find('#CompanyID').val(),
                        CreatedBy: $(this).find('#CreatedBy').val(),
                        CreatedAt: $(this).find('#CreatedAt').val(),
                        ModifiedBy: $(this).find('#ModifiedBy').val(),
                        ModifiedAt: $(this).find('#ModifiedAt').val()
                    }
                    DetailRows.push(DetailRow);

                }
            });


            return DetailRows;
        }

        function calculateTotals() {

            var AmountSum = 0;
            //var creditSum = 0;


            $("#tbodyList").find('tr').each(function (index, elem) {

                if ($(this).find('.ddl').val() != null && $(this).find('.ddl').val() != "") {


                    var Amount = $(this).find('#Amount').val() == '' ? 0 : parseFloat($(this).find('#Amount').val());

                    AmountSum += parseFloat(Amount);
                    // $("#APInvoiceAmount").val(AmountSum);
                }
            });

            $("#TotalAmount").val(parseFloat(AmountSum).toFixed(2));
        }

