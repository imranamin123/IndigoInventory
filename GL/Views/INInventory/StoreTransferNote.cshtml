                            <input class="form-control" value="@Model.INStoreTransferNote.Remarks" id="Remarks">
                            <span id="spnRemarksError" class="error" style="display:none;">Please enter remarks</span>
                        </div>
                    </div>



                    <!-- /.box-body -->
