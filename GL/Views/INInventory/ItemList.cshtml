@model GL.ViewModels.Inventory.INItemViewModel

@{

    ViewBag.Title = "Users List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<!-- Main content -->
<section class="content">
    <div class="row">

        <div class="col-md-12">
            <div class="box box-info">
                <div class="form-horizontal">
                    <div class="box-body">
                        <div class="box-header with-border">
                            <h2 class="box-title">Item List</h2>
                        </div>
                        <br />
                        
                        <div class="row" style="margin-bottom:10px;">
                            <label for="ItemCode" class="col-sm-1 control-label">Code</label>
                            <div class="col-sm-4">
                                <input class="form-control" id="ItemCode">
                            </div>
                            <label for="GroupID" class="control-label col-sm-1 PaddingTop-5">Group</label>

                            <div class="col-sm-4">
                                   @Html.DropDownList("GroupID", new SelectList(ViewBag.INGroupList, "GroupID", "Name"), "-- Select --", new { @class = "form-control showError ddl", @id = "GroupID" })
                            </div>

                        </div>

                        <div class="row" style="margin-bottom:10px;">
                            <label for="Name" class="col-sm-1 control-label">Name</label>
                            <div class="col-sm-9">
                                <input class="form-control" id="Name">
                            </div>

                        </div>

                            <!-- /.box-body -->
                            <div class="box-footer">
                                <a href="/INInventory/Item" class="btn btn-primary">Add</a>
                                <button class="btn btn-info pull-right" onclick="search()">Search</button>
                            </div>
                            <!-- /.box-footer -->
                            @*</form>*@

                        </div>
                    </div>

            </div>
        </div>
    </div>


    <div class="row">
        <div id="ListRows">
        </div>

    </div>
</section>
@*<link rel="stylesheet" href="//cdn.datatables.net/1.10.20/css/jquery.dataTables.min.css">*@

@section scripts{

    <script class="INItemList">

        $().ready(function () {

            $(".ddl").select2();
        });

        function getSearchObject() {

            var obj = {
                ItemCode: $("#ItemCode").val(),
                Name: $("#Name").val(),
                GroupID: $("#GroupID").val() == "" ? null : $("#GroupID").val()
            };
            return obj;
        }

        function search() {

            //var obj = getSearchObject();

            debugger;

            var ItemCode = $("#ItemCode").val();
            var Name = $("#Name").val();
            var GroupID = $("#GroupID").val() == "" ? null : $("#GroupID").val();

            serverPagedList("#ListRows", "/INInventory/ItemSearchList", { ItemCode: ItemCode, Name: Name, GroupID: GroupID }, { order: [[0, "asc"]] });

        }


    </script>
}



