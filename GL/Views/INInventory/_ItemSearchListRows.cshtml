@model GL.ViewModels.Inventory.INItemViewModel
@{
    Layout = null;
}
<div class="box box-info">
    <div class="box-body">
        <div class="col-sm-12" style="overflow:auto;">

            <table class="table" id="tblList">
                <thead>
                    <tr>
                        <th>
                            <label>ID</label>
                        </th>
                        <th>
                            <label>Item Code</label>
                        </th>
                        <th>
                            <label>Description</label>
                        </th>
                        <th>
                            <label>Group</label>
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in Model.INItemSearchList)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.ItemID)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ItemCode)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Description)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.Group)
                            </td>
                            <td>
                                <a href="/INInventory/Item/@item.ItemID" class="btn btn-primary btn-xs"><i class="fa fa-edit"></i></a>
                                @*<a href="/Students/Delete/@item.StudentID" class="btn btn-danger btn-xs" onclick="return confirm('Are you sure you want to delete this record ?');"><i class="fa fa-times"></i></a>*@

                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>
@*</div>*@

<script>
    $().ready(function () {
        $('#tblList').DataTable({
            'paging': true,
            'lengthChange': true,
            'searching': true,
            'ordering': true,
            'info': true,
            'autoWidth': true
        });

    });
</script>