        function hidSubmit() {

            $("#btnPost").css("display", "none");
        }

        function IsValid() {


            var valid = true;
            $(".error").hide();

            if ($("#POStatusID").val() == "") {
                $("#spnPOStatusIDError").show();
                valid = false;
            }


            if ($("#PurchaseOrderDate").val() == "") {
                $("#spnPurchaseOrderDateError").show();
                valid = false;
            }

            if ($("#ProjectID").val() == "") {
                $("#spnProjectIDError").show();
                valid = false;
            }

            if ($("#APVendorID").val() == "" ) {
                $("#spnAPVendorIDError").show();
                valid = false;
            }

            if ($("#APVendorID").val() == "") {
                $("#spnAPVendorIDError").show();
                valid = false;
            }
            if ($("#PaymentTerms").val() == "") {
                $("#spnPaymentTermsError").show();
                valid = false;
            }


            if ($("#RequestID").val() == "") {
                $("#spnRequestIDError").show();
                valid = false;
            }

            $("#tbodyList").find('tr').each(function (index, elem) {


                if ($(this).find('.ddl').val() != null && $(this).find('.ddl').val() != "" ) {

                    if ($(this).find('#ApprovedQty').val() == "" || $(this).find('#ApprovedQty').val() == "0") {
                        $(this).find('#spnApprovedQtyError').show();
                        valid = false;
                    }

                    var apQty = $(this).find('#ApprovedQty').val() == '' ? 0: $(this).find('#ApprovedQty').val();
                    if (parseFloat(apQty) > parseFloat($(this).attr('balance'))) {
                        $(this).find('#spnApprovedQtyGreaterError').show();
                        valid = false;
                    }

                    if ($(this).find('#UnitPrice').val() == "" || $(this).find('#UnitPrice').val() == "0") {
                        $(this).find('#spnUnitPriceError').show();
                        valid = false;
                    }

                }
            });

            var rowCount = $("#tbodyList").find('tr').length;
            if (rowCount == 1) {
                alert("Please enter data at least one row");
                valid = false;

            }

            return valid;
        }


