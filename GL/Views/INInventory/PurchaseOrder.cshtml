            $(document).on("click", ".btnSave", function (e) {



                e.preventDefault;

                $('.btnSave').attr('disabled', 'disabled');

                if (IsValid() == false) {
                    $('.btnSave').removeAttr('disabled');
                    return;
                }



                var obj = getObject();

                var objDetails = getObjectDetails();



                $.post("/INInventory/INPurchaseOrderSave", { INPurchaseOrder: obj, INPurchaseOrderDetailList: objDetails }).done(function (res) {

                    if (res.status == true) {
                        alert(res.resMessage);
                        $('.btnSave').removeAttr('disabled');
                        window.location = "/INInventory/PurchaseOrder?PurchaseOrderID=" + res.id;

                    }
                    else {
                        alert(res.resMessage);
                    }

                }).fail(function (ex) {
