@model GL.ViewModels.Inventory.INPurchaseOrderViewModel

@{

    ViewBag.Title = "Purchase Order";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<a href="~/Views/INInventory/PurchaseOrder.cshtml">~/Views/INInventory/PurchaseOrder.cshtml</a>

<style>
    .error {
        color: red;
    }

    .errorDetail {
        border-color: red;
        color: black;
    }
</style>

<section class="content-fluid">

    <input type="hidden" id="mApprovedBy" value="@Model.INPurchaseOrder.ApprovedBy" />
    <input type="hidden" id="mApprovedAt" value="@Model.INPurchaseOrder.ApprovedAt" />
    <input type="hidden" id="mCreatedBy" value="@Model.INPurchaseOrder.CreatedBy" />
    <input type="hidden" id="mCreatedAt" value="@Model.INPurchaseOrder.CreatedAt" />
    <input type="hidden" id="mModifiedBy" value="@Model.INPurchaseOrder.ModifiedBy" />
    <input type="hidden" id="mModifiedAt" value="@Model.INPurchaseOrder.ModifiedAt" />
    <input type="hidden" id="mCompanyID" value="@Model.INPurchaseOrder.CompanyID" />
    <input type="hidden" id="mGoodsReceiptNoteID" value="@Model.INPurchaseOrder.GoodsReceiptNoteID" />


    <div class="col-md-12">
        <div class="box box-info">
            <div class="form-horizontal" id="header">
                <div class="box-body">
                    <div class="box-header with-border">
                        <h2 class="box-title">Purchase Order</h2>
                    </div>

                    @if (Model.INPurchaseOrder.ApprovedBy.GetValueOrDefault(0) > 0)
                    {
                        <h4 style="color:red; font:200;" class="box-title"> <b>Approved</b> </h4>
                    }

                    <br />
                    <div class="row" style="margin-bottom:10px;">
                        <label for="UserID" class="col-sm-2 control-label ">ID</label>
                        <div class="col-sm-3">
                            <input class="form-control integer" readonly value="@Model.INPurchaseOrder.PurchaseOrderID" id="PurchaseOrderID">

                        </div>
                        <label class="control-label col-sm-2">PO Status</label>
                        <div class="col-sm-3">
                            @Html.DropDownListFor(x => x.INPurchaseOrder.POStatusID, new SelectList(ViewBag.INPOStatusList, "POStatusID", "Description"), new { disabled = "disbled", @class = "form-control showError ddl", @id = "POStatusID" })
                            <span id="spnPOStatusIDError" class="error" style="display:none;">Please select status type</span>
                        </div>
                    </div>

                    <div class="row" style="margin-bottom:10px;">
                        <label for="INPurchaseOrdersDate" class="control-label col-sm-2">Date</label>
                        <div class="col-sm-3">
                            <div class="input-group ">
                                <div class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </div>
                                <input class="form-control date-picker dt" placeholder="" autocomplete="off" id="PurchaseOrderDate" value="@Model.INPurchaseOrder.PurchaseOrderDate.Value.ToString("dd-MMM-yyyy")" />
                            </div>
                            <span id="spnPurchaseOrderDateError" class="error" style="display:none;">Please select date</span>
                        </div>

                        <label for="ProjectID" class="control-label col-sm-2 PaddingTop-5">Project</label>
                        <div class="col-sm-3">
                            @Html.DropDownListFor(x => x.INPurchaseOrder.ProjectID, new SelectList(ViewBag.Projects, "ProjectID", "ProjectName"), "-- Select --", new { @class = "form-control showError ddl", @id = "ProjectID" })
                            <span id="spnProjectIDError" class="error" style="display:none;">Please select project</span>
                        </div>

                    </div>


                    <div class="row" style="margin-bottom:10px;">
                        <label for="APVendorID" class="control-label col-sm-2 ">Vendor</label>
                        <div class="col-sm-3">
                            @Html.DropDownListFor(x => x.INPurchaseOrder.APVendorID, new SelectList(ViewBag.APVendors, "APVendorID", "DisplayText"), "-- Select --", new { @class = "form-control showError", @id = "APVendorID" })
                            <span id="spnAPVendorIDError" class="error" style="display:none;">Please select vendor</span>
                        </div>

                        @*<label for="RequestID" class="control-label col-sm-2 ">Demand ID</label>
                            <div class="col-sm-3">
                                <input class="form-control" value="@Model.INPurchaseOrder.RequestID" id="RequestID">
                                <span id="spnRequestIDError" class="error" style="display:none;">Please select demand id</span>
                            </div>
                            <div class="col-sm-3">
                                 <a href="#" id="loadPurchaseDemand" class="btn btn-primary" style=" margin-left: -24px;">Load</a>
                            </div>*@


                    </div>

                    <div class="row" style="margin-bottom:10px;">
                        <label for="PaymentTerms" class="col-sm-2 control-label ">Payment Terms</label>
                        <div class="col-sm-8">
                            <input class="form-control" value="@Model.INPurchaseOrder.PaymentTerms" id="PaymentTerms">
                            <span id="spnPaymentTermsError" class="error" style="display:none;">Please enter payment terms</span>
                        </div>
                    </div>


                    <div class="row" style="margin-bottom:10px;">
                        <label for="Remarks" class="col-sm-2 control-label ">Remarks</label>
                        <div class="col-sm-8">
                            @*<input class="form-control" value="@Model.INPurchaseOrder.Remarks" id="Remarks">*@
                            <textarea  class="form-control" rows="4" id="Remarks">@Model.INPurchaseOrder.Remarks</textarea>
                            <span id="spnRemarksError" class="error" style="display:none;">Please enter remarks</span>
                        </div>
                    </div>



                    <!-- /.box-body -->
                    <div class="box-footer">
                        @*<a href="/GLINPurchaseOrder/GLINPurchaseOrder" class="btn btn-primary">Add</a>*@

                    </div>
                    <!-- /.box-footer -->
                    @*</form>*@

                </div>
            </div>


            <div style="margin-top: 7px;">

                <table class="table table-striped tblDetail" id="tblList">
                    <thead>
                        <tr>


                            <th style="width:50px;text-align:center" class="th"><label>ID</label></th>
                            <th style="text-align:left;"><label>Item</label></th>
                            <th style="width:150px;" class="align-right"><label>Size</label></th>
                            <th style="width:150px;" class="align-right"><label>Unit</label></th>
                            @*<th style="text-align: left; width: 200px;"><label>Remarks</label></th>*@
                            @*<th style="width:150px;" class="align-right"><label>Requested Qty</label></th>*@
                            <th style="width:150px;" class="align-right"><label>Qty</label></th>
                            <th style="width:150px;" class="align-right"><label>Unit Price</label></th>
                            <th style="width:150px;" class="align-right"><label>Discount Price</label></th>
                            <th style="width:150px;" class="align-right"><label>Amount</label></th>

                            @if (Model.INPurchaseOrder.ApprovedBy.GetValueOrDefault(0) > 0 && Model.INPurchaseOrder.PurchaseOrderID > 0)
                            {
                                <th style="width:5px;"></th>
                            }


                        </tr>
                    </thead>
                    <tbody id="tbodyList">

                        @if (Model.INPurchaseOrderDetailRows != null && Model.INPurchaseOrderDetailRows.Count > 0)
                        {
                            int i = 0;
                            foreach (var item in Model.INPurchaseOrderDetailRows)
                            {
                                <tr>
                                    <td style="width:50px;text-align:center;">
                                        <input type="hidden" id="PurchaseOrderDetailID" value="@item.PurchaseOrderDetailID" />
                                        <input type="hidden" id="PurchaseOrderID" value="@item.PurchaseOrderID" />
                                        <input type="hidden" id="ItemID" value="@item.ItemID" />

                                        <input type="hidden" id="CreatedBy" value="@item.CreatedBy" />
                                        <input type="hidden" id="CreatedAt" value="@item.CreatedAt" />
                                        <input type="hidden" id="ModifiedBy" value="@item.ModifiedBy" />
                                        <input type="hidden" id="ModifiedAt" value="@item.ModifiedAt" />
                                        <input type="hidden" id="CompanyID" value="@item.CompanyID" />

                                        <label>@item.PurchaseOrderDetailID</label>
                                    </td>

                                    <td style="width:300px">
                                        <input type="text" class="itemId" value="@item.ItemID" style="display:none;" />
                                        <input type="text" class="requestDetailID" value="@item.RequestDetailID" style="display:none;" />
                                        @Html.DropDownListFor(x => x.INPurchaseOrderDetailRows[i].ItemID, new SelectList(ViewBag.INItems, "ItemID", "Description"), "-- Select --", new { @class = "form-control showError  ddl item-list", @id = "ItemID" })
                                    </td>

                                    <td>
                                        <input type="text" readonly id="Size" class="form-control" placeholder="" value="@item.Size" />
                                    </td>

                                    <td>
                                        <input type="text" readonly id="Unit" class="form-control" placeholder="" value="@item.Unit" />
                                    </td>

                                    @*<td>
            <input type="text" readonly style="text-align:right;" id="RequestedQty" class="form-control decimal post" value="@item.RequestedQty" />
            <span id="spnRequestedQtyError" class="error" style="display:none;">Approved qty is greater than requested qty</span>
        </td>*@

                                    <td>
                                        <input type="text" style="text-align:right;" id="ApprovedQty" class="form-control decimal " onblur="calculateTotals();" onchange="hidSubmit();" value="@item.ApprovedQty" />
                                        <span id="spnApprovedQtyError" class="error" style="display:none;">Approved qty is greater than requested qty</span>
                                        <span id="spnApprovedQtyGreaterError" class="error" style="display:none;">Approved qty can not be greater than requested qty</span>
                                    </td>

                                    <td>
                                        <input type="text" style="text-align:right;" id="UnitPrice" class="form-control decimal" onblur="calculateTotals();" onchange="hidSubmit();" value="@item.UnitPrice" />
                                        <span id="spnUnitPriceError" class="error" style="display:none;">Please enter unit price</span>
                                    </td>

                                    <td>
                                        <input type="text" style="text-align:right;" id="DiscountedPrice" class="form-control decimal" onblur="calculateTotals();" onchange="hidSubmit();" value="@item.DiscountedPrice" />
                                    </td>

                                    <td>
                                        <input type="text" readonly style="text-align:right;" id="Amount" class="form-control decimal" onchange="hidSubmit();" value="@item.Amount" />
                                    </td>

                                    @if (Model.INPurchaseOrder.ApprovedBy.GetValueOrDefault(0) <= 0 && Model.INPurchaseOrder.PurchaseOrderID > 0)
                                    {
                                        <td>
                                            <button class='btn btn-danger btn-xs delete-row' tabindex="-1"><i class='fa fa-times'></i></button>
                                            @*<button class='btn btn-primary btn-xs add-row' tabindex="-1"><i class='fa fa-times'></i></button>*@
                                        </td>
                                    }
                                </tr>
                                i = i + 1;
                            }
                        }
                    <tr>
                        <td style="width:50px;text-align:center;">
                            <input type="hidden" id="PurchaseOrderDetailID" value="" />
                            <input type="hidden" id="PurchaseOrderID" value="" />
                            <input type="hidden" id="ItemID" value="" />

                            <input type="hidden" id="CreatedBy" value="" />
                            <input type="hidden" id="CreatedAt" value="" />
                            <input type="hidden" id="ModifiedBy" value="" />
                            <input type="hidden" id="ModifiedAt" value="" />
                            <input type="hidden" id="CompanyID" value="" />

                            <label></label>
                        </td>

                        <td style="width:300px">
                            <input type="text" class="itemId" value="" style="display:none;" />
                            <input type="text" class="requestDetailID" value="" style="display:none;" />
                            @Html.DropDownList("ItemID", new SelectList(ViewBag.INItems, "ItemID", "Description"), "-- Select --", new { @class = "form-control showError  ddl item-list", @id = "ItemID" })
                        </td>

                        <td>
                            <input type="text" readonly id="Size" class="form-control" placeholder="" value="" />
                        </td>

                        <td>
                            <input type="text" readonly id="Unit" class="form-control" placeholder="" value="" />
                        </td>

                        <!--<td>
        <input type="text" readonly style="text-align:right;" id="RequestedQty" class="form-control decimal post"  value="" />-->
                        @*<span id="spnRequestedQtyError" class="error" style="display:none;">Approved qty is greater than requested qty</span>*@
                        <!--</td>-->

                        <td>
                            <input type="text" style="text-align:right;" id="ApprovedQty" class="form-control decimal " onblur="calculateTotals();" value="" />
                            <span id="spnApprovedQtyError" class="error" style="display:none;">Please add approved qty</span>
                            <span id="spnApprovedQtyGreaterError" class="error" style="display:none;">Approved qty can not be greater than requested qty</span>
                        </td>

                        <td>
                            <input type="text" style="text-align:right;" id="UnitPrice" class="form-control decimal" onblur="calculateTotals();" value="" />
                            <span id="spnUnitPriceError" class="error" style="display:none;">Please enter unit price</span>
                        </td>

                        <td>
                            <input type="text" style="text-align:right;" id="DiscountedPrice" class="form-control decimal" onblur="calculateTotals();" onchange="hidSubmit();" value="" />
                        </td>

                        <td>
                            <input type="text" style="text-align:right;" id="Amount" class="form-control decimal" value="" />
                        </td>

                        @if (Model.INPurchaseOrder.ApprovedBy.GetValueOrDefault(0) <= 0 && Model.INPurchaseOrder.PurchaseOrderID > 0)
                        {
                            <td>
                                <button class='btn btn-danger btn-xs delete-row' tabindex="-1"><i class='fa fa-times'></i></button>
                                @*<button class='btn btn-primary btn-xs add-row' tabindex="-1"><i class='fa fa-times'></i></button>*@
                            </td>
                        }
                    </tr>

                    </tbody>
                    <tfoot>

                        <tr>
                            <td colspan="6" style="text-align:right;"><label style="font-size:20px;">Total Amount</label></td>
                            <td colspan="2"><input type="text" id="TotalAmount" style="font-size:large; font-weight:bold; background-color:white;" class="form-control number decimal" readonly value="0" /></td>
                            <td></td>
                        </tr>
                    </tfoot>

                </table>

            </div>


            <div class="box-footer">
                <div class="Actions">
                    @*<button class="btn btn-primary" onclick="fullReceived();"><span style="font-weight:bold;">++</span></button>*@
                    <a href="/INInventory/PurchaseOrderList" class="btn btn-info ">Back to List</a>
                    <a href="/INInventory/PurchaseOrder" class="btn btn-primary">Add</a>
                    <a href="#" class="btn btn-default" onclick="location.reload();">Cancel</a>
                    @if (Model.INPurchaseOrder.ApprovedBy.GetValueOrDefault(0) <= 0)
                    {
                        <a href="#" class="btn btn-primary btnSave">Save</a>
                    }

                    @if (Model.INPurchaseOrder.PurchaseOrderID > 0)
                    {
                        <a href="/ReportsWebForms/ReportForm.aspx?ReportName=INPurchaseOrderReportDownload&PurchaseOrderID=@Model.INPurchaseOrder.PurchaseOrderID" class=" btn btn-success" target="_blank"> View Report</a>
                    }

                    @*@if (Model.RoleID == 4 && Model.INPurchaseOrder.PurchaseOrderID > 0)
                        {
                            <a href="#" class="btn btn-success btnSubmit pull-right">Submit</a>
                        }*@
                    @if (Model.RoleID == 5 && Model.INPurchaseOrder.ApprovedBy.GetValueOrDefault(0) <= 0)
                    {
                        <a onclick="approve()" class="btn btn-success btnSubmit pull-right" id="approve">Approve</a>
                    }

                    @*@if (Model.INPurchaseOrder.IsPosted.GetValueOrDefault(false) == false && Model.INPurchaseOrder.INPurchaseOrderID > 0)
                        {
                            <a onclick="post()" id="btnPost" class=" btn btn-danger pull-right"> Post</a>
                        }*@
                </div>
            </div>



        </div>
    </div>

</section>
