                        $(row).find("#UnitPrice").val("");
                        $(row).find("#DiscountedPrice").val("");
                        $(row).find("#Amount").val("");


                    }
                    else if (PurchaseOrderDetailID != "" || $(PurchaseOrderDetailID).val() > 0) {

                        $.get("/INInventory/INPurchaseOrderDetailDelete", { id: PurchaseOrderDetailID }).done(function (res) {

                            $(row).remove();
                             calculateTotals();


                        }).fail(function (ex) {

                            alert(ex.responseText);

                        }).always(function () { });

                    }
                    else if ((PurchaseOrderDetailID == "" || $(PurchaseOrderDetailID).val() == undefined)) {
                        var totalRows = $("#tbodyList tr").length;
                        if (totalRows > 1) {

                            $(row).remove();
                            calculateTotals();
                        }
                        else {
                            //$(row).find("#ItemID").val("");
