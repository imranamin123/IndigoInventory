@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script id="PurchaseRequisition">

        var roleId = @RoleID;
        var requestID = @RequestID;
        var submitedByKPO = @SubmitedByKPO;
        var submitedByMD = @SubmitedByMD;
        var isNotSavedMD = false;
        var isNew = @IsNew;

    $().ready(function () {
        debugger;
        var RequestID = $('#RequestID').val();

        if (@SubmitedByMD == 1) {
            $("#submit").hide();
        }

            // $(".ddl").select2();
            @*var roleId = @RoleID;
            var requestID = @RequestID;*@

            //$(".qty-changed").chang(function () {
            //    debugger;
            //    $("#btnSubmit").css("display","none");
            //});

            $('#RequestDate').datepicker({
                autoclose: true,
                orientation: "bottom auto",  // Forces the datepicker to open downward
                format: 'dd-M-yyyy',
            });

            if (roleId == 5) {
                $('#header').find('input, select, textarea, button').prop('disabled', true);
            }


            $("#tbodyList tr").each(function () {

                let self = this;

                debugger;

                if (roleId == 4)//KPO
                {
                    $(self).find('#ApprovedQty').prop("readonly", true);
                }
                else if (roleId == 5) {


                    $(self).find('#RequestedQty').prop("readonly", true);
                    $(self).find(".ddl").prop("disabled", true)
                    var approvedQty = $(self).find('#ApprovedQty').val();
                    debugger;
                    if ((approvedQty == "") && (submitedByMD == null || submitedByMD == 0 ) ) {
                        $(self).find('#ApprovedQty').val($(self).find('#RequestedQty').val());
                    }

                }


                $(this).find(".ddl").select2();
                var itemId = $(self).find(".itemId").val();
                $(this).find(".ddl").val(itemId).change();


                $(this).find(".select2.select2-container").css("width", "300px");

            });


            $(document).on("click", ".delete-row", function () {

                if (confirm("Are you sure you want to delete this row")) {

                    var row = $(this).closest("tr");
                    var RequestDetailID = $(this).closest("tr").find("#RequestDetailID").val();

                    if ($("#tbodyList tr").length == $(this).closest('tr').index() + 1) {
                        $(row).find("#ItemID").val("");
                        $(row).find("#Size").val("");
                        $(row).find("#Unit").val("");
                        $(row).find("#RequestedQty").val("");
                        $(row).find("#ApprovedQty").val("");
                        $(row).find("#QtyInHand").val("");
                        $(row).find("#LastRate").val("");
                        $(row).find("#Balance").val("");
                    }
                    else if (RequestDetailID != "" || $(RequestDetailID).val() > 0) {

                        $.get("/INInventory/INPurchaseRequisitionDetailDelete", { id: RequestDetailID }).done(function (res) {

                            $(row).remove();
                            // calculateTotals();


                        }).fail(function (ex) {

                            alert(ex.responseText);

                        }).always(function () { });

                    }
                    else if ((RequestDetailID == "" || $(RequestDetailID).val() == undefined)) {
                        var totalRows = $("#tbodyList tr").length;
                        if (totalRows > 1) {

                            $(row).remove();
                            calculateTotals();
                        }
                        else {
                            $(row).find("#GLAccountID").val("");
                            $(row).find("#Debit").val("");
                            $(row).find("#Credit").val("");
                            $(row).find("#GLNarration").val("");
                        }
                    }
                }
            });


        var IsSubmit = false;
            $(document).on("click", ".btnSubmit", function (e) {

                e.preventDefault;

                debugger;

                if (isNew == 1) {
                    alert("Please first save the requisition");
                    return;
                }

                $('.btnSubmit').attr('disabled', 'disabled');

                var requestId = $("#RequestID").val();

                IsSubmit = true;
                if (IsValid() == false) {
                    $('.btnSave').removeAttr('disabled');
                    IsSubmit = false;
                    return;
                }
                $(".btnSave").trigger("click");

                debugger;

                $.post("/INInventory/INPurchaseRequisitionSubmit", { RequestID: requestId }).done(function (res) {

                    if (res.status == true) {


                        alert(res.resMessage);
                        window.location = "/INInventory/PurchaseRequisition/" + requestId;
                        //window.location = "/INInventory/PurchaseRequisitionList/";

                    }
                    else {
                        alert(res.resMessage);
                    }

                }).fail(function (ex) {
                    alert(ex.responseText);
                    // ShowAlert('Error', $(jQuery.parseHTML(ex.responseText)).eq(1).text(), true);
                }).always(function () {
                    debugger;
                    IsSubmit = false;
                });

            });


            $(document).on("click", ".btnSave", function (e) {

                e.preventDefault;

                debugger;

                $('.btnSave').attr('disabled', 'disabled');

                if (IsValid() == false) {
                    $('.btnSave').removeAttr('disabled');
                    return;
                }



                var obj = getObject();
                var objDetails = getObjectDetails();

                debugger;

                $.post("/INInventory/INPurchaseRequisitionObjectSave", { INPurchaseRequisition: obj, INPurchaseRequisitionDetailList: objDetails }).done(function (res) {

                    if (res.status == true) {
                        alert(res.resMessage);
                        $('.btnSave').removeAttr('disabled');
                        if (IsSubmit == false)
                            window.location = "/INInventory/PurchaseRequisition/" + res.id;

                    }
                    else {
                        alert(res.resMessage);
                    }

                }).fail(function (ex) {
                    alert(ex.responseText);
                    // ShowAlert('Error', $(jQuery.parseHTML(ex.responseText)).eq(1).text(), true);
                }).always(function () {
                    $('.btnSave').removeAttr('disabled');
                });

            });


        $(document).on("change", "#ProjectID", function ()
        {
            debugger;
            var projectID = $("#ProjectID").val();
            if (projectID != undefined && projectID != "") {
                $("#tbodyList").find('tr').each(function (index, elem) {
                    if ($(this).find('.ddl').val() != "" && $(this).find('.ddl').val() > 0) {
                        $(this).closest("tr").find(".ddl").trigger('change');
                    }
                });
            }
        });

        $(document).on("change", "#ItemID", function () {
            debugger;
            var projectID = $("#ProjectID").val();
            if (projectID == undefined || projectID == "") {
                alert("Please select a project first");
                $(this).closest("tr").find("#select2-ItemID-container").html('-- Select --');
                return;
            }

            var itemId = $(this).children("option:selected").val();
            $(this).closest("tr").find("#itemId").val(itemId);

            var currentRow = $(this).closest("tr");
            $(currentRow).find("#Size").val("");
            $(currentRow).find("#Unit").val("");

            $(currentRow).find("#RequestedQty").val("");
            $(currentRow).find("#ApprovedQty").val("");
            $(currentRow).find("#QtyInHand").val("");
            $(currentRow).find("#LastRate").val("");
            $(currentRow).find("#Balance").val("");

            $.get("/INInventory/GetINGetItemRow", { ProjectID: projectID, ItemID: itemId }).done(function (res) {
                if (res != "") {
                    debugger;
                        $(currentRow).find("#Size").val(res.Size);
                        $(currentRow).find("#Unit").val(res.Unit);
                        $(currentRow).find("#QtyInHand").val(res.QtyInHand);
                        $(currentRow).find("#LastRate").val(res.LastRate);
                        $(currentRow).find("#Balance").val(res.Balance);

                        var totalRows = $("tr", "#tbodyList").length;
                        var currentRowIndex = currentRow.index();
                        var diff = totalRows - currentRowIndex;
                        if (diff == 1) {
                            var row = $('.trRowTemplate').clone();
