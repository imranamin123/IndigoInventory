        <td style="width:300px;">
            @Html.DropDownList("ItemID", new SelectList(ViewBag.INItems, "ItemID", "Description"), "-- Select --", new { @class = "form-control showError  ddl", @id = "ItemID" })
            @* @Html.DropDownListFor(x => x.INPurchaseRequisitionRows[i].ItemID, new SelectList(ViewBag.GLAccounts, "ItemID", "Description"), "-- Select --", new { @class = "form-control showError  ddl", @id = "ItemID" })*@
