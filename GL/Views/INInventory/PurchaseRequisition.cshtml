@model GL.ViewModels.Inventory.INPurchaseRequisitionViewModel

@{

    ViewBag.Title = "Purchase Requisition";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var RoleID = Model.RoleID;
    var RequestID = Model.INPurchaseRequisition.RequestID;
    var SubmitedByKPO = Model.SubmitedByKPO;
    var SubmitedByMD = Model.SubmitedByMD;
    var IsNew = Model.IsNew;

}



<style>
    .error {
        color: red;
    }

    .errorDetail {
        border-color: red;
        color: black;
    }
</style>

<section class="content-fluid">
    <input type="hidden" id="SubmitedByKPO" value="@Model.INPurchaseRequisition.SubmitedByKPO" />
    <input type="hidden" id="SubmitedAtKPO" value="@Model.INPurchaseRequisition.SubmitedAtKPO" />
    <input type="hidden" id="SubmitedByMD" value="@Model.INPurchaseRequisition.SubmitedByMD" />
    <input type="hidden" id="SubmitedAtMD" value="@Model.INPurchaseRequisition.SubmitedAtMD" />

    <input type="hidden" id="mCreatedBy" value="@Model.INPurchaseRequisition.CreatedBy" />
    <input type="hidden" id="mCreatedAt" value="@Model.INPurchaseRequisition.CreatedAt" />
    <input type="hidden" id="mModifiedBy" value="@Model.INPurchaseRequisition.ModifiedBy" />
    <input type="hidden" id="mModifiedAt" value="@Model.INPurchaseRequisition.ModifiedAt" />
    <input type="hidden" id="mCompanyID" value="@Model.INPurchaseRequisition.CompanyID" />
    <input type="hidden" id="mDocumentNo" value="@Model.INPurchaseRequisition.DocumentNo" />


    <div class="col-md-12">
        <div class="box box-info">
            <div class="form-horizontal" id="header">
                <div class="box-body">
                    <div class="box-header with-border">
                        <h2 class="box-title">Purchase Requisition </h2>
                    </div>
                    <br />

                    <div class="row" style="margin-bottom:10px;">
                        <label for="UserID" class="col-sm-1 control-label ">ID</label>
                        <div class="col-sm-3">
                            <input class="form-control integer" readonly value="@Model.INPurchaseRequisition.RequestID" id="RequestID">

                        </div>
                        <label for="RequestDate" class="control-label col-sm-1">Date</label>
                        <div class="col-sm-3">
                            <div class="input-group ">
                                <div class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </div>
                                <input class="form-control date-picker" placeholder="" autocomplete="off" id="RequestDate" value="@Model.INPurchaseRequisition.RequestDate.Value.ToString("dd-MMM-yyyy")" />
                            </div>
                            <span id="spnRequestDateError" class="error" style="display:none;">Please select request date</span>
                        </div>
                    </div>

                    <div class="row" style="margin-bottom:10px;">
                        <label for="ProjectID" class="control-label col-sm-1 PaddingTop-5">Project</label>
                        <div class="col-sm-3">
                            @Html.DropDownListFor(x => x.INPurchaseRequisition.ProjectID, new SelectList(ViewBag.Projects, "ProjectID", "ProjectName"), "-- Select --", new { @class = "form-control showError ddl", @id = "ProjectID" })
                            <span id="spnProjectIDError" class="error" style="display:none;">Please select project</span>
                        </div>


                        <label class="control-label col-sm-1">Type</label>
                        <div class="col-sm-3">
                            @Html.DropDownListFor(x => x.INPurchaseRequisition.RequestTypeID, new SelectList(ViewBag.INRequestTypes, "RequestTypeID", "RequestTypeDesc"), "-- Select --", new { @class = "form-control showError ddl", @id = "RequestTypeID" })
                            <span id="spnRequestTypeIDError" class="error" style="display:none;">Please select type</span>
                        </div>
                    </div>


                    <div class="row" style="margin-bottom:10px;">

                        <label for="ToStoreID" class="control-label col-sm-1 ">Document No</label>
                        <div class="col-sm-3">
                            <input class="form-control" readonly value="@Model.INPurchaseRequisition.ProjectDocumentNo" id="ProjectDocumentNo">
                        </div>

                        <label for="ManualDemandNo" class="control-label col-sm-1 ">Manual Demand No</label>
                        <div class="col-sm-3">
                            <input class="form-control integer align-right" value="@Model.INPurchaseRequisition.ManualDemandNo" id="ManualDemandNo">
                        </div>

                    </div>


                    <div class="row" style="margin-bottom:10px;">
                        <label for="mRemarks" class="col-sm-1 control-label ">Remarks</label>
                        <div class="col-sm-7">
                            <input class="form-control" value="@Model.INPurchaseRequisition.Remarks" id="mRemarks">
                            <span id="spnmRemarksError" class="error" style="display:none;">Please enter remarks</span>
                        </div>

                    </div>

                    <div class="row" style="margin-bottom:10px;">
                        <label for="ItemID" class="control-label col-sm-2">Item</label>
                        <div class="col-sm-8">
                            @Html.DropDownList("ItemID", new SelectList(ViewBag.INItems, "ItemID", "Description"), "-- Select --", new { @class = "form-control showError  ddl item-list", @id = "ItemID" })
                        </div>
                    </div>

                    <!-- /.box-body -->
                    <div class="box-footer">
                        @*<a href="/GLINPurchaseRequisition/GLINPurchaseRequisition" class="btn btn-primary">Add</a>*@

                    </div>
                    <!-- /.box-footer -->
                    @*</form>*@

                </div>
            </div>

            <div style="margin-top: 7px;">

                <table class="table table-striped tblDetail" id="tblList">
                    <thead>
                        <tr>


                            <th style="width:50px;text-align:center" class="th"><label>ID</label></th>
                            <th style="text-align:left;"><label>Item</label></th>
                            <th style="width:150px;"><label>Size</label></th>
                            <th style="width:150px;"><label>Unit</label></th>
                            <th style="width:200px;"><label>Remarks</label></th>
                            <th style="width:150px;" class="align-right"><label>Requested</label></th>
                            <th style="width:150px;" class="align-right"><label>Approved</label></th>
                            <th style="width:150px;" class="align-right"><label>In Hand</label></th>
                            <th style="width:150px;" class="align-right"><label>Last Rate</label></th>
                            <th style="width:150px;" class="align-right"><label>Balance</label></th>
                            <th style="width:5px;"></th>
                        </tr>
                    </thead>
                    <tbody id="tbodyList">

                        @if (Model.INPurchaseRequisitionDetailRows != null && Model.INPurchaseRequisitionDetailRows.Count > 0)
                        {
                            int i = 0;
                            foreach (var item in Model.INPurchaseRequisitionDetailRows)
                            {
                                <tr>
                                    <td style="width:50px;text-align:center;">
                                        <input type="hidden" id="RequestDetailID" value="@item.RequestDetailID" />
                                        <input type="hidden" id="RequestID" value="@item.RequestID" />
                                        <input type="hidden" id="ItemID" value="@item.ItemID" />

                                        <input type="hidden" id="CreatedBy" value="@item.CreatedBy" />
                                        <input type="hidden" id="CreatedAt" value="@item.CreatedAt" />
                                        <input type="hidden" id="ModifiedBy" value="@item.ModifiedBy" />
                                        <input type="hidden" id="ModifiedAt" value="@item.ModifiedAt" />
                                        <input type="hidden" id="CompanyID" value="@item.CompanyID" />

                                        <label>@item.RequestDetailID</label>
                                    </td>

                                    <td style="width:300px">
                                        <input type="text" class="itemId" value="@item.ItemID" style="display:none;" />
                                        @Html.DropDownListFor(x => x.INPurchaseRequisitionDetailRows[i].ItemID, new SelectList(ViewBag.INItems, "ItemID", "Description"), "-- Select --", new { @class = "form-control showError  ddl", @id = "ItemID" })
                                    </td>
                                    <td>
                                        <input type="text" readonly id="Size" class="form-control" placeholder="" value="@item.Size" />
                                    </td>

                                    <td>
                                        <input type="text" readonly id="Unit" class="form-control" placeholder="" value="@item.Unit" />
                                    </td>

                                    <td>
                                        <input type="text" id="rem" class="form-control remarks" placeholder="" value="@item.Remarks" />
                                    </td>


                                    <td>
                                        <input type="text" style="text-align:right;" id="RequestedQty" class="form-control decimal" onchange="hidSubmit();" value="@item.RequestedQty" />
                                        <span id="spnRequestedQtyError" class="error" style="display:none;">Required!</span>
                                    </td>

                                    <td>
                                        <input type="text" style="text-align:right;" id="ApprovedQty" class="form-control decimal" onchange="hidSubmit();" value="@item.ApprovedQty" />
                                        <span id="spnApprovedQtyError" class="error" style="display:none;">Approved qty is greater than requested qty</span>
                                    </td>

                                    <td>
                                        <input type="text" style="text-align:right;" id="QtyInHand" readonly class="form-control decimal" value="@item.QtyInHand" />
                                    </td>

                                    <td>
                                        <input type="text" style="text-align:right;" id="LastRate" readonly class="form-control decimal" value="@item.LastRate" />
                                    </td>

                                    <td>
                                        <input type="text" style="text-align:right;" id="Balance" readonly class="form-control decimal" value="@item.Balance" />
                                    </td>
                                    <td>
                                        <button class='btn btn-danger btn-xs delete-row' tabindex="-1"><i class='fa fa-times'></i></button>
                                        @*<button class='btn btn-primary btn-xs add-row' tabindex="-1"><i class='fa fa-times'></i></button>*@
                                    </td>
                                </tr>
                                i = i + 1;
                            }
                        }

                        <tr>
                            <td style="width:50px;text-align:center;">
                                <input type="hidden" id="RequestDetailID" value="" />
                                <input type="hidden" id="RequestID" value="" />
                                <input type="hidden" id="ItemID" value="" />

                                <input type="hidden" id="CreatedBy" value="" />
                                <input type="hidden" id="CreatedAt" value="" />
                                <input type="hidden" id="ModifiedBy" value="" />
                                <input type="hidden" id="ModifiedAt" value="" />
                                <input type="hidden" id="CompanyID" value="" />

                                <input type="hidden" id="Remarks" value="" />

                                <label></label>
                            </td>

                            <td>
                                @Html.DropDownList("ItemID", new SelectList(ViewBag.INItems, "ItemID", "Description"), "-- Select --", new { @class = "form-control showError  ddl", @id = "ItemID" })
                            </td>

                            <td>
                                <input type="text" readonly id="Size" class="form-control" placeholder="" value="" />
                            </td>

                            <td>
                                <input type="text" readonly id="Unit" class="form-control" placeholder="" value="" />
                            </td>

                            <td>
                                <input type="text" id="rem" class="form-control remarks" placeholder="" value="" />
                            </td>


                            <td>
                                <input type="text" style="text-align:right;" id="RequestedQty" class="form-control decimal" onchange="hidSubmit();" value="" />
                                <span id="spnRequestedQtyError" class="error" style="display:none;">Required!</span>
                            </td>

                            <td>
                                <input type="text" style="text-align:right;" id="ApprovedQty" class="form-control decimal" onchange="hidSubmit();" value="" />
                                <span id="spnApprovedQtyError" class="error" style="display:none;">Approved qty is greater than requested qty</span>
                            </td>

                            <td>
                                <input type="text" style="text-align:right;" id="QtyInHand" readonly class="form-control decimal" value="" />
                            </td>

                            <td>
                                <input type="text" style="text-align:right;" id="LastRate" readonly class="form-control decimal" value="" />
                            </td>
                            <td>
                                <input type="text" style="text-align:right;" id="Balance" readonly class="form-control decimal" value="" />
                            </td>

                            <td>
                                <button class='btn btn-danger btn-xs delete-row' tabindex="-1"><i class='fa fa-times'></i></button>
                            </td>
                        </tr>

                    </tbody>
                    <tfoot>

                        @*<tr>
                                <td colspan="3" style="text-align:right;"><label style="font-size:20px;">Total Debit</label></td>
                                <td colspan="2"><input type="text" id="DrTotal" style="font-size:large; font-weight:bold; background-color:white;" class="form-control number decimal" readonly value="0" /></td>
                            </tr>

                            <tr>
                                <td colspan="3" style="text-align:right;"><label style="font-size:20px;">Total Credit</label></td>
                                <td colspan="2"><input type="text" id="CrTotal" style="font-size:large; font-weight:bold;background-color:white;" class="form-control number decimal" readonly value="0" /></td>
                            </tr>

                            <tr>
                                <td colspan="3" style="text-align:right;"><label style="font-size:20px;">Difference</label></td>
                                <td colspan="2"><input type="text" id="DrCrDiff" style="font-size:large; font-weight:bold; background-color:white;" class="form-control number decimal" readonly value="0" /></td>

                            </tr>

                            <tr style="text-align:right">
                                <td colspan="5">
                                    <span id="spnDebitCreditNotEqualError" class="error" style="display:none;">Total debit and total credit are not equal</span>
                                </td>
                            </tr>*@

                    </tfoot>

                </table>

            </div>

            <div class="box-footer">
                <div class="Actions">
                    @*<button class="btn btn-primary" onclick="fullReceived();"><span style="font-weight:bold;">++</span></button>*@
                    <a href="/INInventory/PurchaseRequisitionList" class="btn btn-info ">Back to List</a>
                    <a href="/INInventory/PurchaseRequisition" class="btn btn-primary">Add</a>
                    <a href="#" class="btn btn-default" onclick="location.reload();">Cancel</a>
                    <a href="#" class="btn btn-primary btnSave">Save</a>

                    @if (Model.INPurchaseRequisition.RequestID > 0)
                    {
                        <a href="/ReportsWebForms/ReportForm.aspx?ReportName=INPurchaseRequisitionReportDownload&RequestID=@Model.INPurchaseRequisition.RequestID" class=" btn btn-success" target="_blank"> View Report</a>
                    }

                    @if (Model.RoleID == 4 && Model.INPurchaseRequisition.RequestID > 0)
                    {
                        <a href="#" class="btn btn-success btnSubmit pull-right">Submit</a>
                    }
                    else if (Model.RoleID == 5 && Model.INPurchaseRequisition.SubmitedByKPO.GetValueOrDefault(0) > 0 && Model.INPurchaseRequisition.SubmitedByMD.GetValueOrDefault(0) <= 0)
                    {
                        <a href="#" class="btn btn-success btnSubmit pull-right" id="submit">Submit</a>
                    }

                </div>
            </div>



        </div>
    </div>

</section>
