        function IsValid() {

            var valid = true;
            $(".error").hide();


            if ($("#RequestDate").val() == "") {
                $("#spnRequestDateError").show();
                valid = false;
            }

            if ($("#RequestTypeID").val() == "") {
                $("#spnRequestTypeIDError").show();
                valid = false;
            }

            if ($("#ProjectID").val() == "") {
                $("#spnProjectIDError").show();
                valid = false;
            }


            if ($("#mRemarks").val() == "") {
                $("#spnmRemarksError").show();
                valid = false;
            }

            $("#tbodyList").find('tr').each(function (index, elem) {

                //var ItemID = $("#VoucherTypeID").children("option").filter(":selected").text()
                debugger;
                $(this).find('#Remarks').trigger("change");
                if ($(this).find('.ddl').val() != "" && $(this).find('.ddl').val() > 0) {


                    if (roleId == 4) {
                        if ($(this).find('#RequestedQty').val() == "" || $(this).find('#RequestedQty').val() == "0") {
                            $(this).find('#spnRequestedQtyError').show();
                            valid = false;
                        }
                    }
                    else if (roleId == 5) {

                        if (parseFloat($(this).find('#ApprovedQty').val()) > parseFloat($(this).find('#RequestedQty').val()) ) {
                            $(this).find('#spnApprovedQtyError').show();
                            valid = false;
                        }
                    }
                }
            });

            var rowCount = $("#tbodyList").find('tr').length;
            if (rowCount == 1) {
                alert("Please enter data at least one row");
                valid = false;

            }

            return valid;
        }


