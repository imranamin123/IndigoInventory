@model GL.ViewModels.BS.BSClassificationViewModel


@{
   
}



<style>
    .error {
        color: red;
    }

    .errorDetail {
        border-color: red;
        color: black;
    }
</style>

<section class="content">


    <div class="col-md-12">
        <div class="box box-info">
            <div class="form-horizontal">
                <div class="box-body">
                    <div class="box-header with-border">
                        <h2 class="box-title">Bank Statement Classification </h2>

                        <input type="hidden" id="HCreatedBy" value="@Model.BSClassificationHeader.CreatedBy" />
                        <input type="hidden" id="HCreatedAt" value="@Model.BSClassificationHeader.CreatedAt" />
                        <input type="hidden" id="HModifiedBy" value="@Model.BSClassificationHeader.ModifiedBy" />
                        <input type="hidden" id="HModifiedAt" value="@Model.BSClassificationHeader.ModifiedAt" />
                        <input type="hidden" id="HCompanyID" value="@Model.BSClassificationHeader.CompanyID" />
                        <input type="hidden" id="HBKBankID" value="@Model.BSClassificationHeader.BKBankID" />
                        @*<input type="hidden" id="BSClassificationDate" value="@Model.BSClassificationHeader.BSClassificationDate" />*@
                        <input type="hidden" id="HBSBankStatementBalance" value="@Model.BSClassificationHeader.BSBankStatementBalance" />

                    </div>
                    <br />

                    <div class="row" style="margin-bottom:10px;">
                        <label class="control-label col-sm-1">Transact ID</label>
                        <div class="col-sm-3">
                            <input type="text" class="form-control" readonly id="HTransactionID" value="@Model.BSClassificationHeader.TransactionID" />
                        </div>

                        <label for="TransactionDate" class="control-label col-sm-1 PaddingTop-5">Trans Date</label>
                        <div class="col-sm-3">
                            <div class="input-group ">
                                <div class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </div>
                                <input class="form-control " readonly autocomplete="off" id="HTransactionDate" value="@Model.BSClassificationHeader.TransactionDate.Value.ToString("dd-MMM-yyyy")" />
                            </div>
                        </div>
                        <label for="ValueDate" class="control-label col-sm-1 PaddingTop-5">Value Date</label>
                        <div class="col-sm-3">
                            <div class="input-group ">
                                <div class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </div>
                                <input class="form-control " readonly autocomplete="off" id="HValueDate" value="@Model.BSClassificationHeader.ValueDate.Value.ToString("dd-MMM-yyyy") " />
                            </div>
                        </div>

                    </div>

                    <div class="row" style="margin-bottom:10px;">
                        <label class="control-label col-sm-1">Amount</label>
                        <div class="col-sm-3">
                            <input type="text" class="form-control" readonly id="HAmount" value="@Model.BSClassificationHeader.Amount" />
                        </div>
                        <label class="control-label col-sm-1">Description</label>
                        <div class="col-sm-3">
                            <input type="text" class="form-control" readonly id="HDescription" value="@Model.BSClassificationHeader.Description" />
                        </div>

                        <label class="control-label col-sm-1">Ref No</label>
                        <div class="col-sm-3">
                            <input type="text" class="form-control" readonly id="HTransactionReferenceNo" value="@Model.BSClassificationHeader.TransactionReferenceNo" />
                        </div>

                    </div>


                    <div class="row" style="margin-bottom:10px;">

                        <label class="control-label col-sm-1">Classification ID</label>
                        <div class="col-sm-3">
                            <input type="text" readonly class="form-control" id="HClassificationID" value="@Model.BSClassificationHeader.BSClassificationID" />
                        </div>

                        <label for="TransactionDate" class="control-label col-sm-1 PaddingTop-5">Classification Date</label>
                        <div class="col-sm-3">
                            <div class="input-group date">
                                <div class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </div>
                                <input class="form-control date-picker" autocomplete="off" id="HBSClassificationDate" value="@Model.BSClassificationHeader.BSClassificationDate.Value.ToString("dd-MMM-yyyy")" />
                                <span id="spnBSClassificationDate" class="error" style="display:none;">Please enter classification date</span>
                            </div>
                        </div>
                    </div>


                    <div style="margin-top: 7px;">
                        <div class="col-sm-12" style="overflow:auto;">
                            <table class="table table-striped tblDetail" id="tblList">
                                <thead>
                                    <tr>
                                        <th style="width:100px;text-align:center" class="th"><label>Det ID</label></th>
                                        <th style="text-align:left;"><label>Type</label></th>
                                        <th style="width:200px;" class="align-right"><label>Amount</label></th>
                                        <th style="width:5px;"></th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyList">
                                @{ 
                                    
                                    if (Model.BSClassificationListModel != null && Model.BSClassificationListModel.Count > 0)
                                    {
                                        int i = 0;
                                        foreach (var item in Model.BSClassificationListModel)
                                        {
                                            <tr BSClassificationDetailID="@item.BSClassificationDetailID">
                                                <td style="width:100px;text-align:center;">

                                                    <input type="hidden" id="BSClassificationDetailID" value="@item.BSClassificationDetailID" />
                                                    <input type="hidden" id="BSClassificationID" value="@item.BSClassificationID.GetValueOrDefault(0)" />
                                                    <input type="hidden" id="TransactionID" value="@item.TransactionID.GetValueOrDefault(0)" />

                                                    <input type="hidden" id="CreatedAt" value="@item.CreatedAt.GetValueOrDefault(DateTime.Now)" />
                                                    <input type="hidden" id="CreatedBy" value="@item.CreatedBy.GetValueOrDefault(0)" />
                                                    <input type="hidden" id="ModifiedAt" value="@item.ModifiedAt.GetValueOrDefault(DateTime.Now)" />
                                                    <input type="hidden" id="ModifiedBy" value="@item.ModifiedBy.GetValueOrDefault(0)" />
                                                    <input type="hidden" id="CompanyID" value="@item.CompanyID.GetValueOrDefault(0)" />

                                                    <label>@item.BSClassificationDetailID</label>
                                                </td>

                                                <td style="width:500px;text-align:left;">
                                                    <input type="text" class="glid" value="@item.BSClassificationTypeID" style="display:none;" />
                                                    @Html.DropDownListFor(x => item.BSClassificationTypeID.Value,new SelectList(ViewBag.BSClassificationTypes, "BSClassificationTypeID", "BSClassificationTypeName"),
                                                        "-- Select --", new { @style = "width:500px;", @class = "form-control showError  ddl", @id = "BSClassificationTypeID" })

                                                    <span id="spnClassificationTypeError" class="error" style="display:none;">Please enter classification</span>
                                                </td>
                                                <td style="width:200px;text-align:right;">
                                                    <input type="text" id="Balance" class="form-control number decimal" value="@item.Balance" />
                                                    <span id="spnBalanceError" class="error" style="display:none;">Please enter Balance</span>
                                                </td>

                                                <td>
                                                    <button class='btn btn-danger btn-xs delete-row' tabindex="-1"><i class='fa fa-times'></i></button>

                                                </td>
                                            </tr>
                                            i = i + 1;
                                        }
                                    }
                                    <tr>
                                        <td style="width:100px;text-align:center;">

                                            <input type="hidden" id="BSClassificationDetailID" value="" />
                                            <input type="hidden" id="BSClassificationID" value="" />
                                            <input type="hidden" id="TransactionID" value="" />

                                            <input type="hidden" id="CreatedAt" value="" />
                                            <input type="hidden" id="CreatedBy" value="" />
                                            <input type="hidden" id="ModifiedAt" value="" />
                                            <input type="hidden" id="ModifiedBy" value="" />
                                            <input type="hidden" id="CompanyID" value="" />

                                            <label id="BSClassificationDetailID"></label>
                                        </td>

                                        <td style="width:500px;text-align:left;">

                                            @Html.DropDownList("BSClassificationTypeID", new SelectList(ViewBag.BSClassificationTypes, "BSClassificationTypeID", "BSClassificationTypeName"), "-- Select --", new { @style = "width:500px;", @class = "form-control showError", @id = "BSClassificationTypeID" })
                                            <span id="spnClassificationTypeError" class="error" style="display:none;">Please enter classification</span>
                                        </td>
                                        <td style="width:200px;text-align:right;">
                                            <input type="text" id="Balance" class="form-control number decimal" value="" />
                                            <span id="spnBalanceError" class="error" style="display:none;">Please enter Balance</span>
                                        </td>

                                        <td>
                                            <button class='btn btn-danger btn-xs delete-row' tabindex="-1"><i class='fa fa-times'></i></button>

                                        </td>
                                    </tr>
                                    }
                                </tbody>
                            </table>    `
                        </div>
                    </div>

                </div>
            </div>
            <div class="box-footer">
                <div class="Actions">
                    <a href="/BSBankStatement/BSClassificationList" class="btn btn-info ">Back to List</a>
                    <a href="/BSBankStatement/BSClassification" class="btn btn-primary">Add</a>
                    <a href="#" class="btn btn-default" onclick="location.reload();">Cancel</a>
                    <a href="#" class="btn btn-primary btnSave">Save</a>
                </div>
            </div>



        </div>
    </div>



</section>

<table style="display:none;">

    <tr class="trRowTemplate">
        <td style="width:100px;text-align:center;">
            @*<input type="hidden" id="BSClassificationDetailID" value="" />*@
            <input type="hidden" id="BSClassificationID" value="" />
            <input type="hidden" id="TransactionID" value="" />

            <input type="hidden" id="CreatedAt" value="" />
            <input type="hidden" id="CreatedBy" value="" />
            <input type="hidden" id="ModifiedAt" value="" />
            <input type="hidden" id="ModifiedBy" value="" />
            <input type="hidden" id="CompanyID" value="" />

            <label id="BSClassificationDetailID"></label>
        </td>

        <td style="width:500px;text-align:left;">
            @Html.DropDownList("BSClassificationTypeID", new SelectList(ViewBag.BSClassificationTypes, "BSClassificationTypeID", "BSClassificationTypeName"), "-- Select --", new { @style = "width:500px;", @class = "form-control showError", @id = "BSClassificationTypeID" })
            <span id="spnClassificationTypeError" class="error" style="display:none;">Please enter classification</span>
        </td>
        <td style="width:200px;text-align:right;">
            @{
                decimal credit = Model.BSBankStatement.Credit ?? 0;
                decimal debit = Model.BSBankStatement.Debit ?? 0;
                decimal lamount = credit - debit;
            }
            <input type="text" id="Amount" class="form-control number decimal" value="" />
            <span id="spnCrError" class="error" style="display:none;">Please enter cr</span>
            <span id="spnCreditBothHasValueError" class="error" style="display:none;">Debit and credit can not have value in a single row</span>
        </td>

        <td>
            <button class='btn btn-danger btn-xs delete-row' tabindex="-1"><i class='fa fa-times'></i></button>

        </td>
    </tr>

</table>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script id="GLAccounts">
        $().ready(function () {

            $("#tbodyList tr").each(function () {
                // $(this).find(".ddl").select2();

                var glID = $(this).find(".glid").val();
                $(this).find(".ddl").val(glID).change();
            });

            if ($("#tbodyList tr").length == 1) {
                $("#tbodyList tr").find("#Balance").val($("#Amount").val())
            }

            $(document).on("click", ".delete-row", function () {


                if (confirm("Are you sure you want to delete this row")) {

                    var row = $(this).closest("tr");
                    var BSClassificationDetailID = $(this).closest("tr").attr('BSClassificationDetailID');//.find("#BSClassificationDetailID").val();
                    if (BSClassificationDetailID != "" || $(BSClassificationDetailID).val() > 0) {

                        $.get("/BSBankStatement/BSClassificationDetailDelete", { id: BSClassificationDetailID }).done(function (res) {

                            $(row).remove();
                            calculateTotals();

                        }).fail(function (ex) {

                            alert(ex.responseText);

                        }).always(function () { });

                    }
                    else if (BSClassificationDetailID == "" || BSClassificationDetailID == undefined || $(BSClassificationDetailID).val() == 0) {
                        var totalRows = $("#tbodyList tr").length;
                        if (totalRows > 1) {

                            $(row).remove();
                            calculateTotals();
                            resetSrNo();

                        }
                        else {
                            $(row).remove();
                            calculateTotals();
                        }
                    }
                }
            });

            $(document).on("click", ".btnSave", function (e) {

                e.preventDefault;

                $('.btnSave').attr('disabled', 'disabled');

                if (IsValid() == false) {
                    $('.btnSave').removeAttr('disabled');
                    return;
                }

                

                var obj = getObject();
                var objDetails = getObjectDetails();


                $.post("/BSBankStatement/BSClassificationSave", { BSClassification: obj, BSClassificationDetailList: objDetails }).done(function (res) {

                    if (res.status == true) {
                        alert(res.resMessage);

                        // fillPendingUnpendingList();

                        window.location = "/BSBankStatement/BSClassification?TransactionID=" + res.id;

                    }
                    else {
                        alert(res.resMessage);
                    }

                }).fail(function (ex) {
                    alert(ex.responseText);
                    // ShowAlert('Error', $(jQuery.parseHTML(ex.responseText)).eq(1).text(), true);
                }).always(function () { });


            });



            $(document).on("click", "#btnFillDetails", function () {
                let btn = this;
                //$(this).closest('tr').css('background-color', 'grey');
                $('#tbodyList').html('');

                
                var TransactionID = $(this).closest('tr').attr('TransactionID');

                if (TransactionID != "") {
                    GetBSClassification(TransactionID);
                    $.ajax({
                        url: "/BSBankStatement/GetBSClassificationList",
                        type: "POST",
                        dataType: "json",
                        data: { TransactionID: TransactionID },
                        success: function (res) {
                            
                            //console.log(data);

                            if (res != "" && res.length > 0) {
                                //res = JSON.parse();
                                $(res).each(function (ind, obj) {
                                    var row = $('.trRowTemplate').clone();
                                    $(row).removeClass("trRowTemplate");
                                    $('#tbodyList').append(row);
                                    $(row).attr('BSClassificationDetailID', obj.BSClassificationDetailID);
                                    $(row).find("#BSClassificationDetailID").html(obj.BSClassificationDetailID);
                                    $(row).find("#BSClassificationID").val(obj.BSClassificationID);
                                    $(row).find("#BSClassificationTypeID").val(obj.BSClassificationTypeID);
                                    $(row).find("#TransactionID").val(obj.TransactionID);
                                    $(row).find("#Balance").val(obj.Balance);
                                    $(row).find("#TransactionID").val(obj.TransactionID);
                                    $(row).find("#CreatedAt").val(obj.CreatedAt);
                                    $(row).find("#CreatedBy").val(obj.CreatedBy);
                                    $(row).find("#ModifiedAt").val(obj.ModifiedAt);
                                    $(row).find("#ModifiedBy").val(obj.ModifiedBy);
                                });

                            }
                            else {
                                var amount = $(btn).closest('tr').find('#amount').attr('amount');
                                var row = $('.trRowTemplate').clone();
                                $(row).removeClass("trRowTemplate");
                                $('#tbodyList').append(row);
                                $(row).find("#Balance").val(amount);
                            }
                            var row = $('.trRowTemplate').clone();
                            $(row).removeClass("trRowTemplate");
                            $('#tbodyList').append(row);

                            //$("#BSBankStatementPendingUnpendingList").empty();
                            //$("#BSBankStatementPendingUnpendingList").html(res);




                        },
                        error: function (error) {
                            console.log("Error:");
                            console.log(error);
                        }
                    });

                    //$.post("/BSBankStatement/GetBSClassificationList", { TransactionID: TransactionID }).done(function (res) {

                    //    if (res != "" && res.length > 0) {
                    //        res = JSON.parse();
                    //        $(res).each(function (ind, obj) {
                    //            var row = $('.trRowTemplate').clone();
                    //            $(row).removeClass("trRowTemplate");
                    //            $('#tbodyList').append(row);
                    //            $(row).attr('BSClassificationDetailID', obj.BSClassificationDetailID);
                    //            $(row).find("#BSClassificationDetailID").html(obj.BSClassificationDetailID);
                    //            $(row).find("#BSClassificationID").val(obj.BSClassificationID);
                    //            $(row).find("#BSClassificationTypeID").val(obj.BSClassificationTypeID);

                    //            $(row).find("#Balance").val(obj.Balance);
                    //            $(row).find("#TransactionID").val(obj.TransactionID);
                    //            $(row).find("#CreatedAt").val(obj.CreatedAt);
                    //            $(row).find("#CreatedBy").val(obj.CreatedBy);
                    //            $(row).find("#ModifiedAt").val(obj.ModifiedAt);
                    //            $(row).find("#ModifiedBy").val(obj.ModifiedBy);
                    //        });

                    //    }
                    //    else {
                    //        var amount = $(btn).closest('tr').find('#amount').attr('amount');
                    //        var row = $('.trRowTemplate').clone();
                    //        $(row).removeClass("trRowTemplate");
                    //        $('#tbodyList').append(row);
                    //        $(row).find("#Balance").val(amount);
                    //    }
                    //    var row = $('.trRowTemplate').clone();
                    //    $(row).removeClass("trRowTemplate");
                    //    $('#tbodyList').append(row);

                    //    //$("#BSBankStatementPendingUnpendingList").empty();
                    //    //$("#BSBankStatementPendingUnpendingList").html(res);

                    //}).fail(function (ex) {

                    //    alert(ex.responseText);

                    //}).always(function () {
                    //});
                }

                //fillPendingUnpendingList();
            });

            $(document).on("change", "#BSClassificationTypeID", function () {
                
                var currentRow = $(this).closest("tr");
                var totalRows = $("tr", "#tbodyList").length;
                var currentRowIndex = currentRow.index();
                var diff = totalRows - currentRowIndex;

                if (diff == 1) {
                    var row = $('.trRowTemplate').clone();
                    $(row).removeClass("trRowTemplate");
                    // resetSrNo();

                    $('#tbodyList').append(row);

                }
            });

        });



        function GetBSClassification(TransactionID) {
            if (TransactionID != "") {

                $.post("/BSBankStatement/GetBSClassification", { TransactionID: TransactionID }).done(function (res) {

                    if (res != "" && res.length > 0) {
                        res = JSON.parse(res);
                        $(res).each(function (ind, obj) {

                            objBSClassification.TransactionID = obj.TransactionID;
                            objBSClassification.BKBankID = obj.BKBankID;
                            objBSClassification.ValueDate = obj.ValueDate;
                            objBSClassification.BSClassificationID = obj.BSClassificationID;
                            objBSClassification.BSClassificationDate = obj.BSClassificationDate;
                            objBSClassification.BSBankStatementBalance = obj.BSBankStatementBalance;
                            objBSClassification.CreatedAt = obj.CreatedAt;
                            objBSClassification.CreatedBy = obj.CreatedBy;
                            objBSClassification.ModifiedAt = obj.ModifiedAt;
                            objBSClassification.ModifiedBy = obj.ModifiedBy;
                            objBSClassification.CompanyID = obj.CompanyID;
                        });

                    }

                }).fail(function (ex) {
                    alert(ex.responseText);
                }).always(function () {
                });

            }
        }

        function fillPendingUnpendingList() {

            var BkBankID = $("#BkBankID").val();
            var IsPending = $("#IsPending").prop('checked');
            var ValueDateFrom = $("#ValueDateFrom").val();
            var ValueDateTo = $("#ValueDateTo").val();



            if (BkBankID != "") {

                $.get("/BSBankStatement/BSBankStatementPendingUnpendingSearchList", { BkBankID: BkBankID, IsPending: IsPending, ValueDateFrom: ValueDateFrom, ValueDateTo: ValueDateTo }).done(function (res) {

                    $("#BSBankStatementPendingUnpendingList").empty();
                    $("#BSBankStatementPendingUnpendingList").html(res);

                }).fail(function (ex) {

                    alert(ex.responseText);

                }).always(function () {
                });
            }
        }

        function fillClassificationDetailList(obj) {

            var TransactionID = $(obj).closest('tr').find('#TransactionID').html();



            if (TransactionID != "") {

                $.post("/BSBankStatement/GetBSClassificationList", { TransactionID: TransactionID }).done(function (res) {
                    if (res != "") {

                        $(res.Results).each(function (ind, val) {

                            console.log(val);
                        });

                    }
                    //$("#BSBankStatementPendingUnpendingList").empty();
                    //$("#BSBankStatementPendingUnpendingList").html(res);

                }).fail(function (ex) {

                    alert(ex.responseText);

                }).always(function () {
                });
            }
        }

        function calculateTotals() {

            var DrSum = 0;
            var CrSum = 0;

            $("#tbodyList").find('tr').each(function (index, elem) {

                if ($(this).find('#BankTransDetID').val() != "" && $(this).find('#BankTransDetID').val() > 0) {


                    var Dr = $(this).find('#Dr').val() == '' ? 0 : parseFloat($(this).find('#Dr').val());
                    var Cr = $(this).find('#Cr').val() == '' ? 0 : parseFloat($(this).find('#Cr').val());

                    DrSum += parseFloat(Dr);
                    CrSum += parseFloat(Cr);

                }
            });

            $("#DrTotal").val(DrSum);
            $("#CrTotal").val(CrSum);
            var DrCrDiff = DrSum - CrSum;
            $("#DrCrDiff").val(DrCrDiff);
        }

        function IsBankTransExist() {



            var CompanyID = $("#CompanyID").val();
            var BankID = $("#BankID").val();
            var TransDate = $("#TransDate").val();
            var BankTransID = $("#BankTransID ").val();


            if (CompanyID != "" && BankID != "" && TransDate != "") {
                $.post("/BKBanKTrans/IsBKBankTranExist", { CompanyID: CompanyID, BankID: BankID, TransDate: TransDate }).done(function (res) {

                    if (res != null && res.id > 0)
                        alert("Transactions already exists for this bank in this date");
                }).fail(function (ex) {

                    alert(ex.responseText);

                }).always(function () {
                });
            }

        }

        function IsValid() {

            var valid = true;
            $(".error").hide();


            if ($("#HBSClassificationDate").val() == "") {
                $("#spnBSClassificationDate").show();
                valid = false;
            }


            var drSum = 0;
            var crSum = 0;

            $("#tbodyList").find('tr').each(function (index, elem) {

                if ($(this).find('#BSClassificationTypeID').val() != "" && $(this).find('#BSClassificationTypeID').val() > 0) {


                    //if ($(this).find('#BSClassificationTypeID').val() == "") {
                    //    $(this).find('#spnClassificationTypeError').show();
                    //    valid = false;
                    //}

                    if ($(this).find('#Balance').val() == "") {
                        $(this).find('#spnBalanceError').show();
                        valid = false;
                    }

                }
            });

            // empty detail check
            if (valid == true && $("#tbodyList tr").length == 1) {
                valid = false;
                alert("Please enter a row in detail");
            }

            return valid;
        }

        var objBSClassification = {
            BSClassificationID: '',
            BKBankID: '',
            TransactionID: '',
            ValueDate: '',
            BSClassificationDate: '',
            BSBankStatementBalance: '',

            // hidden fields
            CompanyID: '',
            CreatedBy: '',
            CreatedAt: '',
            ModifiedBy: '',
            ModifiedAt: ''

        }

        function getObject() {
            var obj = {
                BSClassificationID: $("#HClassificationID").val(),
                BKBankID: $("#HBKBankID").val(),
                TransactionID: $("#HTransactionID").val(),
                ValueDate: $("#HValueDate").val(),
                BSClassificationDate: $("#HBSClassificationDate").val(),
                BSBankStatementBalance: $("#HBSBankStatementBalance").val(),

                // hidden fields
                CreatedBy: $("#HCreatedBy").val(),
                CreatedAt: $("#HCreatedAt").val(),
                ModifiedBy: $("#HModifiedBy").val(),
                ModifiedAt: $("#HModifiedAt").val(),
                CompanyID: $("#HCompanyID").val()

            }
            return obj;
        }

        function getObjectDetails() {
            var DetailRows = [];



            $("#tbodyList").find('tr').each(function (index, elem) {

                if ($(this).find('#BSClassificationTypeID').val() != "" && $(this).find('#BSClassificationTypeID').val() > 0) {
                    var DetailRow = {
                        BSClassificationDetailID: $(this).attr('BSClassificationDetailID'),
                        BSClassificationID: $(this).find('#BSClassificationID').val(),
                        BSClassificationTypeID: $(this).find('#BSClassificationTypeID').val(),
                        TransactionID: $("#HTransactionID").val(),
                        Balance: $(this).find('#Balance').val(),

                        //hidden fields
                        CompanyID: $(this).find('#CompanyID').val(),
                        CreatedBy: $(this).find('#CreatedBy').val(),
                        CreatedAt: $(this).find('#CreatedAt').val(),
                        ModifiedBy: $(this).find('#ModifiedBy').val(),
                        ModifiedAt: $(this).find('#ModifiedAt').val()
                    }
                    DetailRows.push(DetailRow);
                }
            });

            return DetailRows;
        }


    </script>

}

