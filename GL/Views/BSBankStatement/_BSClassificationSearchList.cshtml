@model GL.ViewModels.BS.BSClassificationViewModel
@{
    Layout = null;
}

<div class="box box-info">
    <div class="box-body">
        <div class="col-sm-12" style="overflow:auto;">

            <p>
                @*@Html.ActionLink("Create New", "Student")*@
                @*<a href="/Setup/StaffAdd" class="btn btn-primary">Add</a>*@
            </p>
            <table class="table" id="tblList">
                <thead>
                    <tr>
                        <th>
                            <label>ID</label>
                        </th>
                        <th>
                            <label>Bank</label>
                        </th>

                        <th>
                            <label>Date</label>
                        </th>

                        <th>
                            <label>Balance</label>
                        </th>

                        <th></th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in Model.BSClassificationSearchList)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.BankID)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.BankName)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.BSClassificationDate)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.BSBankStatementBalance)
                            </td>

                            <td>
                                <a href="/BSBankStatement/BSClassification?BSClassificationID=@item.BSClassificationID" class="btn btn-primary btn-xs"><i class="fa fa-edit"></i></a>
                                <a href="/BSBankStatement/BKBankTranDelete?BKBankTranID=@item.BankID" class="btn btn-danger btn-xs" onclick="return confirm('Are you sure you want to delete this record ?');"><i class="fa fa-times"></i></a>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>
@*</div>*@

<script>
    $().ready(function () {
        $('#tblList').DataTable({
            'paging': true,
            'lengthChange': true,
            'searching': true,
            'ordering': true,
            'info': true,
            'autoWidth': true
        });

    });
</script>