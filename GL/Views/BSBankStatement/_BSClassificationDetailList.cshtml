@model GL.ViewModels.BS.BSClassificationViewModel
@{
    Layout = null;
}

<div class="box box-info">
    <div class="box-body">
        <div class="col-sm-12" style="overflow:auto;">

            <p>
                @*@Html.ActionLink("Create New", "Student")*@
                @*<a href="/Setup/StaffAdd" class="btn btn-primary">Add</a>*@
            </p>
            <table class="table" id="tblList">
                <thead>
                    <tr>
                        <th>
                            <label>Trans ID</label>
                        </th>
                        <th>
                            <label>Trans Date</label>
                        </th>
                        <th>
                            <label>Value Date</label>
                        </th>
                        <th>
                            <label>Trans Reference No</label>
                        </th>
                        <th>
                            <label>Debit</label>
                        </th>
                        <th>
                            <label>Credit</label>
                        </th>
                        <th>
                            <label>Balance</label>
                        </th>

                        <th></th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in Model.BSBankStatementPendingUnpendingList)
                    {
                        <tr>
                            <td>
                                123
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.BSBankStatementDate)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.BSValueDate)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.BSTransactionReferenceNo)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Debit)
                            </td>                                                       
                            <td>
                                @Html.DisplayFor(modelItem => item.Credit)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Balance)
                            </td>
                            <td>
                                <a href="/BSBankStatement/BSClassification?BSClassificationID=@item.StatementID" class="btn btn-primary btn-xs"><i class="fa fa-download"></i></a>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>
@*</div>*@

<script>
    $().ready(function () {
        $('#tblList').DataTable({
            'paging': true,
            'lengthChange': true,
            'searching': true,
            'ordering': true,
            'info': true,
            'autoWidth': true
        });

    });
</script>