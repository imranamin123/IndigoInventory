@model GL.ViewModels.AP.APInvoiceViewModel

@{

    ViewBag.Title = "Invoice List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<!-- Main content -->
<section class="content">
    <div class="row">

        <div class="col-md-12">
            <div class="box box-info">
                <div class="form-horizontal">
                    <div class="box-body">
                        <div class="box-header with-border">
                            <h2 class="box-title">AP Invoices List</h2>
                        </div>
                        <br />
                        <div class="row" style="display:none; margin-bottom:10px;">
                            <label for="UserID" class="col-sm-1 control-label ">ID</label>
                            <div class="col-sm-1">
                                <input class="form-control integer" id="UserID">
                            </div>
                            <label for="VoucherTypeID" class="control-label col-sm-1 PaddingTop-5">Voucher Type</label>
                            @*<div class="col-sm-2">
                                @Html.DropDownList("VoucherTypeID", new SelectList(ViewBag.VoucherTypes, "VoucherTypeID", "VTYPE"), "-- Select --", new { @class = "form-control showError", @id = "StatusTypeID" })
                            </div>*@
                            @*<label for="CompanyID" class="control-label col-sm-1 PaddingTop-5">Company</label>
                                <div class="col-sm-4">
                                    @Html.DropDownList("CompanyID", new SelectList(ViewBag.CompanyList, "CompanyID", "Name"), "-- Select --", new { @class = "form-control showError", @id = "CompanyID" })
                                </div>*@

                        </div>

                        @*<div class="row">
                                <label for="UserName" class="col-sm-1 control-label">Username</label>
                                <div class="col-sm-4">
                                    <input class="form-control" id="UserName">
                                </div>
                                <label for="Name" class="col-sm-1 control-label">Name</label>
                                <div class="col-sm-4">
                                    <input class="form-control" id="Name">
                                </div>

                            </div>*@


                        <!-- /.box-body -->
                        <div class="box-footer">
                            <a href="/APInvoice/APInvoice" class="btn btn-primary">Add</a>
                            <button class="btn btn-info pull-right" onclick="search()">Search</button>
                        </div>
                        <!-- /.box-footer -->
                        @*</form>*@

                    </div>
                </div>

            </div>
        </div>
    </div>


    <div class="row">
        <div id="ListRows">
        </div>

    </div>
</section>
@*<link rel="stylesheet" href="//cdn.datatables.net/1.10.20/css/jquery.dataTables.min.css">*@

@section scripts{

    <script class="SecUserList">

        function getSearchObject() {

            var obj = {
                GLVoucherID: $("#GLVoucherID").val(),
               // CompanyID: $("#CompanyID").val(),
                VoucherTypeID: $("#VoucherTypeID").val(),
            //    Name: $("#Name").val(),
            //    StatusTypeID: $("#StatusTypeID").val(),
            };
            return obj;
        }

        function search() {

            //var obj = getSearchObject();
            $.post("/APInvoice/APInvoiceSearchList", { }).done(function (res) {

                $("#ListRows").empty();
                $("#ListRows").html(res);

            }).fail(function (ex) {
                alert(ex.responseText);
            }).always(function () { });

        }


    </script>
}



