        <td>@Html.DropDownList("BankTransTypeID", new SelectList(ViewBag.BKBankTransTypes, "BankTransTypeID", "BankTransTypeName"), "-- Select --", new { @style = "width:133px;", @class = "form-control showError", @id = "BankTransTypeID" })</td>

        <td>

