@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
<script id="GLAccounts">
        $().ready(function () {
            $(this).find(".mddl").select2();

            $('#TransDate').datepicker({
                autoclose: true,
                orientation: "bottom auto",  // Forces the datepicker to open downward
                format: 'dd-M-yyyy',
            });


            calculateTotals();

            var enablePost = 0;

            $("#tbodyList tr").each(function () {
                $(this).find(".ddl").select2();
                var BankTransTypeID = $(this).find(".BankTransTypeID").val();
                $(this).find(".ddl").val(BankTransTypeID).change();
                $(this).find(".ddl").trigger("change");


                var APVendorID = $(this).find(".APVendorID").val();
                $(this).find(".ven").val(APVendorID).change();
                $(this).find(".ven").trigger("change");
                $(this).find(".ven").select2();

                

                var IsPost = $(this).find(".IsPost").val();
                if (IsPost == "") IsPost = 0;
                if (IsPost == 1) enablePost += 1;

                $(this).find(".ddlIsPost").val(IsPost).change();
                $(this).find(".ddlIsPost").trigger("change");

            });
            if (enablePost > 0)
                $('#btnPost').show();
            else
                $('#btnPost').hide();




            $(document).on("click", ".delete-row", function () {


                if (confirm("Are you sure you want to delete this row")) {
                    var row = $(this).closest("tr");
                    var BankTransDetID = $(this).closest("tr").find("#BankTransDetID").val();
                    if (BankTransDetID != "" || $(BankTransDetID).val() > 0) {

                        $.get("/BKBankTrans/BKBankTransDetailDelete", { id: BankTransDetID }).done(function (res) {

                            $(row).remove();
                            calculateTotals();

                        }).fail(function (ex) {

                            alert(ex.responseText);

                        }).always(function () { });

                    }
                    else {
                        $(row).remove();
                        calculateTotals();
                    }
                }
            });

            $(document).on("click", ".btnSave", function (e) {

                e.preventDefault;

                $('.btnSave').attr('disabled', 'disabled');

                if (IsValid() == false) {
                    $('.btnSave').removeAttr('disabled');
                    alert("Please correct the error");
                    return;
                }


                

                var objBKBankTrans = getObject();
                var objBKBankTransDetails = getObjectDetails();

                // check if band exist
                var CompanyID = $("#CompanyID").val();
                var BankID = $("#BankID").val();
                var TransDate = $("#TransDate").val();
                var BankTransID = $("#BankTransID ").val();


                if (CompanyID != "" && BankID != "" && TransDate != "") {
                    $.post("/BKBanKTrans/IsBKBankTranExist", { CompanyID: CompanyID, BankTransID: BankTransID, BankID: BankID, TransDate: TransDate }).done(function (res) {

                        if (res != null && res.id > 0) {
                            alert("Transactions already exists for this bank in this date");
                            $('.btnSave').removeAttr('disabled');
                        }
                        else {
                            


                            $.post("/BKBankTrans/BKBankTranSave", { BKBankTrans: objBKBankTrans, BKBankTransDetailList: objBKBankTransDetails }).done(function (res) {

                                if (res.status == true) {
                                    alert(res.resMessage);



                                    window.location = "/BKBankTrans/BKBankTran?BKBankTranID=" + res.id;

                                }
                                else {
                                    alert(res.resMessage);
                                }

                            }).fail(function (ex) {
                                alert(ex.responseText);
                                // ShowAlert('Error', $(jQuery.parseHTML(ex.responseText)).eq(1).text(), true);
                            }).always(function () { });



                        }
                    }).fail(function (ex) {

                        alert(ex.responseText);

                    }).always(function () {
                    });
                }

            });


            $(document).on("change", "#BankTransTypeID", function () {

                var BankTransTypeID = $(this).children("option").filter(":selected").val();
                var TransDescription = $(this).closest("tr").find("#TransDescription");
                $(this).closest("tr").find("#BankTransTypeID").val(BankTransTypeID);
                var currentRow = $(this).closest("tr");
                $.get("/BKBankTrans/GetBankTransTypeDescription", { id: BankTransTypeID }).done(function (res) {
                    if (res != "") {

                        $(TransDescription).val(res);
                        var totalRows = $("tr", "#tbodyList").length;
                        var currentRowIndex = currentRow.index();
                        var diff = totalRows - currentRowIndex;
                        if (diff == 1) {
                            var row = $('.trRowTemplate').clone();
                            $(row).removeClass("trRowTemplate");
                            $('#tbodyList').append(row);
                            $(row).find("#BankTransTypeID").select2();
                            //$(this).find(".select2-selection.select2-selection--single").css("width", "100px");
                            //$(this).find(".select2.select2-container.select2-container--default").css("width", "100px");
                            $(this).find(".select2.select2-container").css("min-width", "100px");
                            $(this).find(".select2.select2-container").css("max-width", "100px");
                            $(this).find(".select2-selection.select2-selection--single").css("padding-top", "2px");
                            $(this).find(".select2-selection.select2-selection--single").css("padding-left", "1px");


                        }
                    }

                }).fail(function (ex) {

                    alert(ex.responseText);

                }).always(function () {
                    //
                    //var totalRows = $("tr", "#tbodyList").length;
                    //var index = $(this).closest("tr").index();
                    //var row = $('.trRowTemplate').clone();
                    //$(row).removeClass("trRowTemplate");
                    //$('#tbodyList').append(row);

                });
            });

            $(document).on("change", "#VoucherDate", function () {

                //var GLAccountID = $(this).children("option").filter(":selected").val();
                //var description = $(this).closest("tr").find("#Description");
                var VoucherDate = $("#VoucherDate").val();

                $.get("/GLVoucher/GetFiscalYearSetup", { VoucherDate: VoucherDate }).done(function (res) {
                    if (res != "")
                        $(FiscalYear).val(res);
                    else
                        alert("Fiscal period does not exists against this date");

                }).fail(function (ex) {

                    alert(ex.responseText);

                }).always(function () {
                });
            });


            $(document).on("change", "#CompanyID", function () {
                IsBankTransExist();
            });

            $(document).on("change", "#BankID", function () {
                IsBankTransExist();
            });

            $(document).on("change", "#TransDate", function () {
                IsBankTransExist();
            });

        });

        function calculateTotals() {

            var DrSum = 0;
            var CrSum = 0;

            $("#tbodyList").find('tr').each(function (index, elem) {

                if ($(this).find('#BankTransDetID').val() != "" && $(this).find('#BankTransDetID').val() > 0) {


                    var Dr = $(this).find('#Dr').val() == '' ? 0 : parseFloat($(this).find('#Dr').val());
                    var Cr = $(this).find('#Cr').val() == '' ? 0 : parseFloat($(this).find('#Cr').val());

                    DrSum += parseFloat(Dr);
                    CrSum += parseFloat(Cr);

                }
            });

            $("#DrTotal").val(DrSum);
            $("#CrTotal").val(CrSum);
            var DrCrDiff = DrSum - CrSum;
            $("#DrCrDiff").val(DrCrDiff);
        }

        function IsBankTransExist() {



            var CompanyID = $("#CompanyID").val();
            var BankID = $("#BankID").val();
            var TransDate = $("#TransDate").val();
            var BankTransID = $("#BankTransID ").val();


            if (CompanyID != "" && BankID != "" && TransDate != "") {
                $.post("/BKBanKTrans/IsBKBankTranExist", { CompanyID: CompanyID, BankTransID: BankTransID, BankID: BankID, TransDate: TransDate }).done(function (res) {

                    if (res != null && res.id > 0)
                        alert("Transactions already exists for this bank in this date");
                }).fail(function (ex) {

                    alert(ex.responseText);

                }).always(function () {
                });
            }

        }

        function IsValid() {

            var valid = true;
            $(".error").hide();


            if ($("#CompanyID").val() == "") {
                $("#spnCompanyIDError").show();
                valid = false;
            }

            if ($("#BankID").val() == "") {
                $("#spnBankIDError").show();
                valid = false;
            }

            if ($("#TransDate").val() == "") {
                $("#spnTransDateError").show();
                valid = false;
            }


            var drSum = 0;
            var crSum = 0;

            $("#tbodyList").find('tr').each(function (index, elem) {

                if ($(this).find('#BankTransTypeID').val() != "" && $(this).find('#BankTransTypeID').val() > 0) {


                    if ($(this).find('#DocumentRef').val() == "") {
                        $(this).find('#spnDocumentRefError').show();
                        valid = false;
                    }

                    var Dr = $(this).find('#Dr').val() == '' ? 0 : parseFloat($(this).find('#Dr').val());
                    var Cr = $(this).find('#Cr').val() == '' ? 0 : parseFloat($(this).find('#Cr').val());

                    drSum += parseFloat(Dr);
                    crSum += parseFloat(Cr);

                    $(this).find('#Cr').val(Cr);
                    $(this).find('#Cr').val(Cr);


                    if (Dr == 0 && Cr == 0) {
                        $(this).find('#spnDrError').show();
                        $(this).find('#spnCrError').show();
                        valid = false;
                    }

                    if (Dr != 0 && Cr != 0) {
                        $(this).find('#spnCrBothHasValueError').show();
                        valid = false;
                    }

                }
            });

            //if (drSum != crSum) {
            //    $("#spnDebitCreditNotEqualError").show();
            //    valid = false;
            //}
            //else {
            //    $("#spnDebitCreditNotEqualError").hide();
            //}
            ////});

            // empty detail check
            if (valid == true && $("#tbodyList tr").length == 1)
            {
                valid = false;
                alert("Please enter a row in detail");
            }

            return valid;
        }


