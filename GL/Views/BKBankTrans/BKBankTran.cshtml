@model GL.ViewModels.BKBankTrans.BKBankTransViewModel

@{
    //Model.feeReceipt.SessionID=0;
    List<GL.EF.GLAccount> gl = ViewBag.GLAccounts;
}



<style>
    .error {
        color: red;
    }

    .errorDetail {
        border-color: red;
        color: black;
    }
</style>

<section class="container-fluid">


    <div  >
        <div class="box box-info" style="width: 100%; overflow-x: scroll;">
            <div class="form-horizontal">
                <div class="box-body">
                    <div class="box-header with-border">
                        <h2 class="box-title">Bank Transaction </h2>
                        
                        @if (Model.BKBankTran.IsPosted == true)
                        {
                            <br /><br />
                            <h4 style="color:red;" class="box-title">Posted </h4>
                        }

                        <input type="hidden" id="MCreatedBy" value="@Model.BKBankTran.CreatedBy" />
                        <input type="hidden" id="MCreatedAt" value="@Model.BKBankTran.CreatedAt" />
                        <input type="hidden" id="MModifiedBy" value="@Model.BKBankTran.ModifiedBy" />
                        <input type="hidden" id="MModifiedAt" value="@Model.BKBankTran.ModifiedAt" />
                        <input type="hidden" id="MCompanyID" value="@Model.BKBankTran.CompanyID" />
                        @*<input type="hidden" id="MIsPosted" value="@Model.BKBankTran.IsPosted" />*@
                        @Html.Hidden("MIsPosted",Model.BKBankTran.IsPosted)

                    </div>
                    <br />
                    <div class="row" style="margin-bottom:10px;">
                        <label for="BankTransID" class="col-sm-1 control-label ">ID</label>
                        <div class="col-sm-4">
                            <input class="form-control integer" readonly value="@Model.BKBankTran.BankTransID" id="BankTransID">

                        </div>

                    </div>
                    <div class="row" style="margin-bottom:10px;">
                        <label for="CompanyID" class="control-label col-sm-1 ">Company</label>
                        <div class="col-sm-4">
                            @Html.DropDownListFor(x => x.BKBankTran.CompanyID, new SelectList(ViewBag.Companies, "CompanyID", "Name"), "-- Select --", new { @class = "form-control showError mddl", @id = "CompanyID" })
                            <span id="spnCompanyIDError" class="error" style="display:none;">Please select a company</span>
                        </div>

                        <label class="control-label col-sm-1">Bank</label>
                        <div class="col-sm-4">
                            @Html.DropDownListFor(x => x.BKBankTran.BankID, new SelectList(ViewBag.Banks, "BankID", "BankName"), "-- Select --", new { @class = "form-control showError mddl", @id = "BankID" })
                            <span id="spnBankIDError" class="error" style="display:none;">Please select a bank</span>
                        </div>
                    </div>

                    <div class="row">
                        <label class="control-label col-sm-1">Trans Code</label>
                        <div class="col-sm-4">
                            @*@Html.DropDownListFor(x => x.BKBankTran.BankTransCode, new SelectList(ViewBag.Banks, "BankID", "BankName"), "-- Select --", new { @class = "form-control showError", @id = "BankID" })*@
                            <input type="text" readonly class="form-control" id="BankTransCode" value="@Model.BKBankTran.BankTransCode" />
                            @*<span id="spnBankIDError" class="error" style="display:none;">Please select a bank</span>*@
                        </div>

                        <label for="TransDate" class="control-label col-sm-1 PaddingTop-5">Date</label>
                        <div class="col-sm-4">
                            <div class="input-group ">
                                <div class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </div>
                                <input class="form-control date-picker" autocomplete="off" id="TransDate" value="@Model.BKBankTran.TransDate.Value.ToString("dd-MMM-yyyy")" />
                            </div>
                            <span id="spnTransDateError" class="error" style="display:none;">Please select date</span>
                        </div>


                    </div>


                    <!-- /.box-body -->
                    <div class="box-footer">
                        @*<a href="/GLVoucher/GLVoucher" class="btn btn-primary">Add</a>*@

                    </div>
                    <!-- /.box-footer -->
                    @*</form>*@

                </div>
            </div>

            <div style="margin-top: 7px;">

                <table class="table table-striped tblDetail" id="tblList">
                    <thead>
                        <tr>


                            <th style="width:50px;text-align:center" class="th"><label>ID</label></th>
                            <th style="width:100px;text-align:left;"><label>Trans Type</label></th>
                            @*<th style="width: 150px;text-align: left;"><label>Desciption</label></th>*@
                            <th style="width: 150px;text-align: left;"><label>Vendor</label></th>
                            <th style="width: 100px;text-align: left;"><label>Post</label></th>
                            <th style="width: 670px; text-align: left;"><label>Document Ref</label></th>

                            <th style="width:40px;" class="align-right"><label>A1</label></th>
                            <th style="width:40px;" class="align-right"><label>A2</label></th>
                            <th style="width:40px;" class="align-right"><label>A3</label></th>

                            <th style="width:150px; text-align:right;" class="align-right"><label>Dr</label></th>
                            <th style="width: 150px; text-align: right;" class="align-right"><label>Cr</label></th>
                            <th style="width:5px;"></th>
                        </tr>
                    </thead>
                    <tbody id="tbodyList">

                        @if (Model.GLBKBankTransDetailRows != null && Model.GLBKBankTransDetailRows.Count > 0)
                        {
                            int i = 0;
                            foreach (var item in Model.GLBKBankTransDetailRows)
                            {
                                <tr>
                                    <td style="width:50px;text-align:center;">
                                        <input type="hidden" id="BankTransDetID" value="@item.BankTransDetID" />
                                        <input type="hidden" id="BankTransID" value="@item.BankTransID" />
                                        <input type="hidden" id="CreatedBy" value="@item.CreatedBy" />
                                        <input type="hidden" id="CreatedAt" value="@item.CreatedAt" />
                                        <input type="hidden" id="ModifiedBy" value="@item.ModifiedBy" />
                                        <input type="hidden" id="ModifiedAt" value="@item.ModifiedAt" />
                                        <input type="hidden" id="CompanyID" value="@item.CompanyID" />

                                        <label>@item.BankTransDetID</label>
                                    </td>

                                    <td style="width:100px;">
                                        <input type="text" class="BankTransTypeID" value="@item.BankTransTypeID" style="display:none;" />
                                        @Html.DropDownListFor(x => x.GLBKBankTransDetailRows[i].BankTransTypeID, new SelectList(ViewBag.BKBankTransTypes, "BankTransTypeID", "BankTransTypeName"), "-- Select --", new { @style = "width:133px;padding-top:2px;padding-left:1px;", @class = "form-control showError  ddl", @id = "BankTransTypeID" })
                                    </td>

                                    <td>
                                        <input type="text" class="APVendorID" value="@item.APVendorID" style="display:none;" />
                                        @Html.DropDownList("APVendorID", new SelectList(ViewBag.APVendors, "APVendorID", "DisplayText"), "-- Select --", new { @style="width:133px", @class = "form-control showError ven", @id = "APVendorID" })
                                    </td>
                                    <td>
                                        <input type="text" class="IsPost" value="@item.IsPost" style="display:none;" />
                                        @Html.DropDownListFor(x => x.GLBKBankTransDetailRows[i].IsPost, new SelectList(ViewBag.IsPost, "Value", "Text"), "-- Select --", new { @style = "width:133px;padding-top:2px;padding-left:1px;", @class = "form-control showError ddlIsPost", @id = "IsPost" })

                                    </td>
                                    <td>
                                        <input type="text" style=" text-align:left;" id="DocumentRef" class="form-control " value="@item.DocumentRef" />
                                        <span id="spnDocumentRefError" class="error" style="display:none;">Please enter document ref</span>
                                    </td>
                                    <td>
                                        <input type="text" style="text-align: center; width: 50px; " maxlength="2" id="A1" class="form-control integer" value="@item.A1" />

                                    </td>
                                    <td>
                                        <input type="text" style="text-align: center; width: 50px;" maxlength="2" id="A2" class="form-control integer" value="@item.A2" />

                                    </td>
                                    <td>
                                        <input type="text" style="text-align: center; width: 50px;" maxlength="2" id="A3" class="form-control integer" value="@item.A3" />

                                    </td>
                                    <td>
                                        <input type="text" id="Dr" onblur="calculateTotals()" class="form-control number decimal" value="@item.Dr" />
                                        <span id="spnDrError" class="error" style="display:none;">Please enter dr</span>

                                    </td>
                                    <td>
                                        <input type="text" id="Cr" onblur="calculateTotals()" class="form-control number decimal" value="@item.Cr" />
                                        <span id="spnCrError" class="error" style="display:none;">Please enter Cr</span>
                                        <span id="spnCrBothHasValueError" class="error" style="display:none;">Debit and credit can not have value in a single row</span>
                                    </td>

                                    <td>
                                        <button class='btn btn-danger btn-xs delete-row' tabindex="-1"><i class='fa fa-times'></i></button>
                                        @*<button class='btn btn-primary btn-xs add-row' tabindex="-1"><i class='fa fa-times'></i></button>*@
                                    </td>
                                </tr>
                                i = i + 1;
                            }
                        }

                    <tr>
                        <td style="width:50px;text-align:center;">
                            <input type="hidden" id="BankTransDetID" value="" />
                            <input type="hidden" id="BankTransID" value="" />
                            <input type="hidden" id="CreatedBy" value="" />
                            <input type="hidden" id="CreatedAt" value="" />
                            <input type="hidden" id="ModifiedBy" value="" />
                            <input type="hidden" id="ModifiedAt" value="" />
                            <input type="hidden" id="CompanyID" value="" />

                            <label></label>
                        </td>

                        <td style="width:100px;">
                            @Html.DropDownList("BankTransTypeID", new SelectList(ViewBag.BKBankTransTypes, "BankTransTypeID", "BankTransTypeName"), "-- Select --", new { @style = "width:133px;", @class = "form-control showError ddl", @id = "BankTransTypeID" })
                        </td>
                        <td>
                            @*<input type="text" style="text-align:left;" readonly id="TransDescription" class="form-control" value="" />*@
                            @Html.DropDownList("APVendorID", new SelectList(ViewBag.APVendors, "APVendorID", "DisplayText"), "-- Select --", new { @class = "form-control showError ven", @id = "APVendorID" })
                        </td>
                        <td>
                            <input type="text" class="IsPost" value="" style="display:none;" />
                            @Html.DropDownList("IsPost", new SelectList(ViewBag.IsPost, "Value", "Text"), "-- Select --", new { @style = "width:133px;padding-top:2px;padding-left:1px;", @class = "form-control showError ", @id = "IsPost" })
                        </td>

                        <td>
                            <input type="text" style="text-align: left;" id="DocumentRef" class="form-control " value="" />
                            <span id="spnDocumentRefError" class="error" style="display:none;">Please enter document ref</span>
                        </td>
                        <td>
                            <input type="text" style="text-align: center; width: 50px;" maxlength="2" id="A1" class="form-control integer" value="" />

                        </td>
                        <td>
                            <input type="text" style="text-align: center; width: 50px;" maxlength="2" id="A2" class="form-control integer" value="" />

                        </td>
                        <td>
                            <input type="text" style="text-align: center; width: 50px;" maxlength="2" id="A3" class="form-control integer" value="" />

                        </td>
                        <td>
                            <input type="text" id="Dr" onblur="calculateTotals()" class="form-control number decimal" value="" />
                            <span id="spnDrError" class="error" style="display:none;">Please enter debit</span>
                        </td>
                        <td>
                            <input type="text" id="Cr" onblur="calculateTotals()" class="form-control number decimal" value="" />
                            <span id="spnCrError" class="error" style="display:none;">Please enter credit</span>
                            <span id="spnCrBothHasValueError" class="error" style="display:none;">Debit and credit can not have value in a single row</span>
                        </td>

                        <td>
                            <button class='btn btn-danger btn-xs delete-row' tabindex="-1"><i class='fa fa-times'></i></button>

                        </td>
                    </tr>

                    </tbody>
                    <tfoot>

                        <tr>

                            <td colspan="7" style="text-align:right;"><label style="font-size:20px;">Total</label></td>
                            <td colspan="1" style="text-align:right;"><label style="font-size:20px;">Dr</label></td>
                            <td colspan="2"><input type="text" id="DrTotal" style="font-size:large; font-weight:bold; background-color:white;" class="form-control integer number" readonly value="0" /></td>
                        </tr>

                        <tr>
                            <td colspan="8" style="text-align:right;"><label style="font-size:20px;">Cr</label></td>
                            <td colspan="2"><input type="text" id="CrTotal" style="font-size:large; font-weight:bold;background-color:white;" class="form-control integer number" readonly value="0" /></td>
                        </tr>

                        <tr style="text-align:right">
                            <td colspan="6">
                                <span id="spnDebitCreditNotEqualError" class="error" style="display:none;">Total debit and total credit are not equal</span>
                            </td>
                        </tr>

                    </tfoot>

                </table>
            </div>

            <div class="box-footer">
                <div class="Actions">
                    <a href="/BKBankTrans/BKBankTranList" class="btn btn-info ">Back to List</a>
                    <a href="/BKBankTrans/BKBankTran" class="btn btn-primary">Add</a>
                    <a href="#" class="btn btn-default" onclick="location.reload();">Cancel</a>
                    <a href="#" class="btn btn-primary btnSave">Save</a>
                    @if (Model.BKBankTran.IsPosted != true && ViewBag.IsPostCount > 0)
                    {
                        <a onclick="post()" id="btnPost" class=" btn btn-danger pull-right" style="display:none;"> Post</a>
                    }
                </div>
            </div>



        </div>
    </div>

</section>
