        function post() {
            
            if (confirm("Are you sure you want to post")) {
                
                /////////////////////////////
                var valid = false;
                $("#tbodyList").find('tr').each(function (index, elem) {
                    if ($(this).find('#BankTransTypeID').val() != "" && $(this).find('#BankTransTypeID').val() > 0) {
                        let IsPost = $(this).find(".ddlIsPost").val();
                        if (IsPost == "1")
                            valid = true;
                    }
                });
                if (valid == false) {
                    alert("Please mark post at least one entry");
                    return;
                }
                /////////////////////////////

                var BankTransID = $('#BankTransID').val();

                $.post("/Integration/IntBankTransactionVoucher", { bkBankTransID: BankTransID }).done(function (res) {

                    if (res = true) {
                        alert('Record Posted');
                        $('#btnPost').css("visibility", 'hidden');
                    }

                }).fail(function (ex) {

                    alert(ex.responseText);

                }).always(function () { });
            }
        }

