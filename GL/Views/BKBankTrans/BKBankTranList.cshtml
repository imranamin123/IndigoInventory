@model GL.ViewModels.BKBankTrans.BKBankTransViewModel

@{

    ViewBag.Title = "Bank Transaction List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<!-- Main content -->
<section class="content">   
    <div class="row">

        <div class="col-md-12">
            <div class="box box-info">
                <div class="form-horizontal">
                    <div class="box-body">
                        <div class="box-header with-border">
                            <h2 class="box-title">Bank Transaction List</h2>
                        </div>
                        <br />



                        <!-- /.box-body -->
                        <div class="box-footer">
                            <a href="/BKBankTrans/BKBankTran" class="btn btn-primary">Add</a>
                            <button class="btn btn-info pull-right" onclick="search()">Search</button>
                        </div>
                        <!-- /.box-footer -->
                        @*</form>*@

                    </div>
                </div>

            </div>
        </div>
    </div>


    <div class="row">
        <div id="ListRows">
        </div>

    </div>
</section>
@*<link rel="stylesheet" href="//cdn.datatables.net/1.10.20/css/jquery.dataTables.min.css">*@

@section scripts{

    <script class="SecUserList">

        function getSearchObject() {
            
            var obj = {
                GLVoucherID: $("#GLVoucherID").val(),
                VoucherTypeID: $("#VoucherTypeID").val(),
            };
            return obj;
        }

        function search() {
            
            //var obj = getSearchObject();
            $.post("/BKBankTrans/BKBankTranSearchList", { }).done(function (res) {

                $("#ListRows").empty();
                $("#ListRows").html(res);

            }).fail(function (ex) {
                alert(ex.responseText);
            }).always(function () { });

        }


    </script>
}



