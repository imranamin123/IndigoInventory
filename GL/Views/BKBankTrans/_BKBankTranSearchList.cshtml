@model GL.ViewModels.BKBankTrans.BKBankTransViewModel
@{
    Layout = null;
}

<div class="box box-info">
    <div class="box-body">
        <div class="col-sm-12" style="overflow:auto;">

            <p>
                @*@Html.ActionLink("Create New", "Student")*@
                @*<a href="/Setup/StaffAdd" class="btn btn-primary">Add</a>*@
            </p>
            <table class="table" id="tblList">
                <thead>
                    <tr>
                        <th>
                            <label>ID</label>
                        </th>
                        <th>
                            <label>Company</label>
                        </th>

                        <th>
                            <label>Trans Code</label>
                        </th>
                        
                        <th style="text-align: center; padding-right: 90px;">
                            <label>Posted</label>
                        </th>

                        <th></th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in Model.BKBankTransSearchList)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.BankTransID)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CompanyName)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.BankTransCode)
                            </td>

                            <td style="text-align: center; padding-right: 90px;">
                                @if (item.IsPosted == true)
                                {
                                    <i class="fa fa-check"></i>
                                }
                            </td>



                            <td>
                                <a href="/BKBankTrans/BKBankTran?BKBankTranID=@item.BankTransID" class="btn btn-primary btn-xs"><i class="fa fa-edit"></i></a>
                                <a href="/BKBankTrans/BKBankTranDelete?BKBankTranID=@item.BankTransID" class="btn btn-danger btn-xs" onclick="return confirm('Are you sure you want to delete this record ?');"><i class="fa fa-times"></i></a>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>
@*</div>*@

<script>
    $().ready(function () {
        $('#tblList').DataTable({
            'paging': true,
            'lengthChange': true,
            'searching': true,
            'ordering': true,
            'info': true,
            'autoWidth': true
        });

    });
</script>