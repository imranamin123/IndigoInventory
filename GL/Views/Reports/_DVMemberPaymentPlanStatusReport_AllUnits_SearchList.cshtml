@model GL.ViewModels.DV.DVMemberPaymentPlanStatusReport_AllUnits_ViewModel
@{
    Layout = null;
}

<div class="box box-info">
    <div class="box-body">
        <div class="col-sm-10" style="overflow:auto;">

            <p>
                @*@Html.ActionLink("Create New", "Student")*@
                @*<a href="/Setup/StaffAdd" class="btn btn-primary">Add</a>*@
            </p>
            <table class="table" id="tblList">
                <thead>
                    <tr>
                        <th>
                            <label>Unit</label>
                        </th>
                        <th>
                            <label>PaymentPlanType</label>
                        </th>
                        <th>
                            <label>Received Amount</label>
                        </th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in Model.MemberPaymentStatus_AllUnits_Rows)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Unit)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PaymentPlanType)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.ReceivedAmount)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>
@*</div>*@

<script>
    $().ready(function () {
        $('#tblList').DataTable({
            'paging': true,
            'lengthChange': true,
            'searching': true,
            'ordering': true,
            'info': true,
            'autoWidth': true
        });

    });
</script>