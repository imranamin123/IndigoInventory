                    var DetailRow = {
                        PaymentPlanDetailID: $(this).find('#PaymentPlanDetailID').val(),
                        PaymentPlanDetailDate: $(this).find('#PaymentPlanDetailDate').val(),
                        PaymentPlanTypeID: $(this).find('#PaymentPlanTypeID').val(),
                        Percentage: $(this).find('#Percentage').val(),
