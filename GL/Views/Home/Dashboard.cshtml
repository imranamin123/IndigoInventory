        function bgColor(type) {
            var color = '#e9e8e5';
            if (type == "Sale") {
                color = '#66ccff';
            }
            else if (type == "Adjustment") {
                color = '#ff99ff';
            }
            else if (type == "Barter") {
                color = '#66ff33';
            }
            else if (type == 'Onhold') {
                color = '#ff9966';
            }
            else if (type == 'Available') {
                color = '#ffffff';
            }
            return color;
        }
