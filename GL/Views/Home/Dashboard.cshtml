@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-chart-matrix@1.2.0/dist/chartjs-chart-matrix.min.js"></script>
<h1 style="color:blue;">Dashboard</h1>

<style>
    /* Sticky first column */
    .sticky-col {
        position: sticky;
        left: 0;
        background: white;
        z-index: 2;
    }

    /* Sticky header row */
    .sticky-header {
        position: sticky;
        top: 0;
        background: #f9f9f9;
        z-index: 3;
        higher than .sticky-col
    }

    /* If both row+col cell (top-left corner) */
    .sticky-col.sticky-header {
        z-index: 4;
    }
</style>

<!-- Main content -->
<section class="content">
    @if (1 == 2)
    {
        <div class="row">
            <div class="col-md-6">
                <!-- DONUT CHART -->
                <div class="box box-danger" style="min-height:250px;">
                    <div class="box-header with-border">
                        <h3 class="box-title">Sold/Unsold Status</h3>
                        <div class="col-sm-3">
                            @Html.DropDownList("ProjectID", new SelectList(ViewBag.Projects, "ProjectID", "ProjectName"), new { @class = "form-control showError project", @id = "ProjectID" })
                        </div>
                        <div class="box-tools pull-right">
                            <button type="button" class="btn btn-box-tool" data-widget="collapse">
                                <i class="fa fa-minus"></i>
                            </button>
                            <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-times"></i></button>
                        </div>
                    </div>
                    <div class="box-body">
                        <canvas id="pieChart"></canvas>
                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->

            </div>
            <!-- /.col (LEFT) -->
            <div class="col-md-6">
            </div>
            <div class="col-md-12">

                <!-- DONUT CHART -->
                @*<div class="box box-danger" style="min-height:250px;">*@
                <div class="box box-danger">
                    <div class="box-header with-border">
                        <h3 class="box-title">Unit Matrix</h3>
                        <div class="col-sm-3">
                            @*@Html.DropDownList("ProjectID", new SelectList(ViewBag.Projects, "ProjectID", "ProjectName"), new { @class = "form-control showError project", @id = "ProjectID" })*@
                        </div>
                        <div class="box-tools pull-right">
                            <button type="button" class="btn btn-box-tool" data-widget="collapse">
                                <i class="fa fa-minus"></i>
                            </button>
                            <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-times"></i></button>
                        </div>
                    </div>
                    <div class="box-body">
                        <div style="margin-top: 7px; overflow-x: scroll; overflow-y: scroll; max-height:500px; max-width: 100%;">

                            <table class="table table-striped tblDetail" id="tblList">
                                <thead>
                                    <tr>

                                        <th style="width: 10px;" class="sticky-header sticky-col"><label>Floor</label></th>
                                        <th style="width: 70px;" class="sticky-header"><label style="padding-left:13px;">A [950]</label></th>
                                        <th style="width: 70px;" class="sticky-header"><label style="padding-left:13px;">B [950]</label></th>
                                        <th style="width: 70px;" class="sticky-header"><label style="padding-left:13px;">C [950]</label></th>
                                        <th style="width: 70px;" class="sticky-header"><label style="padding-left:13px;">D [750]</label></th>
                                        <th style="width: 50px;" class="sticky-header"><label style="padding-left:13px;">E [600]</label></th>
                                        <th style="width: 70px;" class="sticky-header"><label style="padding-left:13px;">F [600]</label></th>
                                        <th style="width: 70px;" class="sticky-header"><label style="padding-left:13px;">G [550]</label></th>
                                        <th style="width: 70px;" class="sticky-header"><label style="padding-left:13px;">H [550]</label></th>
                                        <th style="width: 50px;" class="sticky-header"><label style="padding-left:13px;">I [600]</label></th>
                                        <th style="width: 70px;" class="sticky-header"><label style="padding-left:13px;">J [750]</label></th>
                                        <th style="width: 70px;" class="sticky-header"><label style="padding-left:13px;">K [725]</label></th>
                                        <th style="width: 70px;" class="sticky-header"><label style="padding-left:13px;">L [750]</label></th>
                                        <th style="width: 50px;" class="sticky-header"><label style="padding-left:13px;">M [1200]</label></th>
                                        <th style="width: 70px;" class="sticky-header"><label style="padding-left:13px;">N [450]</label></th>
                                        <th style="width: 70px;" class="sticky-header"><label style="padding-left:13px;">O [450]</label></th>
                                        <th style="width: 70px;" class="sticky-header"><label style="padding-left:13px;">P [450]</label></th>
                                        <th style="width: 70px;" class="sticky-header"><label style="padding-left:13px;">Q [1200]</label></th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyList">
                                </tbody>


                            </table>

                        </div>

                        @*<canvas id="matrixChart" style="width:800px; height:1000px;"></canvas>*@
                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->
            </div>
            <!-- /.col (RIGHT) -->
        </div>
        <!-- /.row -->
