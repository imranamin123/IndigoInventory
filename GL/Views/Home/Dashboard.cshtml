@using GL.EF;
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var LoginUser = (spLoginUser_Result)Session["LoginUser"];
    if (LoginUser.username == "super" || LoginUser.username == "ind.hamza" || LoginUser.username == "ind.shafeeq" || LoginUser.username == "ind.muteeb")
    {

        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>

        <style>
            .dashboard-box {
                min-height: 300px;
            }

                .dashboard-box .box-body {
                    position: relative;
                    min-height: 220px;
                }

            .small-box a.small-box-link {
                display: block;
                color: inherit;
            }

            .kpi-sub {
                font-size: 13px;
                opacity: .85;
            }

            .quick-action-btn {
                margin: 4px 6px 4px 0;
            }

            .activity-table td, .activity-table th {
                vertical-align: middle;
            }

            .empty-state {
                text-align: center;
                color: #999;
                padding: 40px 10px;
            }
        </style>

        <!-- Filters -->
        <div class="row">
            <div class="col-md-12">
                <div class="box box-solid box-default" style="margin-bottom:10px;">
                    <div class="box-body" style="padding-bottom:5px;">
                        <div class="row">
                            <div class="col-sm-3">
                                <label>Project</label>
                                @Html.DropDownList("ProjectID", new SelectList(ViewBag.Projects, "ProjectID", "ProjectName"), new { @class = "form-control project" })
                            </div>
                            <div class="col-sm-3">
                                <label>From Date</label>
                                <div class="input-group">
                                    <div class="input-group-addon"><i class="fa fa-calendar"></i></div>
                                    <input class="form-control date-picker" autocomplete="off" id="FromDate" value="@ViewBag.DefaultFromDate.ToString("dd-MMM-yyyy")" />
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <label>To Date</label>
                                <div class="input-group">
                                    <div class="input-group-addon"><i class="fa fa-calendar"></i></div>
                                    <input class="form-control date-picker" autocomplete="off" id="ToDate" value="@ViewBag.DefaultToDate.ToString("dd-MMM-yyyy")" />
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <label>&nbsp;</label>
                                <button type="button" class="btn btn-primary form-control" id="btnRefreshDashboard"><i class="fa fa-refresh"></i> Apply</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="row">
            <div class="col-md-12">
                <div class="box box-solid" style="margin-bottom:10px;">
                    <div class="box-body">
                        <a href="/INInventory/Item" class="btn btn-default quick-action-btn"><i class="fa fa-plus"></i> Add New Item</a>
                        <a href="/INInventory/PurchaseRequisition" class="btn btn-default quick-action-btn"><i class="fa fa-file-text-o"></i> New Purchase</a>
                        <a href="/INInventory/GoodsReceiptNote" class="btn btn-default quick-action-btn"><i class="fa fa-truck"></i> Stock Receipt</a>
                        <a href="/INInventory/StoreIssueNote" class="btn btn-default quick-action-btn"><i class="fa fa-sign-out"></i> Stock Issue</a>
                        <a href="/INInventory/StoreTransferNote" class="btn btn-default quick-action-btn"><i class="fa fa-exchange"></i> Stock Transfer</a>
                        <a href="/INInventory/ItemList" class="btn btn-default quick-action-btn"><i class="fa fa-list"></i> View Inventory</a>
                        <a href="/Reports/INItemStockReport" class="btn btn-default quick-action-btn"><i class="fa fa-bar-chart"></i> View Reports</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- KPI Cards -->
        <div class="row" id="kpiRow">
            <div class="col-lg-3 col-sm-6 col-xs-12">
                <div class="small-box bg-aqua">
                    <div class="inner">
                        <h3 id="kpiTotalItems">-</h3>
                        <p>Total Items</p>
                    </div>
                    <div class="icon"><i class="fa fa-cubes"></i></div>
                    <a href="/INInventory/ItemList" class="small-box-footer">View Inventory <i class="fa fa-arrow-circle-right"></i></a>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-xs-12">
                <div class="small-box bg-light-blue">
                    <div class="inner">
                        <h3 id="kpiTotalCategories">-</h3>
                        <p>Categories <span class="kpi-sub">/ <span id="kpiTotalGroups">-</span> Groups</span></p>
                    </div>
                    <div class="icon"><i class="fa fa-sitemap"></i></div>
                    <a href="/INInventory/ItemList" class="small-box-footer">View Inventory <i class="fa fa-arrow-circle-right"></i></a>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-xs-12">
                <div class="small-box bg-green">
                    <div class="inner">
                        <h3 id="kpiTotalStockQty">-</h3>
                        <p>Total Stock Quantity</p>
                    </div>
                    <div class="icon"><i class="fa fa-archive"></i></div>
                    <a href="/Reports/INItemStockReport" class="small-box-footer">View Report <i class="fa fa-arrow-circle-right"></i></a>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-xs-12">
                <div class="small-box bg-purple">
                    <div class="inner">
                        <h3 id="kpiTotalStockValue">-</h3>
                        <p>Current Inventory Value</p>
                    </div>
                    <div class="icon"><i class="fa fa-money"></i></div>
                    <a href="/Reports/INItemStockReport" class="small-box-footer">View Report <i class="fa fa-arrow-circle-right"></i></a>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-xs-12">
                <div class="small-box bg-yellow">
                    <div class="inner">
                        <h3 id="kpiTotalPurchaseValue">-</h3>
                        <p>Purchases <span class="kpi-sub">(<span id="kpiTotalPurchaseCount">0</span> GRNs, selected period)</span></p>
                    </div>
                    <div class="icon"><i class="fa fa-shopping-cart"></i></div>
                    <a href="/INInventory/GoodsReceiptNoteList" class="small-box-footer">View Receipts <i class="fa fa-arrow-circle-right"></i></a>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-xs-12">
                <div class="small-box bg-maroon">
                    <div class="inner">
                        <h3 id="kpiTotalIssueValue">-</h3>
                        <p>Issues <span class="kpi-sub">(<span id="kpiTotalIssueCount">0</span> notes, selected period)</span></p>
                    </div>
                    <div class="icon"><i class="fa fa-sign-out"></i></div>
                    <a href="/INInventory/StoreIssueNoteList" class="small-box-footer">View Issues <i class="fa fa-arrow-circle-right"></i></a>
                </div>
            </div>
        </div>

        <!-- Charts row 1 -->
        <div class="row">
            <div class="col-md-5">
                <div class="box box-primary dashboard-box">
                    <div class="box-header with-border">
                        <h3 class="box-title">Stock Value by Category</h3>
                    </div>
                    <div class="box-body">
                        <div class="overlay" id="ovlCategoryChart" style="display:none;"><i class="fa fa-refresh fa-spin"></i></div>
                        <canvas id="categoryChart" height="220"></canvas>
                        <div class="empty-state" id="emptyCategoryChart" style="display:none;">No stock data for this project.</div>
                    </div>
                </div>
            </div>
            <div class="col-md-7">
                <div class="box box-primary dashboard-box">
                    <div class="box-header with-border">
                        <h3 class="box-title">Purchase vs Issue Trend (Monthly)</h3>
                    </div>
                    <div class="box-body">
                        <div class="overlay" id="ovlTrendChart" style="display:none;"><i class="fa fa-refresh fa-spin"></i></div>
                        <canvas id="trendChart" height="220"></canvas>
                        <div class="empty-state" id="emptyTrendChart" style="display:none;">No transactions in the selected period.</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts row 2 -->
        <div class="row">
            <div class="col-md-6">
                <div class="box box-primary dashboard-box">
                    <div class="box-header with-border">
                        <h3 class="box-title">Top 10 Items by Stock Value</h3>
                    </div>
                    <div class="box-body">
                        <div class="overlay" id="ovlTopItems" style="display:none;"><i class="fa fa-refresh fa-spin"></i></div>
                        <canvas id="topItemsChart" height="240"></canvas>
                        <div class="empty-state" id="emptyTopItems" style="display:none;">No items in stock for this project.</div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="box box-primary dashboard-box">
                    <div class="box-header with-border">
                        <h3 class="box-title">Item Movement</h3>
                        <ul class="nav nav-pills pull-right" style="margin-top:-5px;">
                            <li class="active"><a href="#tabFastMoving" data-toggle="tab">Fast-Moving</a></li>
                            <li><a href="#tabSlowMoving" data-toggle="tab">Slow / Non-Moving</a></li>
                        </ul>
                    </div>
                    <div class="box-body">
                        <div class="overlay" id="ovlMovement" style="display:none;"><i class="fa fa-refresh fa-spin"></i></div>
                        <div class="tab-content">
                            <div class="tab-pane active" id="tabFastMoving">
                                <table class="table table-condensed">
                                    <thead><tr><th>Item</th><th>Category</th><th class="text-right">Issued Qty</th></tr></thead>
                                    <tbody id="tblFastMoving"></tbody>
                                </table>
                                <div class="empty-state" id="emptyFastMoving" style="display:none;">No issues in the selected period.</div>
                            </div>
                            <div class="tab-pane" id="tabSlowMoving">
                                <table class="table table-condensed">
                                    <thead><tr><th>Item</th><th>Category</th><th class="text-right">Qty In Hand</th></tr></thead>
                                    <tbody id="tblSlowMoving"></tbody>
                                </table>
                                <div class="empty-state" id="emptySlowMoving" style="display:none;">All stocked items moved in this period.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="row">
            <div class="col-md-12">
                <div class="box box-primary">
                    <div class="box-header with-border">
                        <h3 class="box-title">Recent Activity</h3>
                    </div>
                    <div class="box-body" style="position:relative; min-height:120px;">
                        <div class="overlay" id="ovlRecentActivity" style="display:none;"><i class="fa fa-refresh fa-spin"></i></div>
                        <div style="overflow-x:auto;">
                            <table class="table table-striped activity-table">
                                <thead>
                                    <tr>
                                        <th>Type</th>
                                        <th>Document</th>
                                        <th>Date</th>
                                        <th>Items</th>
                                        <th class="text-right">Amount</th>
                                        <th>Reference</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody id="tblRecentActivity"></tbody>
                            </table>
                        </div>
                        <div class="empty-state" id="emptyRecentActivity" style="display:none;">No recent activity for this project.</div>
                    </div>
                </div>
            </div>
        </div>

        @section scripts{
            @Scripts.Render("~/bundles/jqueryval")

            <script id="dashboardScript">

                var categoryChartInstance, trendChartInstance, topItemsChartInstance;

                var chartColors = ['#00c0ef', '#00a65a', '#f39c12', '#dd4b39', '#605ca8', '#001F3F', '#D81B60', '#3c8dbc'];

                var activityRoutes = {
                    'Goods Receipt': '/INInventory/GoodsReceiptNote/',
                    'Purchase Order': '/INInventory/PurchaseOrder/',
                    'Store Issue': '/INInventory/StoreIssueNote/',
                    'Store Transfer': '/INInventory/StoreTransferNote/'
                };

                $(function () {
                    $('.project').select2();
                    $('.date-picker').datepicker({
                        autoclose: true,
                        orientation: "bottom auto",
                        format: 'dd-M-yyyy'
                    });

                    $('#btnRefreshDashboard').on('click', refreshDashboard);
                    $(document).on('change', '.project', refreshDashboard);

                    refreshDashboard();
                });

                function formatNumber(n) {
                    n = Number(n) || 0;
                    return n.toLocaleString('en-US', { maximumFractionDigits: 0 });
                }

                function formatCurrency(n) {
                    return 'Rs ' + formatNumber(n);
                }

                function getFilters() {
                    return {
                        ProjectID: $('#ProjectID').val(),
                        FromDate: $('#FromDate').val(),
                        ToDate: $('#ToDate').val()
                    };
                }

                function refreshDashboard() {
                    var filters = getFilters();
                    if (!filters.ProjectID) { return; }

                    loadKPI(filters);
                    loadCategoryChart(filters);
                    loadTopItems(filters);
                    loadMovement(filters);
                    loadTrendChart(filters);
                    loadRecentActivity(filters);
                }

                function ajaxPost(url, data, onSuccess, overlayId) {
                    if (overlayId) { $('#' + overlayId).show(); }
                    $.ajax({
                        url: url,
                        type: 'POST',
                        dataType: 'json',
                        data: data,
                        success: function (res) {
                            if (overlayId) { $('#' + overlayId).hide(); }
                            onSuccess(res);
                        },
                        error: function (err) {
                            if (overlayId) { $('#' + overlayId).hide(); }
                            console.log(err);
                        }
                    });
                }

                function loadKPI(filters) {
                    ajaxPost('/Home/GetDashboardKPIJson', filters, function (res) {
                        if (!res) { return; }
                        $('#kpiTotalItems').text(formatNumber(res.TotalItems));
                        $('#kpiTotalCategories').text(formatNumber(res.TotalCategories));
                        $('#kpiTotalGroups').text(formatNumber(res.TotalGroups));
                        $('#kpiTotalStockQty').text(formatNumber(res.TotalStockQty));
                        $('#kpiTotalStockValue').text(formatCurrency(res.TotalStockValue));
                        $('#kpiTotalPurchaseValue').text(formatCurrency(res.TotalPurchaseValue));
                        $('#kpiTotalPurchaseCount').text(formatNumber(res.TotalPurchaseCount));
                        $('#kpiTotalIssueValue').text(formatCurrency(res.TotalIssueValue));
                        $('#kpiTotalIssueCount').text(formatNumber(res.TotalIssueCount));
                    });
                }

                function loadCategoryChart(filters) {
                    ajaxPost('/Home/GetDashboardStockByCategoryJson', { ProjectID: filters.ProjectID }, function (res) {
                        var top = (res || []).slice(0, 8);
                        $('#emptyCategoryChart').toggle(top.length === 0);
                        $('#categoryChart').toggle(top.length > 0);

                        if (categoryChartInstance) { categoryChartInstance.destroy(); }
                        if (top.length === 0) { return; }

                        var labels = top.map(function (x) { return x.CategoryName; });
                        var data = top.map(function (x) { return x.TotalValue; });

                        var ctx = document.getElementById('categoryChart').getContext('2d');
                        categoryChartInstance = new Chart(ctx, {
                            type: 'doughnut',
                            data: {
                                labels: labels,
                                datasets: [{ data: data, backgroundColor: chartColors }]
                            },
                            options: {
                                plugins: {
                                    legend: { position: 'bottom' },
                                    tooltip: {
                                        callbacks: {
                                            label: function (ctx) { return ctx.label + ': ' + formatCurrency(ctx.raw); }
                                        }
                                    },
                                    datalabels: { display: false }
                                }
                            }
                        });
                    }, 'ovlCategoryChart');
                }

                function loadTopItems(filters) {
                    ajaxPost('/Home/GetDashboardTopItemsJson', { ProjectID: filters.ProjectID }, function (res) {
                        var list = res || [];
                        $('#emptyTopItems').toggle(list.length === 0);
                        $('#topItemsChart').toggle(list.length > 0);

                        if (topItemsChartInstance) { topItemsChartInstance.destroy(); }
                        if (list.length === 0) { return; }

                        var labels = list.map(function (x) { return x.Description; });
                        var data = list.map(function (x) { return x.Value; });

                        var ctx = document.getElementById('topItemsChart').getContext('2d');
                        topItemsChartInstance = new Chart(ctx, {
                            type: 'bar',
                            data: {
                                labels: labels,
                                datasets: [{ label: 'Stock Value', data: data, backgroundColor: '#00c0ef' }]
                            },
                            options: {
                                indexAxis: 'y',
                                plugins: {
                                    legend: { display: false },
                                    datalabels: { display: false },
                                    tooltip: {
                                        callbacks: {
                                            label: function (ctx) { return formatCurrency(ctx.raw); }
                                        }
                                    }
                                },
                                scales: {
                                    x: { ticks: { callback: function (v) { return formatNumber(v); } } }
                                }
                            }
                        });
                    }, 'ovlTopItems');
                }

                function loadMovement(filters) {
                    ajaxPost('/Home/GetDashboardItemMovementJson', filters, function (res) {
                        res = res || { fastMoving: [], slowMoving: [] };

                        var fastRows = (res.fastMoving || []).map(function (x) {
                            return '<tr><td>' + x.Description + '</td><td>' + (x.CategoryName || '') + '</td><td class="text-right">' + formatNumber(x.IssuedQty) + '</td></tr>';
                        });
                        $('#tblFastMoving').html(fastRows.join(''));
                        $('#emptyFastMoving').toggle(fastRows.length === 0);

                        var slowRows = (res.slowMoving || []).map(function (x) {
                            return '<tr><td>' + x.Description + '</td><td>' + (x.CategoryName || '') + '</td><td class="text-right">' + formatNumber(x.QtyInHand) + '</td></tr>';
                        });
                        $('#tblSlowMoving').html(slowRows.join(''));
                        $('#emptySlowMoving').toggle(slowRows.length === 0);
                    }, 'ovlMovement');
                }

                function loadTrendChart(filters) {
                    ajaxPost('/Home/GetDashboardMonthlyTrendJson', filters, function (res) {
                        var list = res || [];
                        $('#emptyTrendChart').toggle(list.length === 0);
                        $('#trendChart').toggle(list.length > 0);

                        if (trendChartInstance) { trendChartInstance.destroy(); }
                        if (list.length === 0) { return; }

                        var labels = list.map(function (x) {
                            var d = new Date(x.PeriodMonth);
                            return d.toLocaleString('en-US', { month: 'short', year: 'numeric' });
                        });
                        var purchaseData = list.map(function (x) { return x.PurchaseValue; });
                        var issueData = list.map(function (x) { return x.IssueValue; });

                        var ctx = document.getElementById('trendChart').getContext('2d');
                        trendChartInstance = new Chart(ctx, {
                            type: 'line',
                            data: {
                                labels: labels,
                                datasets: [
                                    { label: 'Purchases', data: purchaseData, borderColor: '#00a65a', backgroundColor: 'rgba(0,166,90,.15)', fill: true, tension: 0.3 },
                                    { label: 'Issues', data: issueData, borderColor: '#dd4b39', backgroundColor: 'rgba(221,75,57,.15)', fill: true, tension: 0.3 }
                                ]
                            },
                            options: {
                                plugins: {
                                    legend: { position: 'bottom' },
                                    datalabels: { display: false },
                                    tooltip: {
                                        callbacks: {
                                            label: function (ctx) { return ctx.dataset.label + ': ' + formatCurrency(ctx.raw); }
                                        }
                                    }
                                },
                                scales: {
                                    y: { ticks: { callback: function (v) { return formatNumber(v); } } }
                                }
                            }
                        });
                    }, 'ovlTrendChart');
                }

                function loadRecentActivity(filters) {
                    ajaxPost('/Home/GetDashboardRecentActivityJson', { ProjectID: filters.ProjectID }, function (res) {
                        var list = res || [];
                        $('#emptyRecentActivity').toggle(list.length === 0);

                        var rows = list.map(function (x) {
                            var route = activityRoutes[x.ActivityType];
                            var docLink = route ? ('<a href="' + route + x.DocID + '">' + x.ActivityType + ' #' + x.DocID + '</a>') : (x.ActivityType + ' #' + x.DocID);
                            var dateStr = x.ActivityDate ? new Date(x.ActivityDate).toLocaleDateString('en-US') : '';
                            return '<tr>' +
                                '<td>' + x.ActivityType + '</td>' +
                                '<td>' + docLink + '</td>' +
                                '<td>' + dateStr + '</td>' +
                                '<td>' + formatNumber(x.ItemsCount) + '</td>' +
                                '<td class="text-right">' + formatCurrency(x.Amount) + '</td>' +
                                '<td>' + (x.Reference || '') + '</td>' +
                                '<td>' + (x.Status || '') + '</td>' +
                                '</tr>';
                        });
                        $('#tblRecentActivity').html(rows.join(''));
                    }, 'ovlRecentActivity');
                }

            </script>
        }
    }
}
