@section scripts{
    @Scripts.Render("~/bundles/jqueryval")

    <script id="dashboard Pie">
        $(function () {
            $(".project").select2();

            $("select#ProjectID").prop('selectedIndex', 0);
            //$(".project").trigger("change");
            var projectID = $(".project").val()

            $.ajax({
                url: "/Home/GetUnitSaleDataJson",
                type: "POST",
                dataType: "json",
                async: false,
                data: { ProjectID: projectID },
                success: function (res) {

                    chart(res.customLabels, res.data)
                },
                error: function (error) {
                    console.log(error);
                }
            });

            $(document).on("change", ".project", function () {

                var projectID = $(".project").val();

                $.ajax({
                    url: "/Home/GetUnitSaleDataJson",
                    type: "POST",
                    dataType: "json",
                    async: false,
                    data: { ProjectID: projectID },
                    success: function (res) {
                        chart(res.customLabels, res.data)
                    },
                    error: function (error) {
                        //console.log("Error:");
                        console.log(error);
                    }
                });



            });
        });

        let pieChartInstance; // Declare this globally

        function chart(customLabels, data) {


            const ctx = document.getElementById('pieChart').getContext('2d');

            // Destroy existing chart if it exists
            if (pieChartInstance) {
                pieChartInstance.destroy();
            }

            pieChartInstance = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: [],
                    datasets: [{
                        data: data,//[20, 15, 10], // Must remain numbers
                        backgroundColor: ['#FF6384', '#36A2EB', '#FFCE56']
                    }]
                },
                options: {
                    plugins: {
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return customLabels[context.dataIndex]; // show "20 - 50000"
                                }
                            }
                        },
                        datalabels: {
                            formatter: function (value, context) {
                                return data[context.dataIndex]; // same label inside slice
                            },
                            color: '#000',
                            font: {
                                weight: 'bold',
                                size: 14
                            }
                        },
                        legend: {
                            position: 'bottom'
                        }
                    }
                },
                plugins: [ChartDataLabels]
            });

        }



    </script>

