@model GL.ViewModels.DV.DVDocumentViewModel
@{
    Layout = null;
}



<div class="box box-info">
    <div class="box-body">
        <div class="col-sm-12" style="overflow:auto;">

            <p>
                @*@Html.ActionLink("Create New", "Student")*@
                <a href="/Setup/StaffAdd" class="btn btn-primary">Add</a>
            </p>


            <table class="table table-striped tblDetail" id="tblList">
                <thead>
                    <tr>
                        @*<th style="width:50px;text-align:center" class="th"><label>Sr</label></th>*@
                        <th style="width:50px;text-align:center" class="th"><label>ID</label></th>
                        <th style="width: 150px; text-align: left;"><label>Date</label></th>
                        <th style="width: 150px;text-align: left;"><label>Type</label></th>
                        <th style="width: 150px; text-align: left;"><label>Name</label></th>
                        <th style="width: 150px;text-align: left;"><label>Description</label></th>
                        <th style="width:5px;"></th>
                    </tr>
                </thead>
                <tbody id="tbodyList">

                    @if (Model.DocumentListRows != null && Model.DocumentListRows.Count > 0)
                    {
                        int i = 0;
                        foreach (var item in Model.DocumentListRows)
                        {
                            //TotalAmount += item.Amount.GetValueOrDefault(0);

                            <tr>
                                <td style="width:50px;text-align:center;">

                                    <input type="hidden" id="DocumentID" value="@item.DocumentID" />
                                    <input type="hidden" id="CreatedBy" value="@item.CreatedBy" />
                                    <input type="hidden" id="CreatedAt" value="@item.CreatedAt" />
                                    <input type="hidden" id="ModifiedBy" value="@item.ModifiedBy" />
                                    <input type="hidden" id="ModifiedAt" value="@item.ModifiedAt" />
                                    <input type="hidden" id="CompanyID" value="@item.CompanyID" />


                                    @*<label id="lblSrNo">@(i+1) </label>*@
                                    @Html.DisplayFor(modelItem => item.DocumentID)
                                </td>


                                <td>
                                    @item.DocumentDate.Value.ToString("dd-MMM-yyyy")
                                    @*@Html.DisplayFor(modelItem => item.DocumentDate.Value.ToString("dd-MMM-yyyy"))*@
                                </td>

                                <td>
                                    @Html.DisplayFor(modelItem => item.DocumentTypeName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.DocumentName)
                                </td>

                                <td>
                                    @Html.DisplayFor(modelItem => item.DocumentDescription)
                                </td>
                                <td>
                                    <a href="/DVDevelopment/DVDocument?ApplicationFormID=@item.ApplicationFormID" class="btn btn-primary btn-xs"><i class="fa fa-edit"></i></a>
                                    <a href="/DVDevelopment/BKBankTranDelete?BKBankTranID=@item.ApplicationFormID" class="btn btn-danger btn-xs" onclick="return confirm('Are you sure you want to delete this record ?');"><i class="fa fa-times"></i></a>
                                </td>
                            </tr>
                            i = i + 1;
                        }
                    }

                </tbody>
                <tfoot>
                    @*<tr>
                    <td colspan="4" style="text-align:right;"><label style="font-size:20px;">Total</label></td>
                    <td>
                        <input type="text" id="TotalAmount" value="@TotalAmount" style="font-size:large; text-align:right; font-weight:bold;background-color:white;" class="form-control " readonly />
                        <span id="spnTotalAmountNotEqualError" class="error" style="display:none;">Total amount is not equal to application amount</span>
                    </td>
                </tr>*@


                </tfoot>

            </table>



        </div>
    </div>
</div>
@*</div>*@

<script>


    $().ready(function () {



        $('#tblList').DataTable({
            'paging': true,
            'lengthChange': true,
            'searching': true,
            'ordering': true,
            'info': true,
            'autoWidth': true,
            // display everything
            "iDisplayLength": -1,
            "aaSorting": [[3, "asc"]] // Sort by first column descending
        });

        resetSrNo();

    });

    function resetSrNo() {

        SrNo = 0;
        $("#tbodyList tr").each(function () {

            var dt = $(this).find("#DVReceiptID").val();
            if (dt != undefined && dt != '') {
                SrNo += 1;
                $(this).find("#lblSrNo").html(SrNo);

            }
        });
    }

</script>
