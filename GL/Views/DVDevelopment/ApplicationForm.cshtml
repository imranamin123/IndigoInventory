@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script id="ApplicationForm">
        var applicantCount = 1;

        $("#UnitID").select2();

        $(document).ready(function (e) {

            if ("@Model.spDVGetApplicationForm.Cancelled" == "True") {
                $('#UnitID').prop('disabled', true);
            }

            $('#add-applicant').click(function (e) {

                if ($('.dvApplicant').length >= 2) {
                    alert("You can add only 2 applicants");
                    return;
                }
                e.preventDefault;

                addApplicant();
                alert("New Applicant added!");
            });

            $(document).on("change", "#imgFile", function (e) {

                e.preventDefault;

                var file = e.target.files[0];// $(this.files[0]);
                var imageBox = $(this).parent().parent().children("#imgBox");

                var oFReader = new FileReader();
                oFReader.readAsDataURL(file);

                oFReader.onload = function (oFREvent) {
                    $(imageBox).attr("src", oFREvent.target.result);
                };

            });

            $(document).on("change", "#UnitID", function (e) {

                e.preventDefault;

                var unitid = $('#UnitID').val()
                if (unitid == "")
                    return;

                $.post("/DVDevelopment/GetUnitData", { unitID: unitid }).done(function (unit) {

                    if (unit != null && unit != '') {
                        fillUnitInfo(unit[0]);
                    }

                }).fail(function (ex) {

                    alert(ex.responseText);

                }).always(function () {
                });

            });

            $(document).on("click", ".btnSave", function (e) {

                e.preventDefault;

                //uploadImage();
                //return;

                $('.btnSave').attr('disabled', 'disabled');

                if (IsValid() == false) {
                    $('.btnSave').removeAttr('disabled');
                    alert("Please correct the error");
                    return;
                }


                var objDVApplicationForm = getObject();
                var objDVApplicants = getObjectDetails();

                

                $.post("/DVDevelopment/IsA4Duplicate", { ProjectID: $("#ProjectID").val(), ApplicationFormID: $("#ApplicationFormID").val(), A4: $("#A4").val() }).done(function (res) {

                    if (res == true) {
                        $('#spnA4DuplicateError').show();
                        $('.btnSave').removeAttr('disabled');
                        return;
                    }
                    else {
                        $('#spnA4DuplicateError').hide();
                    }
                    debugger;
                    var dvArrangementTypeID = $("#DVArrangementTypeID").val();

                    $.post("/DVDevelopment/DVFormApplicationSave", { DVApplicationForm: objDVApplicationForm, DVApplicantList: objDVApplicants, DVArrangementTypeID: dvArrangementTypeID }).done(function (res) {
                        if (res.status == true) {

                            // uploadImage(res.resObjList);
                            alert(res.resMessage);

                            window.location = "/DVDevelopment/ApplicationForm/" + res.id;

                        }
                        else {
                            alert(res.resMessage);
                        }

                    }).fail(function (ex) {
                        alert(ex.responseText);
                        // ShowAlert('Error', $(jQuery.parseHTML(ex.responseText)).eq(1).text(), true);
                    }).always(function () { });



                }).fail(function (ex) {
                    alert(ex.responseText);
                    // ShowAlert('Error', $(jQuery.parseHTML(ex.responseText)).eq(1).text(), true);
                }).always(function () { });


            });

            $(document).on("change", "#ProjectID", function (e) {

                e.preventDefault;
                var projectID = $('#ProjectID').val();


                $.post("/DVDevelopment/GetUnitListByProjectID", { ProjectID: projectID }).done(function (result) {


                    $("#UnitID").empty();
                    var options = '';
                    options = options + '<option value="">' + "--Select--" + '</option> ';
                    for (var i = 0; i < result.length; i++) {
                        options = options + '<option value="' + result[i].UnitID + '">' + result[i].UnitNo + '</option> ';
                    }

                    $("#UnitID").append(options);
                }).fail(function (ex) {
                    alert(ex.responseText);
                    // ShowAlert('Error', $(jQuery.parseHTML(ex.responseText)).eq(1).text(), true);
                }).always(function () { });
            });

            $("#uploadImageForm").on("submit", function (event) {

                if ($('#imgFile').val() == undefined || $('#imgFile').val() == '') {
                    alert("Please select an image first");
                    event.preventDefault();
                }
            });
        });

        function imageUploadCheck() {

            alert("imageBox");
            return false;
        }


        function viewReport() {


            var ApplicationFormID = $('#MApplicationFormID').val();

            var url = "/ReportsWebForms/ReportForm.aspx?ReportName=ApplicationForm&ApplicationFormID=" + ApplicationFormID;

            let a = document.createElement('a');
            a.target = '_blank';
            a.href = url;
            a.click();

            //}
        }

        $(".dvApplicant").each(function () {

            var GenderInput = $(this).find(".GenderInput").val();
            $(this).find('#GenderID').val(GenderInput);
            $(this).find('#GenderID').val(GenderInput);

            var ProvinceID = $(this).find(".provinceId").val();
            $(this).find('#ProvinceID').val(ProvinceID);
        });

        function calculateAmount() {
            var sqft = parseInt($('#SQFT').val());
            var price = parseInt($('#Price').val());
            var amount = sqft * price;
            $('#Amount').val(amount);
        }

        function fillUnitInfo(unit) {
            if (unit != '') {

                $('#UnitTypeID').val(unit.UnitTypeID);
                $('#UnitTypeName').val(unit.UnitTypeName);
                $('#FloorNo').val(unit.FloorNo);
                $('#SQFT').val(unit.SQFT);
                $('#Price').val('');
                $('#Amount').val('');

            }
        }


        function cancelUnit() {
            var unitID = $('#UnitID').val();
            debugger;
            var conf = confirm("Are you sure you want to cancel this unit");
            if (conf) {
                $.post("/DVDevelopment/CancelUnit", { UnitID: unitID }).done(function (res) {

                    if (res == true) {
                        alert("This unit is cancelled and no longer avaible");

                        window.location = "/DVDevelopment/ApplicationForm/" + $("#MApplicationFormID").val();

                    }
                    else {
                        alert("This unit is not cancelled");
                    }

                }).fail(function (ex) {
                    alert(ex.responseText);
                }).always(function () {
                    $('.btnSave').removeAttr('disabled');
                });
            }
        }

        function uploadImage() {

            if (window.FormData != undefined) {

                var fileUpload = $("#imgFile").get(0);
                var files = fileUpload.files;

                // Create FormData object
                var fileData = new FormData();

                // Looping over all files and add it to FormData object
                for (var i = 0; i < files.length; i++) {
                    fileData.append(files[i].name, files[i]);
                }

                // Adding one more key to FormData object
                fileData.append('username', 'Manas');


                $.ajax({
                    type: "POST",
                    url: '/DVDevelopment/UploadPic',
                    crossDomain: true,
                    data: fileData,
                    dataType: "json",
                    contentType: "multipart/form-data",
                    processData: false,
                    contentType: false,
                    headers: {
                        "Accept": "application/json"
                    }
                }).done(function () {
                    //$('.success').addClass('is-active');
                }).fail(function () {
                    //alert('An error occurred please try again later.')
                });


            }

        }



        function IsValid() {

            var valid = true;
            $(".error").hide();


            if ($("#ProjectID").val() == "") {
                $("#spnProjectIDError").show();
                valid = false;
            }

            if ($("#ApplicationFormDate").val() == "") {
                $("#spnApplicationFormDateError").show();
                valid = false;
            }

            if ($("#UnitID").val() == "") {
                $("#spnUnitIDError").show();
                valid = false;
            }

            if ($("#Price").val() == "" || $("#Price").val() == "0") {
