                    valid = false;
                }

                if ($(elem).find("#Living").val() == "") {
                    $(elem).find("#spnLivingError").show();
                    valid = false;
                }

                if ($(elem).find("#Citizen").val() == "") {
                    $(elem).find("#spnCitizenError").show();
                    valid = false;
                }

                if ($(elem).find("#NomioneeName").val() == "") {
                    $(elem).find("#spnNomioneeNameError").show();
                    valid = false;
                }

                if ($(elem).find("#NomineeFatherHusbandName").val() == "") {
                    $(elem).find("#spnNomineeFatherHusbandNameError").show();
                    valid = false;
                }

                if ($(elem).find("#Nominee_NICOP_CNIC").val() == "") {
                    $(elem).find("#spnNominee_NICOP_CNICError").show();
                    valid = false;
                }

                if ($(elem).find("#Relation").val() == "") {
                    $(elem).find("#spnRelationError").show();
                    valid = false;
                }

            });

            //if ($("#tbodyList tr").length == 1) {
            //    valid = false;
            //    alert("Please enter a row in detail");
            //}

            return valid;
        }


        function getObject() {


            var IsActive = false;
            var MRoleID = $("#MRoleID").val();
            if (MRoleID != 1 && MRoleID != 2) {
                IsActive = $("#MIsActive").val()
            }
            else {
                IsActive = ($("#IsActive").val() == "" || $("#IsActive").is(":checked") == false) ? false : true;
            }


            var obj = {
                ApplicationFormID: $("#ApplicationFormID").val(),
                ApplicationFormNo: $("#ApplicationFormNo").val(),
                ApplicationFormDate: $("#ApplicationFormDate").val(),
                ProjectID: $("#ProjectID").val(),
                UnitID: $("#UnitID").val(),
                Price: $("#Price").val(),
                TokenMoney: $("#TokenMoney").val(),
                IsActive: IsActive,
                Cancelled: $("#Cancelled").val(),
                PossessionStatus: $("#PossessionStatus").is(":checked") ? true : false,
                A4: $("#A4").val(),


                // hidden fields
