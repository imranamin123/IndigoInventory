                valid = false;
            }

            ////if ($(".dvApplicant").length == 0) {
            ////    alert("Please add atlease one applicant");
            ////    valid = false;
            ////}

            if ($(".dvApplicant").length == 0) {
                return valid;
            }

            $(".dvApplicant").each(function (index, elem) {

                if ($(elem).find("#Name").val() == "") {
                    $(elem).find("#spnNameError").show();
                    valid = false;
                }

                if ($(elem).find("#GenderID").val() == "") {
                    $(elem).find("#spnGenderIDError").show();
                    valid = false;
                }

                if ($(elem).find("#HusbandFather").val() == "") {
                    $(elem).find("#spnHusbandFatherError").show();
                    valid = false;
                }

                if ($(elem).find("#NICOP_CNIC").val() == "") {
                    $(elem).find("#spnNICOP_CNICError").show();
                    valid = false;
                }
                if ($(elem).find("#Passport").val() == "") {
                    $(elem).find("#spnPassportError").show();
                    valid = false;
                }

                if ($(elem).find("#Profession").val() == "") {
                    $(elem).find("#spnProfessionError").show();
                    valid = false;
                }

                if ($(elem).find("#SubProfession").val() == "") {
                    $(elem).find("#spnSubProfessionError").show();
                    valid = false;
                }

                if ($(elem).find("#StreetArea").val() == "") {
                    $(elem).find("#spnStreetAreaError").show();
                    valid = false;
                }

                if ($(elem).find("#Area").val() == "") {
                    $(elem).find("#spnAreaError").show();
                    valid = false;
                }

                if ($(elem).find("#City").val() == "") {
                    $(elem).find("#spnCityError").show();
                    valid = false;
                }

                if ($(elem).find("#District").val() == "") {
                    $(elem).find("#spnDistrictError").show();
                    valid = false;
                }

                if ($(elem).find("#Division").val() == "") {
                    $(elem).find("#spnDivisionError").show();
                    valid = false;
                }

                if ($(elem).find("#Country").val() == "") {
                    $(elem).find("#spnCountryError").show();
                    valid = false;
                }

                if ($(elem).find("#ProvinceID").val() == "") {
                    $(elem).find("#spnProvinceIDError").show();
                    valid = false;
                }

                if ($(elem).find("#Tax").val() == "") {
                    $(elem).find("#spnTaxError").show();
                    valid = false;
                }


                if ($(elem).find("#CorrespondenceAdressHouseNo").val() == "") {
                    $(elem).find("#spnCorrespondenceAdressHouseNoError").show();
                    valid = false;
                }

                if ($(elem).find("#PhoneNo").val() == "") {
                    $(elem).find("#spnPhoneNoError").show();
                    valid = false;
                }

                if ($(elem).find("#Phone2").val() == "") {
                    $(elem).find("#spnPhone2Error").show();
                    valid = false;
                }

                if ($(elem).find("#StreetArea2").val() == "") {
                    $(elem).find("#spnStreetArea2Error").show();
                    valid = false;
                }

                if ($(elem).find("#City2").val() == "") {
                    $(elem).find("#spnCity2Error").show();
                    valid = false;
                }

                if ($(elem).find("#Country2").val() == "") {
                    $(elem).find("#spnCountry2Error").show();
                    valid = false;
                }

                if ($(elem).find("#Email").val() == "") {
