                ModifiedBy: $("#MModifiedBy").val(),
                ModifiedAt: $("#MModifiedAt").val(),
                //IsActive: $("#IsActive").val(),

            }

            return obj;
        }


        function getObjectDetails() {
            var ApplicationFormRows = [];

            $(".dvApplicant").each(function (index, elem) {

