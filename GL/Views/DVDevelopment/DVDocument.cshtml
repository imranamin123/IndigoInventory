                                <form action="/DVDevelopment/UploadDocument" id="uploadImageForm" method="post" enctype="multipart/form-data">
                                    <label class="control-label col-sm-1">Image</label>
                                    <input type="hidden" id="ImagePath" value="" />
                                    <input type="hidden" name="ApplicationFormID" value="@Model.DVDocument.ApplicationFormID" />
                                    <input type="hidden" name="DocumentID" value="@Model.DVDocument.DocumentID" />

                                    <div class="col-sm-5">
                                        @*<input type="image" id="imgBox" onclick="imageClicked()" src="@Model.DVDocument.DocumentPath" style="min-height:200px; max-height: 200px;min-width:200px; max-width:200px; border: 1px solid black; display:block;" />*@

                                        <div class="mb-3">
                                            <input class="form-control" type="file" accept="application/pdf,application/*" name="imgFile" id="imgFile">
                                        </div>

                                        <input type="submit" class="btn btn-success" value="Upload" style="margin-top:10px;" />
                                        <span id="spnImageError" class="error" style="display:none;">Please select a  document</span>

                                    </div>
                                </form>

                            </div>
                            <div class="col-sm-6">
                              
                            </div>


                        </div>
                    }
                    <!-- /.box-body -->
                    <div class="box-footer">
                        <div class="Actions">
                            <a href="/DVDevelopment/DVDocumentList?ApplicationFormID=@Model.DVDocument.ApplicationFormID" class="btn btn-info ">Back to List</a>
                            <a href="#" class="btn btn-default" onclick="location.reload();">Cancel</a>
                            <a href="#" class="btn btn-primary btnSave">Save</a>
                            @if (Model.DVDocument.DocumentPath != null)
                            {
                                <a id="showPopup" onclick="showImage(this);" class="btn btn-primary" style="cursor:pointer;"><i class="fa fa-eye" aria-hidden="true"></i></a>
                                <a href="/DVDevelopment/DownloadFile?fileName=@Model.DVDocument.DocumentPath" class="btn btn-primary"><i class="fa fa-download"></i></a>
                            }
                            </div>
                    </div>
                    <!-- /.box-footer -->
                    @*</form>*@

                </div>
            </div>


            <div style="margin-top: 7px;">
            </div>



            <div id="attachmentModel" class="modal fade bs-model-lg" tabindex="-1" role="dialog">
                <div class="modal-dialog" style="width: 628px;">

                    <!-- Modal content-->
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal">&times;</button>
                        </div>
                        <div class="modal-body" id="cont">
                            <object id="obj" width="600" height="800"></object>
                        </div>
                    </div>

                </div>
            </div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
<script id="DVPaymentPlan">
        var SrNo = 0;

        //$(window).on('load', function () {
        //    calculateTotals();
        //});

        $().ready(function () {

            $('#tblList').DataTable({
                'paging': true,
                'lengthChange': true,
                'searching': true,
                'ordering': true,
                'info': true,
                'autoWidth': true
            });

            $("#uploadImageForm").on("submit", function (event) {

                if ($('#imgFile').val() == undefined || $('#imgFile').val() == '') {
                    alert("Please select an image first");
                    event.preventDefault();
                }
            });

            $(document).on("change", "#imgFile", function (e) {

                e.preventDefault;

                debugger;

                var file = e.target.files[0];// $(this.files[0]);
                var imageBox = $("#imgBox"); // $(this).parent().parent().parent().children("#imgBox");

                var oFReader = new FileReader();
                oFReader.readAsDataURL(file);

                oFReader.onload = function (oFREvent) {
                    $(imageBox).attr("src", oFREvent.target.result);
                };

            });

            //const uploadField = document.getElementById("imgFile");
            //var bigSize = false;

            //uploadField.onchange = function () {
            //    if (this.files[0].size > 2097152) {
            //        alert("File is more than 2 MB. Please select some small document!");
            //        this.value = "";
            //        bigSize = true;
            //    }
            //};

            $(document).on("change", "#imgFile", function (e) {

                e.preventDefault;

                //if (bigSize == true) {
                //    bigSize = false;
                //    return;
                //}
                debugger;               

                var file = e.target.files[0];// $(this.files[0]);
                var imageBox = $(this).parent().parent().children("#imgBox");

                var oFReader = new FileReader();
                oFReader.readAsDataURL(file);

                oFReader.onload = function (oFREvent) {
                    $(imageBox).attr("src", oFREvent.target.result);
                };

                $(document).on("click", ".btnSave", function (e) {

                    e.preventDefault;

                    //uploadImage();
                    //return;

                    if (IsValid() == false) {
                        return;
                    }

                    var DVDocument = getObject();


                    $.post("/DVDevelopment/DVDocumentSave", { DVDocument: DVDocument }).done(function (res) {

                        if (res.status == true) {

                            // uploadImage(res.resObjList);
                            alert(res.resMessage);

                            window.location = "/DVDevelopment/DVDocument/" + res.id;

                        }
                        else {
                            alert(res.resMessage);
                        }

                    }).fail(function (ex) {
                        alert(ex.responseText);
                        // ShowAlert('Error', $(jQuery.parseHTML(ex.responseText)).eq(1).text(), true);
                    }).always(function () { });
                });

            });
            //$(document).trigger("click");

            //calculateTotals();
            resetSrNo();

            $("#tbodyList tr").each(function () {
                var ID = $(this).find(".ddlid").val();
                $(this).find(".ddl").val(ID).change();
            });

            function resetSrNo() {
                SrNo = 0;
                $("#tbodyList tr").each(function () {

                    var dt = $(this).find("#DVReceiptDetailDate").val();
                    if (dt != undefined && dt != '') {
                        SrNo += 1;
                        $(this).find("#lblSrNo").html(SrNo);

                    }
                });
            }

            $(document).on("click", ".delete-row", function () {



                if (confirm("Are you sure you want to delete this row")) {

                    var row = $(this).closest("tr");
                    var DVReceiptDetailID = $(this).closest("tr").find("#DVReceiptDetailID").val();
                    if (DVReceiptDetailID != "" && DVReceiptDetailID != undefined && DVReceiptDetailID > 0) {



                        $.post("/DVDevelopment/DVReceiptDetailDelete", { DVReceiptDetailID: DVReceiptDetailID }).done(function (res) {

                            $(row).remove();
                            calculateTotals();
                            resetSrNo();

                        }).fail(function (ex) {

                            alert(ex.responseText);

                        }).always(function () { });

                    }
                    else if (DVReceiptDetailID == "" || DVReceiptDetailID == undefined || $(DVReceiptDetailID).val() == 0) {
                        var totalRows = $("#tbodyList tr").length;
                        if (totalRows > 1) {

                            $(row).remove();
                            calculateTotals();
                            resetSrNo();

                        }
                        else {
                            $(row).find("#DVReceiptDetailID").val("");
                            $(row).find("#Amount").val("");
                            resetSrNo();
                        }
                    }
                }
            });

            $(document).on("click", ".btnSave", function (e) {


                e.preventDefault;

                debugger;

                $('.btnSave').attr('disabled', 'disabled');

                if (IsValid() == false) {
                    $('.btnSave').removeAttr('disabled');
                    alert("Please correct the error");
                    return;
                }


                var obj = getObject();
                // var objDetails = getObjectDetails();


                $.post("/DVDevelopment/DVDocumentSave", { DVDocument: obj }).done(function (res) {

                    if (res.status == true) {
                        alert(res.resMessage);
                        $('.btnSave').removeAttr('disabled');
                        window.location = "/DVDevelopment/DVDocument?DocumentID=" + res.id;

                    }
                    else {
                        alert(res.resMessage);
                    }

                }).fail(function (ex) {
                    alert(ex.responseText);
                }).always(function () {
                    $('.btnSave').removeAttr('disabled');
                });

            });

            //$(document).on("click", function (e) {
            //    calculateTotals();
            //});

            $(document).on("change", "#PaymentPlanTypeID", function () {

                var currentRow = $(this).closest("tr");
                var totalRows = $("tr", "#tbodyList").length;
                var currentRowIndex = currentRow.index();
                var diff = totalRows - currentRowIndex;

                if (diff == 1) {
                    var row = $('.trRowTemplate').clone();
                    $(row).removeClass("trRowTemplate");
                    resetSrNo();

                    $('#tbodyList').append(row);

                }
            });

        });

        function downloadFile() {
            debugger;
            var path = "@Model.DVDocument.DocumentPath" ;

            window.location = path;

            $.post("/DVDevelopment/DownloadFile", { fileName: path }).done(function (res) {

                $(row).remove();
                calculateTotals();
                resetSrNo();

            }).fail(function (ex) {

                alert(ex.responseText);

            }).always(function () { });
        }

        function addMonths(date, months) {
            let newDate = new Date(date);
            newDate.setMonth(newDate.getMonth() + months);

            // Handle edge case where the day of the month is beyond the last day of the new month
            if (newDate.getDate() !== date.getDate()) {
                newDate.setDate(0); // Go to the last day of the previous month
            }

            return newDate;
        }

        function getFormatedDate(dt) {
            var myDate = new Date(dt);
            const yyyy = myDate.getFullYear();
            let mm = myDate.getMonth() + 1; // Months start at 0!
            let dd = myDate.getDate();

            if (dd < 10) dd = '0' + dd;
            if (mm < 10) mm = '0' + mm;

            const month = myDate.toLocaleString('default', { month: 'short' });
            var myDate = dd + '-' + month + '-' + yyyy;
            return myDate;
        }

        function IsValid() {

            var valid = true;
            $(".error").hide();


            if ($("#DocumentTypeID").val() == "") {
                $("#spnDocumentTypeIDError").show();
                valid = false;
            }

            if ($("#DocumentDate").val() == "") {
                $("#spnDocumentDateError").show();
                valid = false;
            }
            if ($("#DocumentName").val() == "") {
                $("#spnDocumentNameError").show();
                valid = false;
            }

            //if ($("#imgFile").val() == "") {
            //    $("#spnImageError").show();
            //    valid = false;
            //}

            return valid;
        }

        function calculateTotals() {

            var AmountSum = 0;


            $("#tbodyList").find('tr').each(function (index, elem) {

                if ($(this).find('#PaymentPlanTypeID').val() != "") {


                    var Amount = $(this).find('#Amount').val() == '' ? 0 : parseFloat($(this).find('#Amount').val());
                    $(this).find('#Amount').val(Amount.toFixed(2));

                    AmountSum += parseFloat(Amount);
                }
            });

            $("#TotalAmount").val(AmountSum.toFixed(2));
        }

    function showImage(obj) {
        debugger;
            var filePath = "@Model.DVDocument.DocumentPath";// $(obj).closest('tr').find("#filePath").val();
            var obj = "<object id='obj' width='600' height='800' data='" + filePath + "'></object>"
            $("#cont").html('');
            $("#cont").html(obj);
            $('#attachmentModel').modal('show');
        }

        function getObject() {
            debugger;
            var obj = {
                ApplicationFormID: $("#ApplicationFormID").val(),
                DocumentID: $("#DocumentID").val(),
                DocumentTypeID: $("#DocumentTypeID").val(),
                DocumentDate: $("#DocumentDate").val(),
                DocumentName: $("#DocumentName").val(),
                DocumentDescription: $("#DocumentDescription").val(),
                DocumentPath: $("#DocumentPath").val(),
                // hidden fields
                CreatedBy: $("#CreatedBy").val(),
                CreatedAt: $("#CreatedAt").val(),
                ModifiedBy: $("#ModifiedBy").val(),
                ModifiedAt: $("#ModifiedAt").val(),
                CompanyID: $("#CompanyID").val(),
            }

            return obj;
        }


        function getObjectDetails() {
            var DetailRows = [];

            $("#tbodyList").find('tr').each(function (index, elem) {

                if ($(this).find('#PaymentPlanTypeID').val() != "") {
                    var DetailRow = {
                        DVReceiptDetailID: $(this).find('#DVReceiptDetailID').val(),
                        DVReceiptID: $(this).find('#DVReceiptID').val(),
                        PaymentPlanTypeID: $(this).find('#PaymentPlanTypeID').val(),
                        DVPaymentMethodID: $(this).find('#DVPaymentMethodID').val(),
                        Narration: $(this).find('#Narration').val(),
                        Amount: $(this).find('#Amount').val(),

                        //hidden fields
                        CreatedBy: $(this).find('#CreatedBy').val(),
                        CreatedAt: $(this).find('#CreatedAt').val(),
                        ModifiedBy: $(this).find('#ModifiedBy').val(),
                        ModifiedAt: $(this).find('#ModifiedAt').val(),
                        CompanyID: $(this).find('#CompanyID').val(),
                    }
                    DetailRows.push(DetailRow);
                }
            });

            return DetailRows;
        }


        function viewReport() {

            var DVReceiptID = $('#DVReceiptID').val();
            var url = "/ReportsWebForms/ReportForm.aspx?ReportName=DVReceiptID=" + DVReceiptID;
            let a = document.createElement('a');
            a.target = '_blank';
            a.href = url;
            a.click();
        }

</script>

}

