<section class="content">
    <a href="~/Views/DVDevelopment/DVDocument.cshtml">~/Views/DVDevelopment/DVDocument.cshtml</a>
    <input type="hidden" id="CreatedBy" value="@Model.DVDocument.CreatedBy" />
    <input type="hidden" id="CreatedAt" value="@Model.DVDocument.CreatedAt" />
    <input type="hidden" id="ModifiedBy" value="@Model.DVDocument.ModifiedBy" />
    <input type="hidden" id="ModifiedAt" value="@Model.DVDocument.ModifiedAt" />
    <input type="hidden" id="CompanyID" value="@Model.DVDocument.CompanyID" />
    <input type="hidden" id="ApplicationFormID" value="@Model.DVDocument.ApplicationFormID" />
    <input type="hidden" id="DocumentPath" value="@Model.DVDocument.DocumentPath" />


    <div class="col-md-12">
        <div class="box box-info">
            <div class="form-horizontal">
                <div class="box-body">
                    <div class="box-header with-border">
                        <h2 class="box-title">Documents </h2>
                    </div>
                    <div class="row" style="margin-bottom:10px;">
                        <label for="DocumentID" class="col-sm-1 control-label ">ID</label>
                        <div class="col-sm-2">
                            <input class="form-control integer" readonly value="@Model.DVDocument.DocumentID" id="DocumentID">
                        </div>


                    </div>

                    <div class="row" style="margin-block:10px;">
                        <label for="DocumentType" class="col-sm-1 control-label">Type</label>
                        @*@Html.DropDownListFor(x => x.DocumentListRows[0].DocumentTypeID, new SelectList(ViewBag.DVDocumentTypes, "DocumentTypeID", "DocumentTypeName"), "-- Select --", new { @class = "form-control col-sm-4 showError  ddl", @id = "DocumentTypeID" })*@
                        <div class="col-sm-3">
                            @*@if (Model.DVDocument.DocumentID != 0)
                        {*@
                            @Html.DropDownListFor(x => x.DVDocument.DocumentTypeID, new SelectList(ViewBag.DVDocumentTypes, "DocumentTypeID", "DocumentTypeName"), "-- Select --",
                                new { @class = "form-control col-sm-4 showError  ddl", @id = "DocumentTypeID" })
                            @*}
                        else
                        {

                            @Html.DropDownList("DocumentTypeID", new SelectList(ViewBag.DVDocumentTypes, "DocumentTypeID", "DocumentTypeName"), "-- Select --",
                            new { @class = "form-control col-sm-4 showError  ddl", @id = "DocumentTypeID" })
                        }*@
                            <span id="spnDocumentTypeIDError" class="error" style="display:none;">Please select a document type</span>
                        </div>

                        <label for="DocumentDate" class="control-label col-sm-1 PaddingTop-5">Date</label>
                        <div class="col-sm-3">
                            <div class="input-group date">
                                <div class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </div>
                                <input class="form-control date-picker" autocomplete="off" id="DocumentDate" value="@Model.DVDocument.DocumentDate.Value.ToString("dd-MMM-yyyy")" />
                            </div>
                            <span id="spnDocumentDateError" class="error" style="display:none;">Please select date</span>
                        </div>
                    </div>

                    <div class="row" style="margin-bottom:10px;">
                        <label for="DocumentName" class="control-label col-sm-1 PaddingTop-5">Name</label>
                        <div class="col-sm-3">
                            <input type="text" id="DocumentName" class="col-sm-3 form-control" value="@Model.DVDocument.DocumentName" />
                            <span id="spnDocumentNameError" class="error" style="display:none;">Please add document name</span>
                        </div>
                        <label for="DocumentDescription" class="control-label col-sm-1 PaddingTop-5">Description</label>
                        <div class="col-sm-3">
                            <input type="text" id="DocumentDescription" class="col-sm-3 form-control" value="@Model.DVDocument.DocumentDescription" />
                        </div>
                    </div>
                    @if (Model.DVDocument.DocumentID > 0)
                    {
                        <div class="row" style="margin-bottom:10px;">
                            <div class="col-sm-6">
                                <input type="image" id="imgBox" onclick="imageClicked()" src="@Model.DVDocument.DocumentPath" data-bs-toggle="modal" data-bs-target="#myModal"
