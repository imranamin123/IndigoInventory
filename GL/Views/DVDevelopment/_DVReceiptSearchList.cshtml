


@model GL.ViewModels.DV.DVReceiptViewModel
@{
    Layout = null;
}

<div class="box box-info">
    <div class="box-body">
        <div class="col-sm-12" style="overflow:auto;">

            <p>
                @*@Html.ActionLink("Create New", "Student")*@
                @*<a href="/Setup/StaffAdd" class="btn btn-primary">Add</a>*@
            </p>
            <table class="table table-hover" id="tblList">
                <thead>
                    <tr>
                        <th>
                            <label>SR</label>
                            @*<label>Receipt ID</label>*@
                        </th>
                        <th>
                            <label>Project</label>
                        </th>
                        <th>
                            <label>Unit No</label>
                        </th>
                        <th>
                            <label>Receipt Date</label>
                        </th>
                        <th>
                            <label>Amount Received</label>
                        </th>
                        <th style="text-align: center; padding-right: 90px;">
                            <label>Posted</label>
                        </th>

                        <th></th>
                    </tr>
                </thead>
                <tbody id="tbodyList">
                    @if (Model.DVReceiptList != null && Model.DVReceiptList.Count > 0)
                    {
                        int i = 0;
                        foreach (var item in Model.DVReceiptList)
                        {
                            <tr>
                                <td>
                                    @*<label id="lblSrNo"></label>
                                        <input type="hidden" id="DVReceiptID" value="@item.DVReceiptID" />*@
                                    @Html.DisplayFor(modelItem => item.DVReceiptID)
                                </td>

                                <td>
                                    @Html.DisplayFor(modelItem => item.ProjectName)
                                </td>

                                <td>
                                    @Html.DisplayFor(modelItem => item.UnitNo)
                                </td>
                                <td>
                                    @item.DVReceiptDate.Value.ToString("dd-MMM-yyyy")
                                </td>

                                <td style="text-align: right; padding-right: 90px;">
                                    @Html.DisplayFor(modelItem => item.AmountTotal)
                                </td>

                                <td style="text-align: center; padding-right: 90px;">
                                    @if (item.IsPosted == true)
                                    {
                                        <i class="fa fa-check"></i>
                                    }
                                </td>

                                <td>
                                    <a href="/DVDevelopment/DVReceiptByID?ReceiptID=@item.DVReceiptID" class="btn btn-primary btn-xs"><i class="fa fa-edit"></i></a>
                                    @*<a href="/Students/Delete/@item.StudentID" class="btn btn-danger btn-xs" onclick="return confirm('Are you sure you want to delete this record ?');"><i class="fa fa-times"></i></a>*@

                                </td>
                            </tr>
                            i = i + 1;
                        }
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>
@*</div>*@

<script>


    $().ready(function () {

        //$.fn.dataTable.moment('dd-MMM-yyyy');

        $('#tblList').DataTable({
            'paging': true,
            'lengthChange': true,
            'searching': true,
            'ordering': true,
            'info': true,
            'autoWidth': true,
            // display everything
            "iDisplayLength": -1,
            "aaSorting": [[3, "asc"]] // Sort by first column descending
        });

        resetSrNo();

    });

    function resetSrNo() {

        SrNo = 0;
        //$("#tbodyList tr").each(function () {

        //    var dt = $(this).find("#DVReceiptID").val();
        //    if (dt != undefined && dt != '') {
        //        SrNo += 1;
        //        $(this).find("#lblSrNo").html(SrNo);

        //    }
        //});
    }

</script>
